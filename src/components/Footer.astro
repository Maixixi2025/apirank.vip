---
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

// locale-aware URL helper. EN lives at root (no /en prefix); ZH lives at /zh/.
const localePath = (path: string): string => {
  const clean = path.startsWith('/') ? path.slice(1) : path;
  if (locale === 'en') return clean ? `/${clean}` : '/';
  return `/zh${clean ? `/${clean}` : ''}`;
};

const topProviders = [
  { href: localePath('providers/openai'), label: 'OpenAI' },
  { href: localePath('providers/anthropic'), label: 'Anthropic' },
  { href: localePath('providers/google'), label: 'Google AI' },
  { href: localePath('providers/deepseek'), label: 'DeepSeek' },
];

const resourceLinks = [
  { href: localePath('tutorials'), label: t(locale, 'nav.tutorials') },
  { href: localePath('providers'), label: t(locale, 'nav.providers') },
  { href: localePath('calculator'), label: t(locale, 'nav.calculator') },
];

const trustLinks = [
  { href: localePath('about'), label: t(locale, 'nav.about') },
  { href: localePath('contact'), label: t(locale, 'nav.contact') },
  { href: localePath('privacy'), label: t(locale, 'nav.privacy') },
  { href: localePath('terms'), label: locale === 'zh' ? '使用条款' : 'Terms' },
  { href: localePath('editorial-policy'), label: locale === 'zh' ? '编辑政策' : 'Editorial Policy' },
  { href: 'https://about.me/jasonxmai', label: locale === 'zh' ? '关于作者' : 'About the Author', external: true },
];
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-8 h-8 text-blue-500" viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="8" fill="currentColor"/>
            <path d="M8 16L14 10L20 16L14 22L8 16Z" fill="white"/>
            <path d="M14 16L20 10L26 16L20 22L14 16Z" fill="white" fill-opacity="0.6"/>
          </svg>
          <span class="font-bold text-lg text-white">APIRank</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">
          {t(locale, 'footer.tagline')}
        </p>
        <p class="text-xs text-gray-500 mt-4">
          © {year} APIRank
        </p>
      </div>

      <!-- Top Providers -->
      <div>
        <h3 class="font-semibold text-white mb-3 text-sm">
          {locale === 'zh' ? '热门厂商' : 'Top Providers'}
        </h3>
        <ul class="space-y-2">
          {topProviders.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-blue-400 transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="font-semibold text-white mb-3 text-sm">
          {locale === 'zh' ? '资源' : 'Resources'}
        </h3>
        <ul class="space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-blue-400 transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trust & Legal -->
      <div>
        <h3 class="font-semibold text-white mb-3 text-sm">
          {locale === 'zh' ? '信任与法律' : 'Trust & Legal'}
        </h3>
        <ul class="space-y-2">
          {trustLinks.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.external ? 'me noopener' : undefined}
                target={link.external ? '_blank' : undefined}
                class="text-sm text-gray-400 hover:text-blue-400 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-gray-800 mt-8 pt-6 flex flex-col gap-3">
      <p class="text-xs text-gray-500 text-center md:text-left">
        {t(locale, 'footer.disclaimer')}
      </p>
      <p class="text-xs text-gray-500 text-center md:text-left">
        {t(locale, 'footer.affiliateDisclosure')}
      </p>
      <div class="flex flex-wrap gap-4 justify-center md:justify-end">
        <a href="/sitemap-index.xml" class="text-xs text-gray-500 hover:text-blue-400">Sitemap</a>
        <a href="/llms.txt" class="text-xs text-gray-500 hover:text-blue-400">LLMs.txt</a>
      </div>
    </div>
  </div>
</footer>