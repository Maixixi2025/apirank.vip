const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Nano Banana 2 Lite 是开源的吗？", "acceptedAnswer": {"@type": "Answer", "text": "不是。截至 2026 年 7 月，Nano Banana 2 Lite 仅以专有 Gemini API 端点的形式提供，没有公开的权重或自托管路径。如果需要 Apache 2.0 许可的图像生成模型，BFL FLUX.1 [schnell] 仍是开源首选（fal.ai、Replicate 上托管，或自托管在 H100 GPU）。"}}, {"@type": "Question", "name": "Gemini Omni Flash 与 Veo 3.1 的区别？", "acceptedAnswer": {"@type": "Answer", "text": "Veo 3.1 是 Google 的高端视频生成模型，分 Fast（720p，$0.10/秒）与 Pro（4K，$0.30/秒）两档。Gemini Omni Flash 在 720p/1080p 的费率上等同于 Veo 3.1 Fast，但额外支持对话式多轮编辑——这是 Veo 3.1 Fast 不具备的能力。Veo 3.1 Pro 在 4K 质量上更优，但 3 倍价格。"}}, {"@type": "Question", "name": "Gemini Omni Flash 是否支持图像输入？", "acceptedAnswer": {"@type": "Answer", "text": "支持。Gemini Omni Flash 是 Gemini 系列首个原生支持文本 + 图像 + 视频混合输入的模型——你可以在同一条 prompt 里上传参考图、参考视频、文字描述，让模型在保持参考视觉风格的前提下生成新视频。"}}, {"@type": "Question", "name": "如何最小化 Nano Banana 2 Lite + Gemini Omni Flash 的成本？", "acceptedAnswer": {"@type": "Answer", "text": "三条路径：（1）用 Nano Banana 2 Lite 而非 Pro 处理低风险的批量场景，单图成本直接砍到 1/3.5；（2）缓存常用 prompt 与参考图的 image tokens，单次输出摊薄输入成本；（3）通过 Interactions API 串联图与视频，避免客户端手工管理多次调用的 session 上下文。"}}, {"@type": "Question", "name": "Nano Banana 2 Lite 有免费额度吗？", "acceptedAnswer": {"@type": "Answer", "text": "公共预览期内没有免费额度。两款模型都只通过付费 Gemini API 提供。新用户评估推荐用 Google Cloud 的 $300 新用户赠金，或在 Google AI Studio 直接绑定信用卡做小批量 playground 验证。"}}, {"@type": "Question", "name": "Gemini Omni Flash 的对话式编辑能改多少次？", "acceptedAnswer": {"@type": "Answer", "text": "最多 3 次。Interactions API 的设计上限是同一会话内的 3 次连续编辑，每次编辑都基于上一轮的输出。超过 3 次需要重新开始 session。"}}, {"@type": "Question", "name": "Nano Banana 2 Lite 和 Imagen 4 怎么选？", "acceptedAnswer": {"@type": "Answer", "text": "两者都是 Google 的图像生成模型，Nano Banana 2 Lite 便宜 15%、速度略快；Imagen 4 在某些艺术风格与写实人像上更稳定。如果你的工作流已经在 Gemini 生态里（与文本推理 + Interactions API 串联），Nano Banana 2 Lite 是默认选择；如果只做单图生成且艺术一致性要求高，Imagen 4 更稳。"}}, {"@type": "Question", "name": "Gemini Omni Flash 的 4K 支持吗？", "acceptedAnswer": {"@type": "Answer", "text": "暂不支持。Omni Flash 当前最大输出分辨率为 1080p，4K 视频生成仍需走 Veo 3.1 Pro 或 Pika 2.0 Pro。Omni Flash 的核心定位是「同价位的对话式编辑」，而非 4K 旗舰。"}}, {"@type": "Question", "name": "Gemini API 的密钥如何管理？", "acceptedAnswer": {"@type": "Answer", "text": "通过 Google AI Studio 的 API Keys 页面创建和管理，每密钥可绑定独立的使用额度上限与 IP 白名单。生产部署建议用 Google Cloud IAM + Secret Manager，避免密钥硬编码在代码里。Google Gen AI SDK 0.4+ 已原生支持 Vertex AI 的 Application Default Credentials。"}}, {"@type": "Question", "name": "Nano Banana 2 Lite 与 OpenAI DALL-E 3 的对比？", "acceptedAnswer": {"@type": "Answer", "text": "Nano Banana 2 Lite 比 OpenAI DALL-E 3（约 $0.04/1024x1024）便宜约 15%，生成速度快约 30%（4 秒 vs 6 秒），并原生支持文本描述 + 参考图像 + 后期编辑同一 prompt；DALL-E 3 的优势是与 ChatGPT / OpenAI 生态的紧密集成，以及在具象写实风格上的细节控制。如果你的工作流已经在 OpenAI 生态，DALL-E 3 更顺手；如果在 Google Cloud / Gemini 生态，Nano Banana 2 Lite 是默认选择。"}}]};

