const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Qdrant Cloud 的价格是多少?", "acceptedAnswer": {"@type": "Answer", "text": "免费层 $0/月 含 1 GB 存储 + 0.5M 向量(1015 维以内),无限期。Cloud Standard 月付 $25 起(预付 $250/yr),按 $0.06/GB-月 存储计费;Cloud Pro 月付 $80 起,按 $0.04/GB-月 + 高 IOPS + 99.9% SLA;Dedicated 合同制 $2,500/月起,含 HIPAA、PrivateLink、99.95% SLA。BYOC 模式可自带 AWS/GCP 账户,按 $0.025/GB-月 单价计费。"}}, {"@type": "Question", "name": "Qdrant 可免费商用吗?", "acceptedAnswer": {"@type": "Answer", "text": "可以。开源 Qdrant 数据库引擎(github.com/qdrant/qdrant)采用 Apache 2.0 许可——商用免费、生产环境免费、无按节点费。Qdrant Cloud 是独立付费产品,提供 Free / Standard / Pro / Dedicated 四档套餐。开源代码可无限期自托管,无需向 Qdrant 支付任何费用。对于企业级功能(高级稀疏向量、GPU 索引加速),另有 QPL(Qdrant 商业许可)提供,自托管也需购买。"}}, {"@type": "Question", "name": "Qdrant 的混合检索与 Weaviate 有什么不同?", "acceptedAnswer": {"@type": "Answer", "text": "Qdrant 用 Native Sparse Vectors + Dense Vectors 双向量结构,单集合内可同时存储两种向量,查询时用 Fusion 子句(DBSF 倒数排序融合或 RRF)合并排序结果。Weaviate 也支持混合检索,但 BM25 是用倒排索引,权重由 alpha 参数(0-1)调节;Qdrant 的 Sparse Vectors 由第三方稀疏模型(SPLADE、BGE-M3)生成,语义丰富度高于纯词频。Qdrant 的 Named Vectors 允许单集合中不同字段用不同 Embedding 模型——例如用 BGE 处理文本、CLIP 处理图片、两者一起查询。"}}, {"@type": "Question", "name": "中国能用 Qdrant 吗?", "acceptedAnswer": {"@type": "Answer", "text": "Qdrant Cloud 运行在 AWS Frankfurt / N. Virginia / Sydney 等海外节点。从中国大陆直连会显示 200-400ms 的额外延迟。如需中国低延迟访问,有两条路径:(1)在腾讯云或阿里云的国内区域自托管 Qdrant OSS,引擎运行完全一致;(2)BYOC(Bring Your Own Cloud)模式,把你已有的国内 AWS 账号或 GCP 账号接入 Qdrant Cloud 控制面板,数据留在你账户内但 Qdrant 帮你管理。"}}, {"@type": "Question", "name": "FastEmbed 是什么?Qdrant 的 Embedding 服务怎么用?", "acceptedAnswer": {"@type": "Answer", "text": "FastEmbed 是 Qdrant 官方维护的开源 Embedding 推理库,使用 ONNX Runtime 本地推理、零外部 API 调用。Qdrant Cloud 内置 9 种 FastEmbed 模型(BGE-small/base/large、E5-base/large、all-MiniLM-L6-v2、jina-multilingual、CLIP-ViT-B-32 图像+文本多模态),覆盖英文、中文、跨语言、多模态四大场景。FastEmbed 在 Qdrant 节点本地运行,Embedding 费用 $0(无需第三方 API Key);BYO Embedding(OpenAI、Cohere、Voyage、Mistral)由第三方 API 计费,通常 $0.02-$0.13/百万 tokens。"}}, {"@type": "Question", "name": "Qdrant GPU 加速索引是什么?", "acceptedAnswer": {"@type": "Answer", "text": "2026 GA 的 GPU 加速索引(Qdrant 1.13+)用 NVIDIA cuVS 库在 H100/A100 上构建 HNSW 索引,比纯 CPU 快 50-100 倍。10M 向量的索引构建从 CPU 的 18 小时缩短到 12 分钟。GPU 索引仅在 Cloud Pro 和 Dedicated 层级可用,Standard 仍用 CPU。索引完成后查询阶段是纯 CPU,GPU 不参与查询热路径,只加速构建。多数 RAG 工作负载(中小规模 <5M 向量)的索引构建时间本身是分钟级,GPU 加速主要价值在于超大规模(>10M 向量)或频繁重建索引的场景。"}}, {"@type": "Question", "name": "能从 Pinecone 迁移到 Qdrant 吗?", "acceptedAnswer": {"@type": "Answer", "text": "可以。Qdrant 团队发布 Pinecone → Qdrant 迁移指南,涵盖:(1)Schema 转换(Pinecone 的 namespace → Qdrant 的 collection);(2)Embedding 模型不变(都 BYO 模式);(3)SDK 替换(pinecone-client → qdrant-client,API 形态高度相似);(4)向量导出(Parquet 格式)。100 万向量以下通常 1-2 小时完成,1000 万向量建议预留 12-24 小时并行运行窗口,验证检索一致性后再切换。我们建议在切换前用同一组测试查询在两个系统上跑一次 Recall@10 对比,确认检索质量无回归。"}}]};

const affiliateSidebar = {"title": "试用 Weaviate Cloud", "description": "如需原生混合检索 + 内置 8 种 Embedding + 自然语言 Query Agent,可考虑 Weaviate Flex(从 $45/月)或 Weaviate Cloud 永久免费层。", "url": "https://weaviate.io/", "cta": "免费试用 Weaviate"};

const zhBody = `<h1 class="text-3xl font-bold text-gray-900 mt-8 mb-4">Qdrant Cloud 2026:Rust 高性能向量数据库与混合检索深度评测</h1>

<p class="text-gray-700 leading-relaxed my-4">Qdrant 是 Rust 编写的开源向量数据库(github.com/qdrant/qdrant),在 2026 年成为 RAG 工程师除 Pinecone 之外的首选生产级向量数据库。2026-07-27 验证:Qdrant Cloud 的免费层(1 GB 存储 + 0.5M 向量,无限期)门槛比 Pinecone Starter($0/月 但 100K 向量)和 Weaviate Free(10 万对象)都更宽松;Cloud Standard 月付 $25 起、按 $0.06/GB-月 存储计费,比 Weaviate Flex($45 起)起步更低。</p>

<p class="text-gray-700 leading-relaxed my-4">本评测覆盖 Qdrant 相对 Pinecone + Weaviate 的差异化能力(Rust 原生性能、命名向量 Named Vectors、FastEmbed 9 种内置模型、GPU 加速索引)、2026 年四档套餐(Free / Standard / Pro / Dedicated)的核验价格,以及在 RAG 栈中相对 Pinecone、Weaviate、Chroma、Mem0 的定位。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">TL;DR</h2>

<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li><strong>永久免费层</strong>:1 GB 存储 + 0.5M 向量(1015 维以内) + 2 CPU/0.5 GiB RAM,无限 API 请求</li>
<li><strong>Cloud Standard</strong>:月付 $25 起(预付 $250/yr),按 $0.06/GB-月 存储 + 100 IOPS</li>
<li><strong>Cloud Pro</strong>:月付 $80 起,按 $0.04/GB-月 存储 + 1000 IOPS + 99.9% SLA + GPU 索引</li>
<li><strong>Dedicated 合同制</strong>:从 $2,500/月起,含 HIPAA、PrivateLink、99.95% SLA</li>
<li><strong>BYOC 模式</strong>:自带 AWS/GCP 账户,按 $0.025/GB-月 单价(最便宜)</li>
<li><strong>FastEmbed</strong>:9 种内置 Embedding 模型(BGE、E5、MiniLM、Jina 多语言、CLIP 多模态),本地推理零费用</li>
<li><strong>原生混合检索</strong>:Native Sparse + Dense Vectors,单集合多模型 Named Vectors</li>
<li><strong>GPU 索引</strong>:H100/A100 上 50-100× 加速,2026 GA(Pro+ 层级)</li>
<li><strong>合规</strong>:SOC 2 Type II、ISO 27001、GDPR;Pro+ 层级 HIPAA (BAA)</li>
<li><strong>适用场景</strong>:需要 Rust 性能与低内存的大规模 RAG;混合检索 + 命名向量多模态;BYOC 自带云账户控制成本</li>
</ul>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">为什么 2026 年 Qdrant 值得关注</h2>

<p class="text-gray-700 leading-relaxed my-4">2026 年的向量数据库已从"存 embedding + top-k 检索"演化为"多模态 + 混合检索 + 高维高效索引"的复杂系统。Qdrant 在三个轴上做出了与 Pinecone 不同的设计选择。</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第一,Rust 原生性能。</strong>Pinecone 是闭源 Go 实现,查询延迟通常 30-80ms(top-10 over 1M 1024-dim);Qdrant 单节点在 1M 1024-dim 向量上 HNSW 查询 P99 < 10ms,内存占用约为同规模 Pinecone Pod 的 1/3-1/2。对于 >5M 向量的大规模 RAG(企业知识库、电商推荐),Qdrant 的性能优势直接转化为更小的集群和更低的月费。</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第二,命名向量(Named Vectors)单集合多模型。</strong>Pinecone 一个 index 用一种 Embedding 模型;Qdrant 一个 collection 可以为不同字段用不同 Embedding——例如"title"用 BGE-large,"description"用 OpenAI text-embedding-3-large,"image"用 CLIP-ViT-B-32。查询时你可以做"title 用 BM25 + description 用 BGE + image 用 CLIP"的多模态混合检索,这是 Pinecone 单 index 模型无法实现的。Weaviate 也支持多向量但配置更复杂,Qdrant 的 Named Vectors API 是一行 schema 声明。</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第三,GPU 索引构建加速。</strong>2026 GA 的 GPU 索引用 cuVS 库,10M 向量从 CPU 18 小时缩短到 12 分钟。RAG 工作负载的索引通常 1-2 周重建一次(文档增量),构建时间从"隔夜任务"变成"喝杯咖啡的时间"。这是 Pinecone 仍为 CPU 构建的明显短板,Weaviate Cloud 也无 GPU 索引选项。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">价格详解(2026-07-27 核验)</h2>

<p class="text-gray-700 leading-relaxed my-4">Qdrant Cloud 按存储(GB-月) + 可选性能包(Power Tiers:Low / Medium / High) + 节点数计费。不收 API 调用费、不收 per-vector 嵌入费、FastEmbed 本地推理免费。这是 Qdrant 与 Pinecone、Weaviate 最显著的定价差异——Pinecone 按 Pod 算力 + 存储复合定价,Weaviate 按向量维度 + 存储 + 备份三维定价,Qdrant 几乎是单维度(GB)。</p>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">免费层(Free)</h3>
<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li>1 GB 存储</li>
<li>0.5M 个 1015 维以内向量(超出 1015 维按比例减少)</li>
<li>2 CPU + 0.5 GiB RAM 实例</li>
<li>无限 API 请求(API QPS 上限 50,适合小流量)</li>
<li>Community Discord 支持</li>
<li>无 SLA 承诺</li>
</ul>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">Cloud Standard(月付 $25 起,预付 $250/yr)</h3>
<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li>按 $0.06/GB-月 存储</li>
<li>最低月费 $25(预付年付 $250)</li>
<li>100 IOPS(适合中小规模 RAG)</li>
<li>Multi-zone 复制(1-3 zones)</li>
<li>每日自动备份,14 天保留</li>
<li>工单支持(48h 响应)</li>
</ul>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">Cloud Pro(月付 $80 起)</h3>
<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li>按 $0.04/GB-月 存储(33% 比 Standard 便宜)</li>
<li>1000 IOPS + NVMe 存储</li>
<li>GPU 加速索引(2026 GA,H100/A100)</li>
<li>99.9% SLA + 24×5 工单支持</li>
<li>RBAC + SSO/SAML</li>
<li>HIPAA-ready(BAA 可选)</li>
</ul>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">Dedicated 合同制($2,500+/月)</h3>
<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li>单租户节点,无邻居干扰</li>
<li>PrivateLink + Customer-managed KMS</li>
<li>99.95% SLA + 24×7 优先支持</li>
<li>HIPAA BAA + FedRAMP Moderate(2026 Q4)</li>
</ul>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">BYOC 模式($0.025/GB-月)</h3>
<p class="text-gray-700 leading-relaxed my-4">BYOC(Bring Your Own Cloud)模式把 Qdrant Cloud 的控制平面和你的云账户桥接:你提供 AWS/GCP 账户,Qdrant 在里面部署数据平面节点,管理面板由 Qdrant Cloud 托管。存储按 $0.025/GB-月 单价,比 Standard 便宜 58%。适合已有 AWS EDP 折扣、Reserved Instance 或国内云账户(腾讯云/阿里云通过 AWS Marketplace)的团队。</p>

<h3 class="text-xl font-bold text-gray-900 mt-6 mb-3">FastEmbed 模型价格(2026-07-27 核验)</h3>
<table class="w-full my-4 border-collapse text-sm">
<thead><tr class="bg-gray-100"><th class="border border-gray-200 px-3 py-2 text-left">模型</th><th class="border border-gray-200 px-3 py-2 text-left">维度</th><th class="border border-gray-200 px-3 py-2 text-left">价格</th><th class="border border-gray-200 px-3 py-2 text-left">适用场景</th></tr></thead>
<tbody>
<tr><td class="border border-gray-200 px-3 py-2">BGE-small-en-v1.5</td><td class="border border-gray-200 px-3 py-2">384</td><td class="border border-gray-200 px-3 py-2">$0(FastEmbed 本地)</td><td class="border border-gray-200 px-3 py-2">英文快速检索,移动端</td></tr>
