<tr><td class="border border-gray-200 px-3 py-2">命名向量多模型</td><td class="border border-gray-200 px-3 py-2">✓ 一行 schema</td><td class="border border-gray-200 px-3 py-2">✗ 单 index 单模型</td><td class="border border-gray-200 px-3 py-2">需 NamedVectors 配置</td><td class="border border-gray-200 px-3 py-2">无</td></tr>
<tr><td class="border border-gray-200 px-3 py-2">GPU 索引</td><td class="border border-gray-200 px-3 py-2">✓ 50-100×(Pro+)</td><td class="border border-gray-200 px-3 py-2">✗</td><td class="border border-gray-200 px-3 py-2">✗</td><td class="border border-gray-200 px-3 py-2">✗</td></tr>
