<tr><td class="border border-gray-200 px-3 py-2">存储单价</td><td class="border border-gray-200 px-3 py-2">$0.06/GB-月</td><td class="border border-gray-200 px-3 py-2">平价 Pod</td><td class="border border-gray-200 px-3 py-2">$0.12/GiB</td><td class="border border-gray-200 px-3 py-2">本地</td></tr>
<tr><td class="border border-gray-200 px-3 py-2">内置 Embedding</td><td class="border border-gray-200 px-3 py-2">9 种 FastEmbed</td><td class="border border-gray-200 px-3 py-2">无(纯 BYO)</td><td class="border border-gray-200 px-3 py-2">8 种托管</td><td class="border border-gray-200 px-3 py-2">无</td></tr>
