const zhTitle = 'Qwen3.8-Max-0902 API 2026：Code Arena WebDev 登顶';
const zhDescription = 'Qwen3.8-Max-0902 API 价格 2026 评测：9 月 2 日快照在 Code Arena WebDev 登顶（1,691 分）。真实价格 $2/$6 每百万 token，并非网传的混合 $5。依据 QwenCloud 官网实核。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const zhCanonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = {
