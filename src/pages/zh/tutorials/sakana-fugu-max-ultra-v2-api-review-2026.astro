const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Sakana Fugu API 每百万 token 实际多少钱？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sakana 在控制台公开了四个模型的定价。Fugu Max 固定为输入 $2、输出 $6 每百万 token，缓存输入 $0.25。Fugu Ultra v2 标准上下文（≤272K）输入 $5、输出 $30，长上下文（>272K）输入 $10、输出 $45，缓存输入分别为 $0.50 和 $1.00。Fugu 是预算档，按量计费；Fugu Cyber 是企业定价。web_search 与 web_fetch 在 token 费用之外按 $0.007/次 另计。四款模型共享同一个 OpenAI 兼容入口，一张 key 全覆盖。"
      }
    },
    {
      "@type": "Question",
      "name": "Fugu 是单一模型还是多模型编排？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fugu 是编排层，不是单一神经网络。调用 Fugu、Fugu Max、Fugu Ultra v2 时，系统从可替换的模型池中动态挑选应答模型，池子由 NVIDIA Nemotron（经 Sakana 与 NVIDIA 合作）以及其他开源与专用模型组成。9 月 11 日发布稿明确：Fugu Ultra v2 在其代理池中没有 Fable 5、Fable 5.1 或 GPT-6-Astra，因此编排层才是产品本身，而不是任何单个前沿模型。Sakana 把 Fugu 描述为'作为模型的多智能体系统'。"
