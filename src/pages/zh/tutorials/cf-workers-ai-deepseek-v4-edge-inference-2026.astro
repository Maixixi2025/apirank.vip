<BaseLayout title={zhTitle} description={zhDescription} canonicalUrl={canonicalUrl} zhCanonicalUrl={enCanonicalUrl} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-8">
      <div class="lg:col-span-2 space-y-8">
        <nav class="text-sm text-gray-500 mb-2"><a href="/zh" class="hover:underline">首页</a> &rsaquo; <a href="/zh/tutorials" class="hover:underline">教程</a> &rsaquo; <span class="text-gray-700">{zhTitle}</span></nav>
        <div set:html={zhBody} />
      </div>
      <aside class="space-y-6 mt-8 lg:mt-0"><div class="bg-gray-50 border border-gray-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">快速参考</h3><ul class="text-sm text-gray-700 space-y-1"><li><strong>发布时间:</strong> 2026-08-14</li><li><strong>模型:</strong> @cf/deepseek-ai/deepseek-v4-pro-0813 &amp; deepseek-v4-flash-0731</li><li><strong>上下文:</strong> 1,048,576 token（Workers AI 首批）</li><li><strong>Pro 价格:</strong> $1.32 / $3.96 每百万（缓存 $0.044）</li><li><strong>Flash 价格:</strong> $0.44 / $1.32 每百万（缓存 $0.014）</li><li><strong>能力:</strong> 思考模式 + 函数调用</li><li><strong>计划:</strong> 需 Workers Paid（或 AI Gateway 额度）</li><li><strong>接入:</strong> 绑定、REST、OpenAI 兼容、AI Gateway</li></ul></div><div class="bg-blue-50 border border-blue-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">{affiliateSidebar.title}</h3><p class="text-sm text-gray-700 mb-2">{affiliateSidebar.description}</p><a href={affiliateSidebar.url} class="inline-block bg-blue-600 text-white text-sm px-3 py-1.5 rounded hover:bg-blue-700">{affiliateSidebar.cta}</a></div></aside>
    </div>
  </main>
</BaseLayout>
