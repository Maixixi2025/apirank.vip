const zhBody = "\n<p>Anthropic \u4e8e <strong>2026 \u5e74 11 \u6708 9 \u65e5</strong>\u53d1\u5e03\u4e86 <strong>Claude Fable 5.2</strong> \u4e0e <strong>Claude Mythos 5.2</strong>\u3002\u8fd9\u6b21\u7684\u91cd\u70b9\u4e0d\u662f\u80fd\u529b\u8dc3\u5347\uff0c\u800c\u662f\u4e00\u6b21\u300c<strong>\u66f4\u5feb\u3001\u66f4\u4fbf\u5b9c\u7684\u524d\u6cbf\u6a21\u578b + 20% \u964d\u4ef7</strong>\u300d\uff1a\u65b0\u65d7\u8230\u5b9a\u4ef7 <strong>\u6bcf\u767e\u4e07\u8f93\u5165 token 8 \u7f8e\u5143\u3001\u6bcf\u767e\u4e07\u8f93\u51fa token 40 \u7f8e\u5143</strong>\uff0c\u8f83 Fable 5.1 / Mythos 5.1 \u7684 $10/$50 \u4e0b\u8c03 20%\uff1b\u8f93\u51fa\u901f\u5ea6\u63d0\u5347\u6700\u9ad8 30%\uff0c\u5e76\u65b0\u589e\u53ef\u9009 <strong>fast mode</strong>\uff0c\u4ee5 $16/$80 \u6362\u53d6\u6700\u9ad8 2.5 \u500d\u901f\u5ea6\u3002</p>\n\n<p>\u5982\u679c\u4f60\u5728 Claude API \u4e0a\u8dd1\u957f\u65f6\u7a0b agent \u6216\u91cd\u5ea6\u63a8\u7406\u8d1f\u8f7d\uff0c\u8fd9\u662f\u300c\u524d\u6cbf\u6863\u300d\u6700\u4fbf\u5b9c\u7684\u4e00\u6b21\u2014\u2014\u4f46\u8fc1\u79fb\u5e76\u975e\u96f6\u6210\u672c\u3002Fable 5.2 \u540c\u65f6\u5bf9<strong>\u6240\u6709\u8d26\u6237</strong>\u5f00\u542f\u4e86 Anthropic \u7684 <strong>prefix check</strong>\uff0c\u628a\u5e38\u89c1\u7684\u300c\u7f16\u8f91\u5bf9\u8bdd\u5386\u53f2\u300d\u5199\u6cd5\u53d8\u6210 400 \u62a5\u9519\u3002\u672c\u6587\u8986\u76d6\u5b9a\u4ef7\u3001\u8ba9\u964d\u4ef7\u300c\u542b\u91d1\u91cf\u300d\u66f4\u9ad8\u7684 effort-\u6210\u672c\u66f2\u7ebf\u3001API \u53d8\u66f4\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u4e0d\u7834\u574f\u751f\u4ea7\u96c6\u6210\u7684\u524d\u63d0\u4e0b\u5b8c\u6210\u8fc1\u79fb\u3002</p>\n\n<h2>2026 \u5e74 11 \u6708 9 \u65e5\u53d1\u5e03\u4e86\u4ec0\u4e48</h2>\n<p>Fable 5.2 \u4e0e Mythos 5.2 \u662f\u540c\u4e00\u4e2a\u5e95\u5c42\u6a21\u578b\u3002Fable \u642d\u8f7d Anthropic \u6807\u51c6\u751f\u4ea7\u5b89\u5168\u62a4\u680f\uff0c\u5bf9\u6240\u6709 API \u5ba2\u6237\u5f00\u653e\uff1bMythos \u653e\u5bbd\u4e86\u7f51\u7edc\u4e0e\u751f\u7269\u5b89\u5168\u62a4\u680f\uff0c\u4ec5\u9650\u901a\u8fc7 Anthropic \u9a8c\u8bc1\u9879\u76ee\uff08\u5982 Cyber Verification Program\u3001Life Sciences Verification Program\uff09\u7684\u7ec4\u7ec7\u4f7f\u7528\u3002\u4e24\u8005\u5171\u4eab\u7684\u89c4\u683c\uff1a</p>\n<table class=\"w-full text-sm border-collapse mb-6\">\n<thead><tr class=\"bg-gray-100\"><th class=\"border border-gray-300 px-3 py-2 text-left\">\u6a21\u578b</th><th class=\"border border-gray-300 px-3 py-2 text-left\">API ID</th><th class=\"border border-gray-300 px-3 py-2 text-left\">\u4e0a\u4e0b\u6587</th><th class=\"border border-gray-300 px-3 py-2 text-left\">\u6700\u5927\u8f93\u51fa</th><th class=\"border border-gray-300 px-3 py-2 text-left\">\u4ef7\u683c / \u767e\u4e07 token</th><th class=\"border border-gray-300 px-3 py-2 text-left\">\u53ef\u7528\u6027</th></tr></thead>\n<tbody>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Claude Fable 5.2</td><td class=\"border border-gray-300 px-3 py-2\"><code>claude-fable-5-2</code></td><td class=\"border border-gray-300 px-3 py-2\">1M</td><td class=\"border border-gray-300 px-3 py-2\">128K</td><td class=\"border border-gray-300 px-3 py-2\">$8 / $40</td><td class=\"border border-gray-300 px-3 py-2\">\u6240\u6709\u5ba2\u6237</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Claude Mythos 5.2</td><td class=\"border border-gray-300 px-3 py-2\"><code>claude-mythos-5-2</code></td><td class=\"border border-gray-300 px-3 py-2\">1M</td><td class=\"border border-gray-300 px-3 py-2\">128K</td><td class=\"border border-gray-300 px-3 py-2\">$8 / $40</td><td class=\"border border-gray-300 px-3 py-2\">\u4ec5\u9a8c\u8bc1\u7ec4\u7ec7</td></tr>\n</tbody>\n</table>\n<p>\u4e24\u8005\u5747\u4e3a 1M token \u4e0a\u4e0b\u6587\uff08\u9ed8\u8ba4\u5373\u6700\u5927\uff09\u3001128K \u6700\u5927\u8f93\u51fa\u3001\u65e0\u6cd5\u5173\u95ed\u7684\u5e38\u5f00 adaptive thinking\uff0c\u5e76\u91c7\u7528\u968f Opus 4.7 \u5f15\u5165\u7684\u65b0\u4e00\u4ee3\u5206\u8bcd\u5668\u3002adaptive thinking \u7531 <code>effort</code> \u53c2\u6570\u63a7\u5236\uff1bFable 5.2 \u9ed8\u8ba4 effort \u4e3a <code>high</code>\uff0c\u6bd4 Opus 5.5 \u7684 <code>medium</code> \u9ad8\u4e00\u6863\u3002\u6a21\u578b\u77e5\u8bc6\u622a\u6b62\u4e3a 2026 \u5e74 6 \u6708\u3002</p>\n\n<h2>\u5b9a\u4ef7\uff1a\u6bcf\u4e00\u6863\u4ef7\u683c\uff0c\u4ee5\u53ca\u5b9e\u9645\u53d8\u4e86\u4ec0\u4e48</h2>\n<p>\u6807\u4ef7\u964d\u4e86 20%\uff0c\u6240\u6709\u6d3e\u751f\u8d39\u7387\u540c\u6b65\u4e0b\u8c03\u3002\u4ee5\u4e0b\u662f Fable 5.2 \u76f8\u5bf9 Fable 5.1 \u4e0e Opus 5.5 \u7684\u5b8c\u6574\u4ef7\u683c\u6808\uff1a</p>\n<table class=\"w-full text-sm border-collapse mb-6\">\n<thead><tr class=\"bg-gray-100\"><th class=\"border border-gray-300 px-3 py-2 text-left\">\u8d39\u7387</th><th class=\"border border-gray-300 px-3 py-2 text-left\">Fable 5.2</th><th class=\"border border-gray-300 px-3 py-2 text-left\">Fable 5.1</th><th class=\"border border-gray-300 px-3 py-2 text-left\">Opus 5.5</th></tr></thead>\n<tbody>\n<tr><td class=\"border border-gray-300 px-3 py-2\">\u57fa\u7840\u8f93\u5165</td><td class=\"border border-gray-300 px-3 py-2\">$8 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$10 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$4 / MTok</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">\u57fa\u7840\u8f93\u51fa</td><td class=\"border border-gray-300 px-3 py-2\">$40 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$50 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$20 / MTok</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">5 \u5206\u949f\u7f13\u5b58\u5199\u5165</td><td class=\"border border-gray-300 px-3 py-2\">$10 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$12.50 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$5 / MTok</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">1 \u5c0f\u65f6\u7f13\u5b58\u5199\u5165</td><td class=\"border border-gray-300 px-3 py-2\">$16 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$20 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$8 / MTok</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">\u7f13\u5b58\u547d\u4e2d / \u5237\u65b0</td><td class=\"border border-gray-300 px-3 py-2\">$0.20 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$0.25 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">$0.20 / MTok</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Fast mode \u8f93\u5165</td><td class=\"border border-gray-300 px-3 py-2\">$16 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">\u2014</td><td class=\"border border-gray-300 px-3 py-2\">\u2014</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Fast mode \u8f93\u51fa</td><td class=\"border border-gray-300 px-3 py-2\">$80 / MTok</td><td class=\"border border-gray-300 px-3 py-2\">\u2014</td><td class=\"border border-gray-300 px-3 py-2\">\u2014</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Batch\uff085 \u6298\uff09</td><td class=\"border border-gray-300 px-3 py-2\">$4 / $20</td><td class=\"border border-gray-300 px-3 py-2\">$5 / $25</td><td class=\"border border-gray-300 px-3 py-2\">$2 / $10</td></tr>\n</tbody>\n</table>\n<p>\u4e24\u70b9\u503c\u5f97\u6ce8\u610f\u3002\u5176\u4e00\uff0c\u7f13\u5b58\u8bfb\u53d6\u8d39\u7387\u4ece $0.25 \u964d\u81f3 $0.20 / MTok\uff0c\u5ef6\u7eed\u4e86 5.1 \u5e26\u6765\u7684 75% \u4e0b\u8c03\u2014\u2014\u7f13\u5b58\u7684\u591a\u8f6e agent \u5982\u4eca\u51e0\u4e4e\u4e3a\u4e0a\u4e0b\u6587\u514d\u8d39\u3002\u5176\u4e8c\uff0cfast mode \u5c06 token \u4ef7\u683c\u7ffb\u500d\uff0c\u4f46\u5b83\u662f\u6309\u8bf7\u6c42\u7684\u5f00\u5173\uff0c\u800c\u975e\u72ec\u7acb\u6a21\u578b\uff1a\u4f60\u5728\u5355\u6b21 Messages API \u8bf7\u6c42\u4e0a\u8bbe\u7f6e <code>speed</code>\uff0c\u53ea\u4e3a\u9700\u8981\u7684\u8c03\u7528\u4ed8\u6ea2\u4ef7\u3002</p>\n\n<h2>effort-\u6210\u672c\u66f2\u7ebf\uff1a\u4e3a\u4ec0\u4e48\u5b9e\u9645\u964d\u5e45\u5927\u4e8e 20%</h2>\n<p>\u6807\u4ef7\u53ea\u8bb2\u4e86\u4e00\u534a\u6545\u4e8b\u3002Anthropic \u516c\u5e03\u4e86\u6309 effort \u5212\u5206\u7684\u4efb\u52a1\u6210\u672c\u66f2\u7ebf\uff0cFable 5.2 \u7684\u66f2\u7ebf\u8fdc\u6bd4\u4e0a\u4ee3\u5e73\u7f13\u3002\u5728 FrontierCode 2.0\uff08\u8861\u91cf\u6a21\u578b\u4ee3\u7801\u6539\u52a8\u80fd\u5426\u88ab\u5f00\u6e90\u7ef4\u62a4\u8005\u5408\u5e76\u7684\u57fa\u51c6\uff09\u4e0a\uff1a</p>\n<table class=\"w-full text-sm border-collapse mb-6\">\n<thead><tr class=\"bg-gray-100\"><th class=\"border border-gray-300 px-3 py-2 text-left\">\u6a21\u578b</th><th class=\"border border-gray-300 px-3 py-2 text-left\">Effort</th><th class=\"border border-gray-300 px-3 py-2 text-left\">FrontierCode \u5f97\u5206</th><th class=\"border border-gray-300 px-3 py-2 text-left\">\u5355\u4efb\u52a1\u6210\u672c</th></tr></thead>\n<tbody>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Fable 5.2</td><td class=\"border border-gray-300 px-3 py-2\">High</td><td class=\"border border-gray-300 px-3 py-2\">45.3%</td><td class=\"border border-gray-300 px-3 py-2\">$6.72</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Opus 5.5</td><td class=\"border border-gray-300 px-3 py-2\">High</td><td class=\"border border-gray-300 px-3 py-2\">34.5%</td><td class=\"border border-gray-300 px-3 py-2\">$2.42</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">GPT-6 Astra</td><td class=\"border border-gray-300 px-3 py-2\">High</td><td class=\"border border-gray-300 px-3 py-2\">38.3%</td><td class=\"border border-gray-300 px-3 py-2\">$4.28</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Fable 5.2</td><td class=\"border border-gray-300 px-3 py-2\">Xhigh</td><td class=\"border border-gray-300 px-3 py-2\">49.1%</td><td class=\"border border-gray-300 px-3 py-2\">$14.19</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">Opus 5.5</td><td class=\"border border-gray-300 px-3 py-2\">Xhigh</td><td class=\"border border-gray-300 px-3 py-2\">43.4%</td><td class=\"border border-gray-300 px-3 py-2\">$5.18</td></tr>\n<tr><td class=\"border border-gray-300 px-3 py-2\">GPT-6 Astra</td><td class=\"border border-gray-300 px-3 py-2\">Xhigh</td><td class=\"border border-gray-300 px-3 py-2\">41.4%</td><td class=\"border border-gray-300 px-3 py-2\">$4.54</td></tr>\n</tbody>\n</table>\n<p>\u5148\u770b High \u6863\uff1aFable 5.2 \u4e0e Opus 5.5 \u7684\u6700\u4f73\u5f97\u5206\u6253\u5e73\uff0845.3% vs. 45.5%\uff09\uff0c\u5355\u4efb\u52a1\u6210\u672c\u7ea6\u4e3a\u540e\u8005<strong>\u4e00\u534a</strong>\uff1b\u540c\u65f6\u4ee5\u4e0e GPT-6 Astra \u6700\u4f73\uff0842.8%\uff09\u76f8\u8fd1\u7684\u6210\u672c\u5b8c\u6210\u8d85\u8d8a\u3002Xhigh \u6863 Fable 5.2 \u8fbe 49.1%\uff0c\u4e3a Anthropic \u6d4b\u8fc7\u7684\u6240\u6709\u5df2\u53d1\u5e03\u6a21\u578b\u4e2d\u6700\u9ad8\u3002Anthropic \u7684\u603b\u7ed3\uff1aHigh effort \u4e0b Fable 5.2 \u4e0e Opus 5.5 \u7684 Max \u6863\u6253\u5e73\u3001\u6210\u672c\u7ea6\u4e00\u534a\uff1b\u4e0e GPT-6 Astra \u6700\u4f73\u76f8\u6bd4\u6210\u672c\u76f8\u8fd1\u3001\u5f97\u5206\u66f4\u9ad8\u3002</p>\n<p>\u540c\u6837\u7684\u6a21\u5f0f\u5728\u5176\u4ed6\u8bc4\u6d4b\u4e2d\u91cd\u590d\u51fa\u73b0\u3002Perplexity WANDR agent \u57fa\u51c6 Medium effort\uff1aFable 5.2 \u4ee5 Opus 5.5 \u9876\u90e8\u5f97\u5206\u7ea6 40% \u7684\u6210\u672c\u6253\u5e73\u3002Humanity's Last Exam Low effort\uff1a\u4ee5\u4e0d\u5230 Opus 5.5 \u9876\u90e8\u5f97\u5206\u5341\u5206\u4e4b\u4e00\u7684\u4ef7\u683c\u6253\u5e73\u3002Chartography Medium effort\uff1a66.4%\uff0c\u9ad8\u4e8e Opus 5.5 \u7684 Max \u6863\uff0864.4%\uff09\uff0c\u6210\u672c\u4e0d\u5230\u5341\u5206\u4e4b\u4e00\u3002BenchCAD 2.1 \u786c\u4ef6\u8bbe\u8ba1 Max effort\uff1a83.5\uff0c\u9ad8\u4e8e Opus 5.5 \u7684 65.3 \u4e0e Fable 5.1 \u7684 44.4\u3002\u6362\u8a00\u4e4b\uff0c\u6309\u300c\u540c\u80fd\u529b\u5bf9\u9f50\u300d\u7684\u5de5\u4f5c\u8d1f\u8f7d\u8ba1\u7b97\uff0c20% \u7684\u6807\u4ef7\u964d\u5e45\u88ab\u4f4e\u4f30\u4e86\u3002</p>\n\n<h2>API \u4e0e\u5f00\u53d1\u8005\u4f53\u9a8c</h2>\n<p>Fable 5.2 \u8dd1\u5728\u6807\u51c6 Messages API \u4e0a\uff0cSDK \u4e0d\u53d8\u3002\u6700\u5c0f\u8c03\u7528\u4e0e\u5176\u4ed6 Claude \u6a21\u578b\u4e00\u81f4\uff1a</p>\n<pre class=\"bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm mb-6\"><code class=\"language-python\">import anthropic\n\nclient = anthropic.Anthropic()\n\nmessage = client.messages.create(\n    model=\"claude-fable-5-2\",\n    max_tokens=4096,\n    thinking={\"type\": \"enabled\", \"budget_tokens\": 10000},\n    messages=[{\"role\": \"user\", \"content\": \"\u628a\u8fd9\u4e2a\u51fd\u6570\u91cd\u6784\u4e3a\u5f02\u6b65\u3002\"}],\n)\nprint(message.content)</code></pre>\n<p>fast mode \u53ea\u9700\u5728\u8bf7\u6c42\u4e0a\u52a0\u4e00\u4e2a\u5b57\u6bb5\u2014\u2014\u65e0\u9700 beta header\uff1a</p>\n<pre class=\"bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm mb-6\"><code class=\"language-python\">response = client.messages.create(\n    model=\"claude-fable-5-2\",\n    max_tokens=4096,\n    speed=\"fast\",          # \u8f93\u51fa token \u901f\u5ea6\u6700\u9ad8\u63d0\u5347 2.5 \u500d\n    messages=[{\"role\": \"user\", \"content\": \"\u603b\u7ed3\u8fd9\u4e2a 1M token \u7684\u4ee3\u7801\u5e93\u3002\"}],\n)</code></pre>\n<p>\u51e0\u6761\u53c2\u6570\u89c4\u5219\u9700\u8981\u5185\u5316\u3002adaptive thinking \u5e38\u5f00\uff0c\u63a7\u5236\u6df1\u5ea6\u7528 <code>effort</code> \u800c\u975e <code>temperature</code>\u3002Anthropic \u5efa\u8bae\u7701\u7565 <code>temperature</code>\u3001<code>top_p</code>\u3001<code>top_k</code>\uff1b\u8bbe\u4e3a\u975e\u5e38\u89c4\u503c\u53ef\u80fd\u8fd4\u56de 400\u3002\u5f3a\u5236\u5de5\u5177\u8c03\u7528\uff08<code>tool_choice</code> \u7c7b\u578b <code>any</code> \u4e0e <code>tool</code>\uff09\u5728\u8be5\u6a21\u578b\u4e0a\u4e5f\u8fd4\u56de 400\u3002\u6ce8\u610f\u6570\u636e\u7b56\u7565\uff1aFable 5.2 \u8981\u6c42 30 \u5929\u6570\u636e\u4fdd\u7559\uff0c\u9664\u975e Anthropic \u660e\u786e\u6388\u6743\uff0c\u5426\u5219\u65e0\u6cd5\u5728\u96f6\u6570\u636e\u4fdd\u7559\uff08ZDR\uff09\u4e0b\u4f7f\u7528\u3002</p>\n\n<h2>\u7834\u574f\u6027\u53d8\u66f4\uff1aprefix check \u73b0\u5df2\u5bf9\u6240\u6709\u4eba\u5f3a\u5236</h2>\n<p>\u6700\u5927\u7684\u8fc1\u79fb\u98ce\u9669\u65e2\u4e0d\u662f\u4ef7\u683c\u4e5f\u4e0d\u662f\u53c2\u6570\uff0c\u800c\u662f Anthropic preserved-thinking \u7684 <strong>prefix check</strong>\u3002API \u4f1a\u68c0\u6d4b Fable 5.2 / Mythos 5.2 \u7684 thinking block \u4e4b\u524d\u7684\u5185\u5bb9\u81ea\u6a21\u578b\u4ea7\u51fa\u4ee5\u6765\u662f\u5426\u88ab\u6539\u52a8\uff1a<code>system</code> \u63d0\u793a\u3001<code>tools</code> \u5b9a\u4e49\u6216\u4efb\u4f55\u66f4\u65e9\u7684 message\u3002\u5728 Fable 5.2 \u4e0e Mythos 5.2 \u4e0a\uff0c\u8be5\u68c0\u6d4b\u5bf9<strong>\u6240\u6709\u8d26\u6237</strong>\u8fd4\u56de 400 \u62a5\u9519\uff0c\u4e0e\u8d26\u6237\u5e74\u9f84\u65e0\u5173\u3002\uff08\u5728 Fable 5.1 \u4e0a\uff0c\u540c\u6837\u9519\u8bef\u4ec5\u5bf9 2026 \u5e74 8 \u6708 31 \u65e5\u53ca\u4e4b\u540e\u521b\u5efa\u7684\u8d26\u6237\u89e6\u53d1\u2014\u2014\u8fd9\u610f\u5473\u7740\u9759\u9ed8\u7f16\u8f91\u5386\u53f2\u7684\u4ee3\u7801\u5728\u8001\u8d26\u6237\u4e0a\u80fd\u8dd1\uff0c\u4e00\u5207\u6362\u5230 5.2 \u5c31\u5d29\u3002\uff09</p>\n<p>\u62a5\u9519\u7279\u5f81\u5f88\u660e\u786e\uff1a\u8bf7\u6c42\u8fd4\u56de 400\uff0c\u6d88\u606f\u4e3a <code>The block is bound to a different conversation</code>\u3002\u5982\u679c\u4f60\u7684\u4ee3\u7801\u6539\u4e86 system prompt\u3001\u6539\u4e86\u5de5\u5177\u3001\u6216\u91cd\u5199\u4e86\u66f4\u65e9\u7684 turn\uff0c\u53c8\u628a\u540e\u7eed turn \u7684 5.2 thinking block \u53d1\u56de\u53bb\uff0c\u8c03\u7528\u5c31\u4f1a\u5931\u8d25\u3002\u4e24\u6761\u9003\u751f\u901a\u9053\uff1a\u53d1\u9001 <code>thinking-binding-controls-2026-08-01</code> beta header \u5e76\u628a <code>thinking.block_binding.prefix_mismatch_behavior</code> \u8bbe\u4e3a <code>drop_block</code>\uff08\u4e22\u5f03\u4e0d\u5339\u914d block \u5e76\u7ee7\u7eed\uff0c\u5728\u9876\u5c42 <code>input_transformations</code> \u6570\u7ec4\u4e2d\u5217\u51fa\uff09\uff1b\u6216\u5f7b\u5e95\u505c\u6b62\u7f16\u8f91\u524d\u7f00\u3002Anthropic \u660e\u786e <code>drop_block</code> \u53ea\u662f\u8fc7\u6e21\u65b9\u6848\u2014\u2014\u4e22\u5f03 block \u53ef\u80fd\u63a8\u9ad8\u8f93\u51fa token\u3002</p>\n<p>\u5982\u679c\u4f60\u7528 Claude Code\u3001claude.ai\u3001Claude Managed Agents \u6216 Claude Agent SDK \u6784\u5efa\u8bf7\u6c42\uff0c\u5219\u65e0\u9700\u6539\u52a8\u2014\u2014\u8fd9\u4e9b\u5de5\u5177\u672c\u5c31\u628a\u6bcf\u4e2a assistant turn \u539f\u6837\u56de\u4f20\u3002\u98ce\u9669\u96c6\u4e2d\u5728\u624b\u5de5\u62fc\u88c5 message \u6570\u7ec4\u5e76\u6539\u52a8\u5386\u53f2\u7684\u96c6\u6210\u4e0a\u3002</p>\n<p>\u8fd8\u6709\u4e24\u4e2a\u76f8\u90bb\u53d8\u66f4\u3002\u65e7\u7684 <code>computer_20251124</code> \u5de5\u5177\u5728\u9664 Amazon Bedrock \u5916\u7684\u6240\u6709\u5e73\u53f0\u8fd4\u56de 400\uff1b\u6539\u7528 <code>computer_toolset_20260801</code> toolset\u3002beta \u7684 advisor \u5de5\u5177\u4e2d\uff0cFable 5.2 / Mythos 5.2 executor \u53ea\u63a5\u53d7\u53e6\u4e00\u4e2a Fable 5.2 / Mythos 5.2 \u4f5c\u4e3a advisor\u2014\u2014\u4efb\u4f55\u5176\u4ed6 advisor \u6a21\u578b\u90fd\u8fd4\u56de 400\u3002</p>\n\n<h2>\u5bf9\u8bdd\u4e2d\u5207\u6362\u6a21\u578b\u4e0e thinking \u53ef\u79fb\u690d\u6027</h2>\n<p>Fable 5.2 \u8fd8\u6539\u53d8\u4e86\u63a8\u7406\u5728\u6a21\u578b\u95f4\u7684\u6d41\u8f6c\u65b9\u5f0f\u3002\u5728 Claude API \u4e0e Claude Models on Google Cloud\uff08Google managed\uff09\u4e0a\uff0c\u628a\u5bf9\u8bdd<strong>\u8fc1\u79fb\u5230</strong> Fable 5.2 / Mythos 5.2\uff08\u6765\u81ea Opus 5.5\u3001Sonnet 5.5\u3001Haiku 5.5\u3001Fable 5.1\u3001Mythos 5.1\u3001Opus 5\u3001Fable 5 \u6216\u66f4\u65e9\u7684 Opus/Sonnet/Haiku\uff09\u4f1a\u4fdd\u7559\u65e2\u6709\u63a8\u7406\u2014\u2014\u8fd9\u4e9b thinking block \u4ecd\u53ef\u8bfb\u53d6\u3002\u4ece Fable 5.2 <strong>\u8fc1\u8d70</strong>\u5230\u4efb\u4f55\u5176\u4ed6\u6a21\u578b\uff08\u5305\u62ec Opus 5.5 \u4e0e Fable 5.1\uff09\u5