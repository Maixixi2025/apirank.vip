<td class="px-4 py-3 text-sm text-gray-700">6,635</td>

<td class="px-4 py-3 text-sm text-gray-700">6,635</td>

<td class="px-4 py-3 text-sm text-gray-700"><strong>100%</strong></td>

</tr>

<tr>

<td class="px-4 py-3 text-sm text-gray-700">claude-opus-4.8</td>

<td class="px-4 py-3 text-sm text-gray-700">2,898</td>

<td class="px-4 py-3 text-sm text-gray-700">4</td>

<td class="px-4 py-3 text-sm text-gray-700">0.1%</td>

</tr>

