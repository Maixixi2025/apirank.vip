      <tr><td>Qwen3-Coder-30B-A3B-Instruct</td><td>代码大模型</td><td>—</td><td>0.07</td><td>0.26</td><td>$0.07</td><td>$0.26</td></tr>
      <tr><td>Mistral-Small-3.2-24B-Instruct-2506</td><td>大模型</td><td>—</td><td>0.10</td><td>0.31</td><td>$0.10</td><td>$0.31</td></tr>
      <tr><td>Mistral-7B-Instruct-v0.3</td><td>大模型</td><td>—</td><td>0.11</td><td>0.11</td><td>$0.11</td><td>$0.11</td></tr>
