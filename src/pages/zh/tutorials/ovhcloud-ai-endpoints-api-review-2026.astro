      <tr><td>whisper-large-v3-turbo</td><td>语音转文字</td><td>—</td><td>0.00001278 €/秒</td><td>—</td><td>$0.051/小时</td><td>—</td></tr>
      <tr><td>Qwen3Guard-Gen-8B / 0.6B</td><td>审核（Beta）</td><td>32K</td><td>免费</td><td>免费</td><td>免费</td><td>免费</td></tr>
      <tr><td>stable-diffusion-xl-base-v10</td><td>图像生成</td><td>—</td><td>免费</td><td>—</td><td>免费</td><td>—</td></tr>
      <tr><td>nvr-tts-en-us / it-it / de-de / es-es</td><td>语音合成</td><td>—</td><td>免费</td><td>—</td><td>免费</td><td>—</td></tr>
