      <tr><td>Qwen3.5-9B</td><td>视觉大模型</td><td>262K</td><td>0.10</td><td>0.15</td><td>$0.12</td><td>$0.18</td></tr>
      <tr><td>gpt-oss-120b</td><td>推理大模型</td><td>131K</td><td>0.08</td><td>0.40</td><td>$0.09</td><td>$0.47</td></tr>
      <tr><td>gpt-oss-20b</td><td>推理大模型</td><td>131K</td><td>0.04</td><td>0.15</td><td>$0.05</td><td>$0.18</td></tr>
      <tr><td>Meta-Llama-3.3-70B-Instruct</td><td>大模型</td><td>131K</td><td>0.67</td><td>0.67</td><td>$0.74</td><td>$0.74</td></tr>
