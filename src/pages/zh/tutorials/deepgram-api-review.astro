---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'deepgram-api-review';
const date = '2026-06-21';
const locale = 'zh';

const zhTitle = 'Deepgram API 测评 2026：Nova-3 语音识别 + Aura-2 语音合成';
const zhDescription = 'Deepgram API 完整测评：Nova-3 STT $0.0043/分钟、Aura-2 TTS $0.03/千字符、50+ 语言、亚 300ms 延迟、$200 免费额度。最佳 STT 精度。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": zhTitle,
  "description": zhDescription,
  "datePublished": date,
  "dateModified": date,
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://apirank.vip/zh/tutorials/${slug}` }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip" },
    { "@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials" },
    { "@type": "ListItem", "position": 3, "name": zhTitle, "item": `https://apirank.vip/zh/tutorials/${slug}` }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Deepgram Nova-3 的英文 STT 精度有多高？",
      "acceptedAnswer": { "@type": "Answer", "text": "Nova-3 Monolingual 在同级别中实现最佳词错误率（WER），比 Nova-2 降低 54%。干净音频约 3-5% WER（接近人类水平），对话约 8-12%，噪音环境约 12-18%。" }
    },
    {
      "@type": "Question",
      "name": "Deepgram 支持中文吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "STT 支持中文（普通话和粤语），Nova-3 Multilingual 和 Flux 均可用于中文语音识别。TTS 不支持中文——Aura-2 和 Aura-1 仅支持 7 种语言（英、西、法、德、葡、日、韩）。" }
    },
    {
      "@type": "Question",
      "name": "国内能用 Deepgram 吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "可以，但需要稳定的代理或 VPN。Deepgram 没有中国大陆数据中心，API 端点在美国和欧盟。如需国内直连，可考虑 FreeModel 等聚合器。" }
    },
    {
      "@type": "Question",
      "name": "Deepgram 的定价与 Google Cloud STT 或 Azure Speech 相比如何？",
      "acceptedAnswer": { "@type": "Answer", "text": "Deepgram 高量使用时更具性价比。Nova-3 流式 $0.0043/分钟，远低于 Google Cloud（$0.006-0.024/分钟）和 Azure Speech（$0.006-0.024/分钟）。" }
    },
    {
      "@type": "Question",
      "name": "Deepgram 是否支持实时流式传输？",
      "acceptedAnswer": { "@type": "Answer", "text": "支持。Deepgram 通过 WebSocket 支持实时流式传输，STT 和 TTS 延迟均低于 300ms。预录制 API 适用于批量处理。" }
    },
    {
      "@type": "Question",
      "name": "Deepgram 是否通过 SOC 2 和 HIPAA 认证？",
      "acceptedAnswer": { "@type": "Answer", "text": "是的。Deepgram 已获 SOC 2 Type II 认证、HIPAA 合规、GDPR 合规。自托管部署可用于气隙环境。" }
    }
  ]
};
---

<BaseLayout
  title={zhTitle + ' | APIRank'}
  description={zhDescription}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <link rel="alternate" hreflang="en-US" href={enCanonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={enCanonicalUrl} />

  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/zh" class="hover:text-blue-600">首页</a>
        <span>&#8250;</span>
        <a href="/zh/tutorials" class="hover:text-blue-600">教程</a>
        <span>&#8250;</span>
        <span class="text-gray-900 font-medium">Deepgram API 测评</span>
      </nav>
    </div>
  </div>

  <article class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">

          <header>
          <h1 class="text-3xl font-bold text-gray-900 mb-4">Deepgram API 测评 2026：Nova-3 语音识别 + Aura-2 语音合成</h1>
          <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
            <time datetime="2026-06-21">2026年6月21日</time>
            <span>&#8226;</span>
            <span>Deepgram 测评</span>
            <span>&#8226;</span>
            <span>阅读约 10 分钟</span>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Deepgram 是 AI 语音识别和合成领域最受尊敬的名字之一，其 Nova-3 语音转文字（STT）模型和 Aura-2 文字转语音（TTS）模型均属业界领先水平。凭借亚 300ms STT 延迟、50+ 种语言支持和以开发者优先的 API 设计，Deepgram 为数千家公司（包括 NASA、Spotify 和 The Washington Post）提供转录、语音助手、呼叫中心分析和无障碍工具。本文将全面测评 Deepgram API 平台、Nova-3 精度、Aura-2 语音质量、定价对比、竞品分析和开发者体验。
          </p>
        </header>

        <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-r">
          <p class="text-blue-800 text-sm">
            <strong>一句话总结：</strong>Deepgram 提供 STT 从 $0.0043/分钟（Nova-3 流式）起，TTS 从 $0.015/千字符（Aura-1）起。Nova-3 比上一代降低 54% WER——英文 STT 精度业界最佳。亚 300ms 实时延迟，50+ 种 STT 语言，新用户 $200 免费额度。TTS 仅 7 种语言（不含中文）。无中国大陆数据中心。SOC 2/HIPAA/GDPR 合规。无联盟计划。如需直连中国的多厂商语音 API 聚合路由，可考虑 FreeModel。
          </p>
        </div>

        <div class="prose prose-lg max-w-none">
          <h2>介绍：Deepgram — 开发者优先的语音 AI 平台</h2>
          <p>Deepgram 成立于 2015 年，使命是通过 AI 让语音数据更易访问和利用。与许多从消费产品起步再添加 API 的语音提供商不同，Deepgram 从第一天起就以 API 为先构建。其核心差异化优势是端到端深度学习：不拼接传统语音识别管道（声学模型 + 语言模型 + 解码器），而是在原始音频上训练单一神经网络。</p>
          <p>这一架构选择在精度和延迟上得到回报。最新的 Nova-3 模型比上一代降低 54% 的词错误率（WER），是目前最准确的语音识别 API 之一。配合亚 300ms 流式延迟，Deepgram 是实时转录、语音助手和任何需要速度与精度兼具的应用的有力选择。</p>
          <p>Deepgram 服务于广泛的行业：媒体和娱乐（字幕、转录）、联络中心（实时座席辅助、分析）、医疗（医学转录、HIPAA 合规）、法律（法庭记录、证词转录）和无障碍（听障人士字幕）。</p>

          <h2>Deepgram 的产品线</h2>
          <p>Deepgram 提供以语音转文字和文字转语音为核心的全面语音 AI API 平台：</p>

          <h3>语音转文字 (STT) — Nova-3 &amp; Flux</h3>
          <p>Deepgram 的旗舰产品是 STT API，三大模型系列覆盖不同使用场景：</p>
          <table>
            <thead>
              <tr><th>模型</th><th>类型</th><th>延迟</th><th>语言</th><th>定价（每分钟）</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>Nova-3 单语</strong></td><td>最佳精度</td><td>低于 300ms 流式</td><td>仅英文</td><td>$0.0043 流式 / $0.0048 预录制</td></tr>
              <tr><td><strong>Nova-3 多语</strong></td><td>多语言</td><td>低于 300ms 流式</td><td>50+ 语言</td><td>$0.0052 流式 / $0.0058 预录制</td></tr>
              <tr><td><strong>Flux</strong></td><td>对话优化</td><td>低于 300ms</td><td>50+ 语言</td><td>$0.0065 流式 / $0.0077 预录制</td></tr>
              <tr><td><strong>Whisper</strong></td><td>开放模型</td><td>较高延迟</td><td>99+ 语言</td><td>$0.0048/分钟</td></tr>
            </tbody>
          </table>
          <p>Nova-3 单语（英文）精度最高，Deepgram 报告比 Nova-2 降低 54% WER。Nova-3 多语支持 50+ 语言，包括中文普通话、粤语、日语、韩语、西班牙语、法语、德语等。Flux 针对对话语音进行了优化，内置话轮检测——非常适合呼叫中心和语音助手场景。</p>
          <p>主要 STT 功能包括：通过 WebSocket 实时流式传输、预录制批量处理、说话者分离（谁说了什么）、自定义词汇（领域术语）、标点和格式化、脏话过滤和语言检测。</p>

          <h3>文字转语音 (TTS) — Aura-2 &amp; Aura-1</h3>
          <p>Deepgram 的 TTS 产品品牌名为 Aura，提供自然语音合成：</p>
          <table>
            <thead>
              <tr><th>模型</th><th>延迟</th><th>质量</th><th>语言</th><th>定价（每千字符）</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>Aura-2</strong></td><td>低于 200ms</td><td>最佳（富有表现力、自然）</td><td>7 种语言</td><td>$0.030</td></tr>
              <tr><td><strong>Aura-1</strong></td><td>低于 200ms</td><td>高</td><td>7 种语言</td><td>$0.015</td></tr>
            </tbody>
          </table>
          <p>Aura-2 提供更有表现力、更自然的语音，具有更好的韵律和情感范围。两种模型都支持 SSML，可以精细控制发音、强调和节奏。语言包括英语、西班牙语、法语、德语、葡萄牙语、日语和韩语。<strong>需要注意的是，TTS 不支持中文（普通话或粤语）。</strong></p>

          <h3>语音代理 API</h3>
          <p>较新的产品，将 STT + TTS + LLM 统一为单一语音代理管道。开发者可以创建带有话轮检测、知识库集成和实时语音对话的对话式语音代理——全部通过一个 API 流完成。</p>

          <h2>定价：即用即付 + $200 免费额度</h2>
          <p>Deepgram 采用直接的即用即付定价模式——没有令人困惑的积分系统：</p>
          <table>
            <thead>
              <tr><th>服务</th><th>模型</th><th>即用即付</th><th>成长计划 (~12-20% 折扣)</th></tr>
            </thead>
            <tbody>
              <tr><td>STT（流式）</td><td>Nova-3 单语</td><td>$0.0043/分钟</td><td>$0.0036/分钟</td></tr>
              <tr><td>STT（预录制）</td><td>Nova-3 单语</td><td>$0.0048/分钟</td><td>$0.0040/分钟</td></tr>
              <tr><td>STT（流式）</td><td>Nova-3 多语</td><td>$0.0052/分钟</td><td>$0.0044/分钟</td></tr>
              <tr><td>STT（流式）</td><td>Flux</td><td>$0.0065/分钟</td><td>$0.0055/分钟</td></tr>
              <tr><td>TTS</td><td>Aura-2</td><td>$0.030/千字符</td><td>$0.027/千字符</td></tr>
              <tr><td>TTS</td><td>Aura-1</td><td>$0.015/千字符</td><td>$0.013/千字符</td></tr>
            </tbody>
          </table>
          <p><strong>成长计划</strong>（约 $1,000+/月）提供 12-20% 的量级折扣。Deepgram 还提供 <strong>初创企业计划</strong>，符合条件的企业最高可获得 $100K 额度。所有新账户注册即获 <strong>$200 免费额度</strong>——无需信用卡。</p>

          <h2>精度：Nova-3 基准测试 — WER 降低 54%</h2>
          <p>Nova-3 代表了 STT 精度的重大飞跃。Deepgram 声称在内部基准测试中，相对于 Nova-2 降低了 54% 的词错误率（WER）。实际表现如下：</p>
          <ul>
            <li><strong>干净音频（录音室播客）：</strong> WER 约 3-5% — 接近人工转录水平</li>
            <li><strong>对话（呼叫中心）：</strong> WER 约 8-12% — 可用于实时座席辅助</li>
            <li><strong>噪音环境（现场录音）：</strong> WER 约 12-18% — 明显优于竞品</li>
          </ul>
          <p>端到端深度学习架构在处理背景噪音、多人说话、口音和领域专属词汇方面优于传统管道方案。</p>

          <h2>API 表面和开发者体验</h2>
          <p>Deepgram 为预录制音频提供简洁的 REST API，为实时流式传输提供 WebSocket API。SDK 支持 Python、JavaScript/Node.js、Go、.NET 和 Java。</p>

          <pre><code class="language-python">import requests

# STT - 预录制音频
url = "https://api.deepgram.com/v1/listen?model=nova-3"
headers = &#123;
    "Authorization": "Token YOUR_DEEPGRAM_API_KEY",
    "Content-Type": "audio/wav"
&#125;
with open("meeting.wav", "rb") as audio:
    response = requests.post(url, headers=headers, data=audio)

result = response.json()
print(result["results"]["channels"][0]["alternatives"][0]["transcript"])</code></pre>

          <pre><code class="language-python"># TTS - 文字转语音
url = "https://api.deepgram.com/v1/speak?model=aura-2"
headers = &#123;
    "Authorization": "Token YOUR_DEEPGRAM_API_KEY",
    "Content-Type": "application/json"
&#125;
data = &#123;"text": "你好，这是 Deepgram Aura-2 的语音。"&#125;
response = requests.post(url, headers=headers, json=data)

with open("output.mp3", "wb") as f:
    f.write(response.content)</code></pre>

          <p>开发者体验是强项：清晰且带有互动示例的文档、可无代码测试模型的网页 Playground、以及公开透明的详细基准数据。Deepgram 还提供<strong>自托管</strong>选项用于本地或气隙部署（SOC 2/HIPAA 合规），这在语音 AI API 提供中相当罕见。</p>

          <h2>优缺点</h2>
          <p><strong>优点</strong></p>
          <ul>
            <li>✅ Nova-3 STT 精度业界最佳（WER 降低 54%）</li>
            <li>✅ 亚 300ms 流式延迟——适合实时场景</li>
            <li>✅ 直接的即用即付定价，$200 免费额度</li>
            <li>✅ 50+ 种 STT 语言（含中文普通话和粤语）</li>
            <li>✅ 开发者友好，文档优秀</li>
            <li>✅ 自托管选项（气隙/本地部署）</li>
            <li>✅ SOC 2/HIPAA/GDPR/PCI 合规</li>
            <li>✅ 初创企业计划最高 $100K</li>
          </ul>
          <p><strong>缺点</strong></p>
          <ul>
            <li>❌ TTS 仅 7 种语言，不支持中文</li>
            <li>❌ 无中国大陆数据中心，需代理连接</li>
            <li>❌ 无联盟/推荐计划</li>
            <li>❌ 附加功能（自定义词汇、高级分离）额外收费</li>
            <li>❌ 非 LLM API——仅语音处理，无法生成文本</li>
            <li>❌ Whisper API 有并发限制、延迟较高</li>
          </ul>

          <h2>使用场景推荐</h2>
          <table>
            <thead>
              <tr><th>使用场景</th><th>推荐模型</th><th>原因</th></tr>
            </thead>
            <tbody>
              <tr><td>实时会议转录</td><td>Nova-3 单语（流式）</td><td>最佳精度 + 亚 300ms 延迟</td></tr>
              <tr><td>呼叫中心分析</td><td>Nova-3 多语 或 Flux</td><td>说话者分离 + 话轮检测</td></tr>
              <tr><td>视频字幕</td><td>Nova-3 多语（预录制）</td><td>批量处理，50+ 语言</td></tr>
              <tr><td>语音助手</td><td>Nova-3 STT + Aura-2 TTS</td><td>全双工语音管道</td></tr>
              <tr><td>医疗/法律转录</td><td>Nova-3 + 自定义词汇</td><td>领域术语精度</td></tr>
              <tr><td>自托管/气隙部署</td><td>Deepgram 自托管</td><td>本地部署 + SOC 2/HIPAA</td></tr>
              <tr><td>国内直连语音 API</td><td>FreeModel 聚合器</td><td>多厂商路由，国内直连</td></tr>
            </tbody>
          </table>

          <h2>竞品对比</h2>
          <table>
            <thead>
              <tr><th>厂商</th><th>最佳场景</th><th>STT 精度</th><th>国内访问</th><th>STT 定价（每分钟）</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>Deepgram</strong></td><td>最佳 STT 精度</td><td>最佳（Nova-3）</td><td>需代理</td><td>$0.0043-0.0077</td></tr>
              <tr><td><strong>ElevenLabs</strong></td><td>最佳 TTS，全语音栈</td><td>很好</td><td>需代理</td><td>$0.13/分钟</td></tr>
              <tr><td><strong>Azure Speech</strong></td><td>企业级，140+ 语言</td><td>好</td><td>需代理</td><td>$0.006-0.024</td></tr>
              <tr><td><strong>Google Cloud STT</strong></td><td>Google 生态</td><td>好</td><td>被阻断</td><td>$0.006-0.024</td></tr>
              <tr><td><strong>OpenAI Whisper</strong></td><td>开放模型，99+ 语言</td><td>好</td><td>需代理</td><td>$0.006/分钟</td></tr>
              <tr><td><strong>FreeModel</strong></td><td>多厂商聚合，国内直连</td><td>因厂商而异</td><td>直连</td><td>因厂商而异</td></tr>
            </tbody>
          </table>

          <h2>常见问题 (FAQ)</h2>
          <p><strong>问：Deepgram Nova-3 的英文 STT 精度有多高？</strong></p>
          <p>答：Nova-3 单语在同级别中实现最佳词错误率（WER），比 Nova-2 降低 54%。干净音频约 3-5% WER（接近人工转录），对话约 8-12%，噪音环境约 12-18%。</p>
          <p><strong>问：Deepgram 支持中文吗？</strong></p>
          <p>答：STT 支持中文（普通话和粤语），通过 Nova-3 多语和 Flux。TTS 不支持中文——Aura 模型仅支持 7 种语言。</p>
          <p><strong>问：国内能用 Deepgram 吗？</strong></p>
          <p>答：可以，但需要稳定的代理或 VPN。Deepgram 没有中国大陆数据中心。如需国内直连，可考虑 FreeModel 聚合器。</p>
          <p><strong>问：Deepgram 是否支持实时流式传输？</strong></p>
          <p>答：支持。Deepgram 通过 WebSocket 支持实时流式传输，延迟均低于 300ms。</p>
          <p><strong>问：Deepgram 是否通过 SOC 2 和 HIPAA 认证？</strong></p>
          <p>答：是的。Deepgram 已获 SOC 2 Type II、HIPAA 和 GDPR 合规认证。自托管选项可用于气隙环境。</p>

          <h2>总结</h2>
          <p>Deepgram 是优先考虑 STT 精度和延迟的开发者首选。Nova-3 单语是当前最具性价比的英文语音识别 API，开发者体验出色——API 简洁、文档完善、$200 免费额度慷慨。自托管选项对企业客户的数据驻留要求具有突出价值。</p>
          <p>主要局限是 TTS 语言支持范围窄（7 种语言，不含中文）和缺乏中国大陆数据中心。如需国内直连或多厂商语音 API 路由，可考虑 FreeModel（<a href="https://freemodel.dev/invite/FRE-7a3b6220"class="text-blue-600 hover:underline" target="_blank" rel="sponsored noopener">freemodel.dev/invite/FRE-7a3b6220</a>）提供的聚合方案。</p>

