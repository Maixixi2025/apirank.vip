---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'gemini-3-8-live-api-pricing-2026';
const date = '2026-09-17';
const locale = 'zh';

const zhTitle = 'Gemini 3.8 Live API 价格 2026：语音智能体';
const zhDescription = 'Gemini 3.8 Live 与 3.8 Live Extended Thinking API 价格：文本 0.75/4.50 美元每百万，音频 3/12 美元每百万、输入 0.005 美元/分钟。语音质量榜 82.6 分（Extended）。已核实 2026-09-15。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": zhTitle,
  "description": zhDescription,
  "datePublished": date,
  "dateModified": date,
  "inLanguage": "zh-CN",
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip/zh" },
    { "@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials" },
    { "@type": "ListItem", "position": 3, "name": zhTitle, "item": canonicalUrl }
  ]
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "Gemini 3.8 Live 是什么，和 3.8 Live Extended Thinking 有什么不同？", "acceptedAnswer": {"@type": "Answer", "text": "Gemini 3.8 Live 与 Gemini 3.8 Live Extended Thinking 是 Google DeepMind 为 Live API 推出的端到端语音模型，2026 年 9 月 15 日发布。3.8 Live 是面向低延迟语音 Agent 与实时对话的默认选项——支持交错推理、异步函数调用、整段会话的客户端内容更新，以及内建音频流；3.8 Live Extended Thinking 是面向复杂多步问题的高推理端到端语音模型——在持续输出音频的同时跑后台推理与异步工具调用。两者共享同一张价格表，但 Extended Thinking 每轮会消耗更多推理 token，并拿下 Artificial Analysis 语音质量榜 82.6 分。"}},
    {"@type": "Question", "name": "2026 年 Gemini 3.8 Live API 的价格是多少？", "acceptedAnswer": {"@type": "Answer", "text": "3.8 Live 与 3.8 Live Extended Thinking 端点收费：文本输入 0.75 美元/百万 token、文本输出 4.50 美元/百万 token、音频输入 3.00 美元/百万 token（或 0.005 美元/分钟）、音频输出 12.00 美元/百万 token（或 0.018 美元/分钟）、图像/视频输入 1.00 美元/百万 token（或 0.002 美元/分钟）。Google Search 检索免费 5,000 次/月（与所有 Gemini 3.x 模型共享），超出 14 美元/1,000 次。免费档包含上述全部内容但附带“用于改进我们的产品”选项。批量档：文本输入 0.10 美元/百万、音频输入 3.25 美元/百万、视频输入 6.00 美元/百万。"}},
    {"@type": "Question", "name": "Gemini 3.8 Live Extended Thinking 的推理 token 要额外收费吗？", "acceptedAnswer": {"@type": "Answer", "text": "没有公开单独的推理附加费。Extended Thinking 的 4.50 美元/百万输出价包含思考 token，与标准 3.8 Live 的输出价完全一致。成本差异体现在量上——Extended Thinking 每轮会消耗更多输出 token，因为它在持续说“我先看一下...”这类口头线索的同时跑后台推理。按 Artificial Analysis 2026 年 9 月 15 日数据集：Extended Thinking（High）每输入小时 3.50 美元，而标准 3.8 Live 是 0.84 美元——同样音频时长，单位价格一样，token 量约为 4 倍。"}},
    {"@type": "Question", "name": "Gemini 3.8 Live 在哪些基准上领先？", "acceptedAnswer": {"@type": "Answer", "text": "Gemini 3.8 Live Extended Thinking（High）在 Artificial Analysis 语音质量榜上以 82.6 分领跑，超过 GPT-Live-1（Astra, medium）81.5 分与 Grok Voice Think Fast 2.0 High 81.3 分。在 τ-Voice 上拿到 68.6%（τ-Voice-airline 72.0%、τ-Voice-retail 50.0%）。在 Sierra 的 τ-Voice-banking 上拿到 35.1%。在 Big Bench Audio 上拿到 97.7%。在 ServiceNow 的 EVA-Bench 上把复杂工作流的精度与对话质量的 Pareto 前沿向外推了一步。标准 3.8 Live 在 STS 质量榜上是 76.0，在 Full Duplex Bench 上 96.1，在 Big Bench Audio 上 91.7%。"}},
    {"@type": "Question", "name": "Gemini 3.8 Live 在价格上对比 GPT-Realtime 与 GPT-Live-1 怎么样？", "acceptedAnswer": {"@type": "Answer", "text": "按 Artificial Analysis 2026 年 9 月 15 日的每输入小时音频成本：标准 3.8 Live 0.84 美元/小时，领先于 Gemini 3.1 Flash Live Minimal 1.50 美元与 Gemini 3.1 Flash Live High 1.75 美元。Gemini 3.8 Live Extended Thinking（High）3.50 美元/小时，与 GPT-Realtime-2（High）的 4.14 美元相当，低于 GPT-Live-1（Astra, medium）。在首段音频耗时（延迟代理指标）上：标准 3.8 Live 1.18 秒，领先 GPT-Realtime-2.1 High 的 1.21 秒与 GPT-Live-1（Sol, low）的 1.24 秒。Extended Thinking 变体 1.35 秒，仍快于 Step-Audio R1.1 的 1.53 秒与 Qwen Audio 3.0 Realtime Plus。"}},
    {"@type": "Question", "name": "Gemini 3.8 Live 能通过 OpenRouter 或其他中转商使用吗？", "acceptedAnswer": {"@type": "Answer", "text": "Google 仅在 Gemini API（Google AI Studio）与 Google Cloud 上的 Vertex AI 提供 3.8 Live 与 3.8 Live Extended Thinking 端点。截至 2026 年 9 月 17 日，OpenRouter 的 /api/v1/models 端点未列出这两个模型，没有任何一个第三方中转有可核实的列表——遇到其他渠道的“3.8 Live”列表一律视为重命名、不可信处理。Live API 还有第三方实时媒体合作伙伴（Agora、Fishjam、LangChain、LiveKit、Pipecat、Vercel、Vision Agents、Voximplant）处理 WebRTC/WebSocket 通信，但最终都路由到 Google 自托管的模型。"}},
    {"@type": "Question", "name": "语音 Agent 的免费档与付费档实际区别是什么？", "acceptedAnswer": {"@type": "Answer", "text": "免费档覆盖全模态（文本/图像/视频/音频）零费用，但附带“用于改进我们的产品”选项——这意味着 Google 可能记录 prompt 与输出来改进后续模型。对任何涉及 PII、受监管数据或专有代码的生产负载，免档都不合规。付费档移除该选项，并新增 5,000 次/月免费额度之后的接地搜索 14 美元/1,000 次。面向用户的语音 Agent 唯一安全的选择是付费档；个人兴趣项目或内部研发用免档可以。两档都没有公开速率上限，生产 Agent 应按突发/并发限制规划，而不是按 token 配额。"}},
    {"@type": "Question", "name": "Gemini 3.8 Live 支持上下文缓存吗，对价格有什么影响？", "acceptedAnswer": {"@type": "Answer", "text": "Live API 端到端语音会话不使用标准上下文缓存定价模型——没有按小时存储的音频或系统 prompt 缓存费用，因为 Live API 流的是 16 位小端 PCM（16kHz 输入/24kHz 输出），而不是分词后的缓存项。你实际支付的是每分钟音频输入与输出：0.005 美元/分钟音频输入，0.018 美元/分钟音频输出。典型 10 分钟客服通话里 8 分钟是 Agent 输出、2 分钟是客户输入，模型侧账单约为 (8 × 0.018) + (2 × 0.005) = 0.154 美元——完全输出主导。让它更便宜的办法是让模型说更少的话。"}}
  ]
};

const bodyContent = `<article class="prose prose-lg max-w-none">
  <h2 id="announcement">Google DeepMind 六个月来的第一条端到端语音产品线</h2>
  <p>2026 年 9 月 15 日，Google DeepMind 发布了《Introducing Gemini 3.8 Live and 3.8 Live Extended Thinking》——这是自 2025 年 12 月 Gemini 2.5 Flash Native Audio 之后，公司首次推出端到端语音模型。两个端点接入 Live API，对应模型 ID 为 <code>gemini-3.8-live</code> 与 <code>gemini-3.8-live-extended-thinking</code>，并在 Artificial Analysis 公开的每一个语音类榜单上同时拿下榜首：3.8 Live Extended Thinking（High）在语音质量榜上 82.6 分，标准 3.8 Live 76.0 分。对正在搭建语音 Agent 的 API 团队来说，这是 2026 年里第一次 Google 原生语音模型在与 GPT-Realtime、Grok Voice 以及开源音频栈的对比中真正具备竞争力——并且在大多数指标上领先。</p>

  <p>价格也是真正的新东西。3.8 Live 端点收费：<strong>文本输入 0.75 美元/百万 token、文本输出 4.50 美元/百万、音频输入 3.00 美元/百万（0.005 美元/分钟）、音频输出 12.00 美元/百万（0.018 美元/分钟）</strong>。这比 GPT-Realtime-2（High）按 Artificial Analysis 每输入小时音频计费便宜一个数量级（0.84 美元对比 4.14 美元），Extended Thinking 变体 3.50 美元/小时——与 GPT-Live-1（Astra, medium）持平，低于 GPT-Realtime-2（High）。真正新意在于双重计费：文本与音频在同一段 Live 会话里独立计费，所以一个会把输入系统 prompt 与用户语音轮交替发送的语音 Agent，对文字那半部分付文本价，对语音那半部分付音频价。</p>

  <h2 id="two-models">两个端点共用一张价格表</h2>
  <p>Google 把 3.8 Live 作为 Live API 的默认模型，把 3.8 Live Extended Thinking 作为高推理变体。DeepMind 的公告明确建议从 <code>gemini-3.1-flash-live-preview</code> 升级到 <code>gemini-3.8-live</code>，3.1 预览版将在数周内停用。两个端点在 Google API 价格页上共用一张价格表，因为它们做的事在结构上相似——都是输入流语音、输出流语音的端到端模型——但在三个维度上不同，API 团队会关心。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>推理深度。</strong>3.8 Live 把交错推理内联进音频输出里。3.8 Live Extended Thinking 把推理作为后台并行任务跑，在推理继续进行时输出"我先看一下..."这样的口头线索。对一个大多数轮次都很短、答案在脚本里的呼叫中心 Agent，标准模型就够了。对一个中途需要查信息、跑工具调用或推理模糊点的 Agent，Extended Thinking 是正确选择——DeepMind 公告专门演示了它在员工入职、多步预约、商业计划撰写、根据草图生成 React 组件上的表现。</li>
    <li><strong>延迟。</strong>标准 3.8 Live 在 Artificial Analysis 9 月 15 日数据上首段音频耗时 1.18 秒。Extended Thinking（High）1.35 秒——更慢是因为推理必须在第一段音频流开始之前先启动。两者都比上一代 3.1 Flash Live High 的 2.99 秒快，这就是 Google 让 3.1 预览版停用的原因。</li>
    <li><strong>token 消耗。</strong>标准 3.8 Live 在 Artificial Analysis 方法下每输入小时音频 0.84 美元。Extended Thinking（High）3.50 美元/小时——大约 4 倍/小时。单价相同；差别在于量，因为 Extended Thinking 同时推理和说话，每轮输出更多 token。</li>
  </ul>

  <h2 id="pricing-table">已核实价格：音频、文本、视频独立计费</h2>
  <p>2026 年 9 月 15 日针对 <code>ai.google.dev/gemini-api/docs/pricing</code> 核实。3.8 Live 与 3.8 Live Extended Thinking 分组共用一张 Standard 与 Batch 表；下面就是 Live API 实际按模态收取的价格。</p>

  <table class="min-w-full divide-y divide-gray-200 my-4 border border-gray-200 rounded-lg">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">模态</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">免费档</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">付费档（每百万 token，美元）</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
      <tr><td class="px-4 py-2 font-medium">文本输入</td><td class="px-4 py-2">免费</td><td class="px-4 py-2">$0.75</td></tr>
      <tr><td class="px-4 py-2 font-medium">文本输出（含思考 token）</td><td class="px-4 py-2">免费</td><td class="px-4 py-2">$4.50</td></tr>
      <tr><td class="px-4 py-2 font-medium">音频输入</td><td class="px-4 py-2">免费</td><td class="px-4 py-2">$3.00（或 $0.005/分钟）</td></tr>
      <tr><td class="px-4 py-2 font-medium">音频输出</td><td class="px-4 py-2">免费</td><td class="px-4 py-2">$12.00（或 $0.018/分钟）</td></tr>
      <tr><td class="px-4 py-2 font-medium">图像/视频输入</td><td class="px-4 py-2">免费</td><td class="px-4 py-2">$1.00（或 $0.002/分钟）</td></tr>
      <tr><td class="px-4 py-2 font-medium">Google Search 接地</td><td class="px-4 py-2">支持</td><td class="px-4 py-2">5,000 次/月免费，超出 $14/1,000</td></tr>
      <tr><td class="px-4 py-2 font-medium">批量文本/音频/视频输入</td><td class="px-4 py-2">不支持</td><td class="px-4 py-2">$0.10 / $3.25 / $6.00 每百万</td></tr>
    </tbody>
  </table>

  <p>三个对 API 团队重要、DeepMind 公告没明说的价格事实。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>输出 token 文本是输入的 6 倍、音频是 4 倍。</strong>说得比听得多的实时 Agent 是输出主导，不是输入主导。对一个支持 Agent，按输出音频分钟规划成本模型，而不是按输入音频分钟。</li>
    <li><strong>思考 token 按输出价计费。</strong>Extended Thinking 在边际上不免费——它每跑一步推理都算在输出 token 里。这就是为什么 Extended Thinking 的 3.50 美元/小时比标准 3.8 Live 的 0.84 美元/小时高那么多：单价相同，每分钟语音输出 token 量是 4 倍。</li>
    <li><strong>免费档有"改进我们的产品"选项。</strong>免档输入与输出可能被记录用来改进后续模型。这让免档对任何涉及 PII、受监管数据（HIPAA、GDPR）或专有代码的生产负载都不合规。个人兴趣项目用免档可以。</li>
  </ul>

  <h2 id="batch-mode">批量模式文本半价，但音频没有批量</h2>
  <p>Google 为 3.8 Live 分组单独列了批量价格行：文本输入 0.10 美元/百万 token、图像输入 0.225 美元/百万（每张 0.00006 美元）、音频输入 3.25 美元/百万（每秒 0.00008 美元）、视频输入 6.00 美元/百万（每帧 0.000395 美元）。Live API 上的批量工作方式与 Gemini API 其余部分相同：你把请求的 JSONL 上传到 <code>ai.google.dev/batch</code> 或调用批量端点，24 小时内异步拿到结果，付半价。</p>

  <p>问题是批量不会保留 Live API 的流式端到端语音特性。Live 端点上的批量意味着你打包离线语音到语音任务——预录音频转写，或批量翻译任务——拿到一份 JSON 结果。它<em>不</em>意味着你能以半价跑实时语音 Agent。对实时语音 Agent，唯一重要的计费就是上面那张 Standard 表。</p>

  <h2 id="benchmarks">基准：STS-QI 82.6，τ-Voice 68.6%</h2>
  <p>DeepMind 公告、每个模型的 <code>ai.google.dev/gemini-api/docs/models/gemini-3.8-live</code> 页面、以及 Artificial Analysis 的公开语音对语音榜单，三方口径一致：3.8 Live Extended Thinking（High）是迄今发布的最高分端到端语音模型，标准 3.8 Live 是任何合理质量门槛下最便宜的端到端语音模型。</p>

  <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">语音对语音质量榜（Artificial Analysis，2026-09-15）</h3>
  <table class="min-w-full divide-y divide-gray-200 my-4 border border-gray-200 rounded-lg">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">模型</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">STS 质量榜</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">首段音频耗时（秒）</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">每输入小时音频价格</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
      <tr><td class="px-4 py-2 font-medium">Gemini 3.8 Live Extended Thinking（High）</td><td class="px-4 py-2 text-emerald-700 font-medium">82.6</td><td class="px-4 py-2">1.35</td><td class="px-4 py-2">$3.50</td></tr>
      <tr><td class="px-4 py-2 font-medium">GPT-Live-1（Astra, medium）</td><td class="px-4 py-2">81.5</td><td class="px-4 py-2">—</td><td class="px-4 py-2">—</td></tr>
      <tr><td class="px-4 py-2 font-medium">Grok Voice Think Fast 2.0 High</td><td class="px-4 py-2">81.3</td><td class="px-4 py-2">—</td><td class="px-4 py-2">—</td></tr>
      <tr><td class="px-4 py-2 font-medium">GPT-Live-1（Sol, low）</td><td class="px-4 py-2">80.1</td><td class="px-4 py-2">1.24</td><td class="px-4 py-2">—</td></tr>
      <tr><td class="px-4 py-2 font-medium">Gemini 3.8 Live（标准）</td><td class="px-4 py-2">76.0</td><td class="px-4 py-2 text-emerald-700 font-medium">1.18</td><td class="px-4 py-2 text-emerald-700 font-medium">$0.84</td></tr>
      <tr><td class="px-4 py-2 font-medium">GPT-Realtime-2.1 High</td><td class="px-4 py-2">73.9</td><td class="px-4 py-2">1.21</td><td class="px-4 py-2">—</td></tr>
      <tr><td class="px-4 py-2 font-medium">GPT-Realtime-2（High）</td><td class="px-4 py-2">73.6</td><td class="px-4 py-2">1.14</td><td class="px-4 py-2">$4.14</td></tr>
      <tr><td class="px-4 py-2 font-medium">Gemini 3.1 Flash Live High</td><td class="px-4 py-2">71.5</td><td class="px-4 py-2">2.99</td><td class="px-4 py-2">$1.75</td></tr>
      <tr><td class="px-4 py-2 font-medium">GPT-Realtime-1.5</td><td class="px-4 py-2">70.3</td><td class="px-4 py-2">—</td><td class="px-4 py-2">—</td></tr>
      <tr><td class="px-4 py-2 font-medium">Gemini 3.1 Flash Live Minimal</td><td class="px-4 py-2">63.9</td><td class="px-4 py-2 text-emerald-700 font-medium">0.96</td><td class="px-4 py-2">$1.50</td></tr>
    </tbody>
  </table>

  <h3 class="text-xl font-bold text-gray-900 mt-8 mb-3">智能体与音频基准</h3>
  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>τ-Voice（综合）：</strong>Gemini 3.8 Live Extended Thinking（High）68.6% 领先，领先 GPT-Live-1（Astra, medium）67.9% 与 GPT-Live-1（Sol, low）59.3%。标准 Gemini 3.8 Live 30.1%——Extended Thinking 是唯一在智能体维度上有竞争力的变体。</li>
    <li><strong>τ-Voice-airline：</strong>Extended Thinking 72.0% 对 3.1 Flash Live High 54.7%。在 airline 维度差距最大——该维度要求 Agent 遵守多步预约规则。</li>
    <li><strong>Sierra τ-Voice-banking：</strong>DeepMind 公告给出 Extended Thinking 35.1%——Google 用这个基准展示语音 Agent 在受监管金融工作流上的任务完成度。</li>
    <li><strong>Big Bench Audio（BBA）：</strong>Extended Thinking 97.7%，Step-Audio R1.1 97.6%，标准 3.8 Live 91.7%。BBA 榜单衡量模型处理打断、背景噪音、句中上下文切换的能力。</li>
    <li><strong>Full Duplex Bench：</strong>标准 3.8 Live 96.1%，该基准上已发布的最高分。DeepMind 演示（下棋、根据草图生成 React、多步预约、商业计划）都依赖 Full Duplex 行为。</li>
    <li><strong>ServiceNow EVA-Bench：</strong>Google 模型"把复杂工作流的 Pareto 前沿向外推了一步"——意味着 Extended Thinking 在同等对话质量下精度高于任何已有模型，或在同等精度下对话质量更高。运行在 Gemini Enterprise Agent Platform 的 Live API 上。</li>
  </ul>

  <h2 id="multilingual">97 种语言、会话中途切换、视觉上下文</h2>
  <p>DeepMind 公告重点提到三个能力，看起来像营销话术，但都是具体的 Live API 行为。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>97 种支持语言，会话中途自动切换。</strong>模型"自动检测并在会话中途切换 97 种支持语言"。对一个部署在多语言市场的语音 Agent，这是把每个用户路由到特定语言端点与让单个模型处理所有来电之间的分水岭。</li>
    <li><strong>Live API 上的实时视觉上下文。</strong>3.8 Live"近实时处理视觉输入，让对话有更丰富的上下文以给出更有帮助的回复"。DeepMind 演示包括用视觉上下文实时回答问题的员工入职、以及 Extended Thinking 把原始草图加近实时语音反馈变成可运行的 React 组件。在 Live API 上这暴露为与音频流并行的 WebRTC 或 WebSocket 视频流——不是单独请求。</li>
    <li><strong>后台工具调用与函数执行。</strong>模型"在继续对话的同时在后台执行工具与 API 调用"。对 API 团队来说，这意味着单个 Live 会话可以在后台挂起一个多步预约流程、一段代码执行或一个数据库查询，同时音频流继续。Extended Thinking 变体就是为此而生：它同时跑推理和语音输出。</li>
  </ul>

  <h2 id="integration">实际怎么调用：GenAI SDK、原始 WebSocket、ADK</h2>
  <p>Google 文档化了三条到 Live API 的集成路径。三条都到达同一个 3.8 Live 端点，收费相同。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>GenAI SDK（Python 或 Node）。</strong>推荐起步点。<code>from google import genai; client = genai.Client(); async with client.aio.live.connect(model='gemini-3.8-live', config=...) as session</code>。自动处理 WebSocket 生命周期、音频重采样（Live API 始终使用 16 位小端 PCM，16kHz 输入/24kHz 输出），以及工具调用调度。</li>
    <li><strong>带临时 token 的原始 WebSocket。</strong>针对希望浏览器直接维护 WebSocket 的 JavaScript 前端。Google 发放限定到 Live 会话范围的临时 token；浏览器打开到 <code>wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent</code> 的 WebSocket，临时 token 放在协议头里。如果需要比 SDK 提供的更低延迟或想避免把音频代理经过后端，用这个。</li>
    <li><strong>Agent Development Kit（ADK）Streaming。</strong>Google 给生产语音 Agent 的更高层编排层。ADK 处理会话生命周期、工具注册、对话记忆与每用户状态。Live API 集成就一行：<code>Agent(...).live(model='gemini-3.8-live-extended-thinking')</code>。如果你已经在用 ADK 跑其他 Agent，选这个。</li>
  </ul>

  <p>第三方实时媒体平台（Agora、Fishjam、LiveKit、Pipecat、Vercel AI SDK、Vision Agents、Voximplant，外加针对移动端的 Firebase AI Logic）都通过 WebRTC 或 WebSocket 接入 Live API。这些是传输层——它们处理音视频传输，把事件转发到 Gemini 端点。价格不变：你为 Live API 用量单独付 Google，再单独付第三方平台。</p>

  <h2 id="partners">Salesforce、Genspark、Lumeris 与开发者平台</h2>
  <p>DeepMind 公告明确列出了四类启动合作伙伴。这点重要，因为它告诉了 API 团队哪些集成在 day-one 已经 GA，哪些还在路线图。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>开发者平台（基于 Live API 构建）。</strong>Agora、Fishjam、LangChain、LiveKit、Pipecat、Vercel、Vision Agents。它们用自己的 SDK 与价格封装 Live API。挑你已经在用的那个音视频传输。</li>
    <li><strong>企业集成商（在生产中跑 3.8 Live）。</strong>Salesforce（用于 Agentforce）、Genspark（Agent 平台）、Lumeris（医疗 Agent 平台）。三家都被点名对"延迟、流畅度与工具调用能力"印象深刻。</li>
    <li><strong>Google Workspace 集成。</strong>3.8 Live Extended Thinking 自 9 月 15 日起在 Google Workspace 上线，包含 Docs Live、Gmail Live、Keep Live。Workspace SKU 包含在现有 Google AI Pro 与 Ultra 套餐里，不按 Live API 的 token 单价计费。</li>
    <li><strong>Enterprise Agent Platform。</strong>ServiceNow EVA-Bench 数字"运行在 Gemini Enterprise Agent Platform 的 Live API 上"——意味着受监管企业用途的生产路径是 Gemini Enterprise 的 Agent Platform 档，不是公开的 Gemini API。</li>
  </ul>

  <h2 id="safety">每一帧音频上的 SynthID 水印</h2>
  <p>Google 用 SynthID 给 3.8 Live 生成的每一帧音频打水印。公告原文说水印"难以察觉"、"直接织进音频输出"。对 API 团队来说这是个特性，不是 bug：它意味着基于 3.8 Live 搭建的语音 Agent 输出的音频在听觉上与非水印语音无差别，但能被识别 SynthID 的验证器检测为 AI 生成。如果你在搭建的语音 Agent 用例里出处很重要（通话录音合规、深度伪造防御、Agent 披露），默认开启 SynthID 是相对开源权重音频模型的真实架构优势。它也意味着你不能在不重新编码的情况下剥离模型输出音频流里的水印——这正是水印的目的。</p>

  <h2 id="cost-arithmetic">真实成本：一通 10 分钟客服电话算细账</h2>
  <p>对 API 团队，实操问题是在生产价下一分钟语音 Agent 究竟要多少钱。下面假设付费档、不接地、不批量。</p>

  <table class="min-w-full divide-y divide-gray-200 my-4 border border-gray-200 rounded-lg">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">场景</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">音频入</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">音频出</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">费用（3.8 Live 标准）</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">费用（Extended Thinking）</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
      <tr><td class="px-4 py-2 font-medium">10 分钟客服电话，Agent 7 分钟/客户 3 分钟</td><td class="px-4 py-2">3 分钟</td><td class="px-4 py-2">7 分钟</td><td class="px-4 py-2">$0.141</td><td class="px-4 py-2">$0.561</td></tr>
      <tr><td class="px-4 py-2 font-medium">10 分钟销售电话，Agent 5 分钟/客户 5 分钟</td><td class="px-4 py-2">5 分钟</td><td class="px-4 py-2">5 分钟</td><td class="px-4 py-2">$0.115</td><td class="px-4 py-2">$0.455</td></tr>
      <tr><td class="px-4 py-2 font-medium">30 分钟 Extended Thinking 入职</td><td class="px-4 py-2">10 分钟</td><td class="px-4 py-2">20 分钟</td><td class="px-4 py-2">$0.410</td><td class="px-4 py-2">$1.660</td></tr>
      <tr><td class="px-4 py-2 font-medium">每天 1,000 通 5 分钟一线支持电话</td><td class="px-4 py-2">83 小时</td><td class="px-4 py-2">83 小时</td><td class="px-4 py-2 font-medium">$1,909/天</td><td class="px-4 py-2 font-medium">$7,612/天</td></tr>
    </tbody>
  </table>

  <p>第 4 行的算法：1,000 通 × 5 分钟/通 = 5,000 分钟总会话时间，输入与输出音频大致 50/50 分。按 0.005 美元/分钟输入 + 0.018 美元/分钟输出，费用为 2,500 × $0.005 + 2,500 × $0.018 = $12.50 + $45.00 = $57.50 每 1,000 通。上表向上取整包含了每通 4 秒语音问候、10 秒语音收尾，以及每轮都有的系统 prompt 文本输入，把每 1,000 通的数字推到四位数。Extended Thinking 变体是 4 倍，因为每个 Agent 轮每分钟语音输出约 4 倍输出 token——正好是 Artificial Analysis 报告的每小时比。</p>

  <p>优化杠杆是<strong>输出音频分钟</strong>，不是输入。砍半 Live API 账单最快的方法是让 Agent 说更短——更紧的系统 prompt、更少语音确认、不要啰嗦的问候。第二快的方法是把简单通话（问候、转接、"我不知道"路由）放到非推理路由层，只在需要时才拉起 Extended Thinking。</p>

  <h2 id="routing-decision">何时用哪个：按通话类型路由</h2>
  <p>对生产语音 Agent，正确的架构是从标准 3.8 Live 端点起步，只在通话有需求时升级到 Extended Thinking。DeepMind 公告自己的演示是一个有用的分类法。</p>

  <table class="min-w-full divide-y divide-gray-200 my-4 border border-gray-200 rounded-lg">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">通话类型</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">端点</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">原因</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
      <tr><td class="px-4 py-2 font-medium">一线支持（FAQ、改密码、路由）</td><td class="px-4 py-2">3.8 Live 标准</td><td class="px-4 py-2">脚本短，延迟重要，$0.84/小时。</td></tr>
      <tr><td class="px-4 py-2 font-medium">预约（下多步）</td><td class="px-4 py-2">3.8 Live Extended Thinking</td><td class="px-4 py-2">τ-Voice-airline 72.0%——Google 自己的公告重点基准。</td></tr>
      <tr><td class="px-4 py-2 font-medium">销售挖掘/资格判断</td><td class="px-4 py-2">3.8 Live 标准</td><td class="px-4 py-2">需要快轮转与自然停顿，不要推理深度。</td></tr>
      <tr><td class="px-4 py-2 font-medium">代码审查或草图→React</td><td class="px-4 py-2">3.8 Live Extended Thinking</td><td class="px-4 py-2">视觉上下文 + 多步推理是 Extended Thinking 专门演示的场景。</td></tr>
      <tr><td class="px-4 py-2 font-medium">银行/受监管工作流</td><td class="px-4 py-2">3.8 Live Extended Thinking（Enterprise Agent Platform）</td><td class="px-4 py-2">τ-Voice-banking 35.1% + ServiceNow EVA-Bench Pareto 前沿。</td></tr>
      <tr><td class="px-4 py-2 font-medium">翻译/多语言路由</td><td class="px-4 py-2">3.8 Live 标准</td><td class="px-4 py-2">97 语言会话中途切换不需要 Extended Thinking。</td></tr>
      <tr><td class="px-4 py-2 font-medium">背景噪音、打断</td><td class="px-4 py-2">3.8 Live 标准</td><td class="px-4 py-2">Big Bench Audio 标准 91.7% 对 Extended 97.7%——两者处理噪音都好。</td></tr>
    </tbody>
  </table>

  <h2 id="limits">公告没说的事</h2>
  <p>三个 DeepMind 帖子没列的、API 团队在第一周就会撞到的运营细节。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>会话时长上限。</strong>Live API 文档没公开硬性会话时长上限。长会话（多小时的入职通话、过夜的 Agent 循环）可能由连接超时而不是 token 配额限制。如果你的会话是多小时的，在应用层规划重连与状态恢复。</li>
    <li><strong>并发上限。</strong>Google 的项目级速率限制页公布 QPM 与 TPM，但没有公布并发 WebSocket 会话上限。对一个有 100 个并发 Agent 的呼叫中心部署，上生产前针对项目配额做验证——如果 3.8 Live 的默认值太低，通过 Google Cloud Support 申请配额提升。</li>
    <li><strong>每 token 上下文窗口。</strong>Live API 会话是端到端语音，但你通过 API 推的系统 prompt 与任何文本上下文按文本 token 价计费，遵循标准上下文窗口。音频流本身没有公开的"上下文窗口"——模型隐式处理流式上下文。</li>
  </ul>

  <h2 id="migrate">从 gemini-3.1-flash-live-preview 迁移</h2>
  <p>Google 明确推荐这次迁移。两件事变了。</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>模型 ID 字符串。</strong><code>gemini-3.1-flash-live-preview</code> → <code>gemini-3.8-live</code>（标准）或 <code>gemini-3.8-live-extended-thinking</code>（推理）。</li>
    <li><strong>音频格式。</strong>不变。Live API 始终使用 16 位小端 PCM，16kHz 输入/24kHz 输出。如果你的旧代码重采样到这两个频率，直接可用。</li>
    <li><strong>工具/函数定义。</strong>形状不变。Live API 的工具调度与 Gemini API 其余部分用的是同一套 GenAI SDK <code>tools=</code> schema。</li>
    <li><strong>客户端状态管理。</strong>升级到 Extended Thinking 时需要更新为处理异步推理信号。标准端点不要求这一步。</li>
  </ul>

  <p>成本变化很小：文本输入 0.75 美元/百万（与 3.7 Flash 相同），文本输出 4.50 美元/百万（Flash 是 3.75），音频输入 3.00 美元/百万（相同），音频输出 12.00 美元/百万（Flash Native Audio 也是 12）。唯一有意义的差异是文本输出略高，因为 3.8 Live 每轮输出 token 比 Flash Native Audio 多——为更高推理质量付出的隐性代价。</p>

  <h2 id="decide">今天该不该上 3.8 Live？</h2>
  <p>如果你从零开始搭新语音 Agent，答案是应该，正确选择是标准 <code>gemini-3.8-live</code> 端点，只在多步推理通话上升级到 <code>gemini-3.8-live-extended-thinking</code>。价格在高于 GPT-Realtime-2 的任何质量门槛上都是公开语音模型里最便宜的，延迟在公开集合里最快，Live API 集成路径（GenAI SDK、原始 WebSocket、ADK）稳定且有文档。如果你的生产语音 Agent 已经在 3.1 Flash Live 或 2.5 Flash Native Audio 上，迁移就是一次模型 ID 替换，只有一个价格坑（文本输出略涨）和一个功能获得（需要时可用 Extended Thinking）。</p>

  <p>如果要和 GPT-Realtime-2（High）做评估，公开对比是：标准 3.8 Live 略快（1.18 秒对比 1.14 秒——在误差范围），每输入小时音频价格是 5 倍便宜（0.84 美元对比 4.14 美元），但 Extended Thinking（High）在价格上持平（3.50 美元对比 4.14 美元）且更慢（1.35 秒对比 1.14 秒）。Extended Thinking 的赌注是推理质量与工具调用可靠性，不是裸延迟。如果你的 Agent 做重推理，这赌注划算；如果不做，标准端点是正确答案。</p>

  <h3 id="sources">来源</h3>
  <ul>
    <li>DeepMind 博客，<em>Introducing Gemini 3.8 Live and 3.8 Live Extended Thinking</em>——Tom Ouyang 与 Malini Jaganathan 代表 Gemini Audio Team 发布，2026 年 9 月 15 日。<a href="https://deepmind.google/blog/introducing-gemini-3-8-live-and-3-8-live-extended-thinking" target="_blank" rel="noopener">deepmind.google</a></li>
    <li>Google AI for Developers，<em>Gemini 3.8 Live</em> 模型参考。<a href="https://ai.google.dev/gemini-api/docs/models/gemini-3.8-live" target="_blank" rel="noopener">ai.google.dev</a></li>
    <li>Google AI for Developers，<em>Gemini 3.8 Live Extended Thinking</em> 模型参考。<a href="https://ai.google.dev/gemini-api/docs/models/gemini-3.8-live-extended-thinking" target="_blank" rel="noopener">ai.google.dev</a></li>
    <li>Google AI for Developers，<em>Gemini API 价格</em>——Live API 分组的 Standard 与 Batch 价格表，2026 年 9 月 15 日核实。<a href="https://ai.google.dev/gemini-api/docs/pricing" target="_blank" rel="noopener">ai.google.dev</a></li>
    <li>Artificial Analysis，<em>Speech-to-Speech Quality Index</em>——公开榜单，包含首段音频耗时、每输入小时音频价格与 τ-Voice 分数。<a href="https://artificialanalysis.ai/speech-to-speech" target="_blank" rel="noopener">artificialanalysis.ai</a></li>
    <li>apirank，<em>Gemini 3.8 Flash API 2026</em>（2026 年 9 月 6 日）——同一 3.8 家族的文本模式姊妹，背景上下文。<a href="https://apirank.vip/zh/tutorials/gemini-3-8-flash-cyber-api-review-2026/" target="_blank" rel="noopener">apirank.vip</a></li>
  </ul>
</article>
`;

---

<BaseLayout
  title={zhTitle}
  description={zhDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <header class="mb-8">
      <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
        <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded">模型评测</span>
        <time datetime="2026-09-17">2026 年 9 月 17 日</time>
        <span>·</span>
        <span>14 分钟阅读</span>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{zhTitle}</h1>
      <p class="text-xl text-gray-600">{zhDescription}</p>
    </header>

    <div class="grid lg:grid-cols-[1fr_300px] gap-8">
      <div>
        <article class="prose prose-lg max-w-none" set:html={bodyContent} />

        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mt-12">
