const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "OpenRouter 视频生成成本是多少？", "acceptedAnswer": {"@type": "Answer", "text": "每秒价格从 $0.03（Veo 3.1 Lite，无音频）到 $0.60（Veo 3.1 4K 带音频）不等。预算档是 Wan 2.6 和 Veo 3.1 Lite 的 $0.04-0.08/秒；旗舰档是 Veo 3.1、Sora 2 Pro 和 Runway Aleph 2.0 的 $0.30-0.60/秒。带音频的 5 秒 1080p 视频片段价格在 $0.40 到 $3.00 之间。"}}, {"@type": "Question", "name": "如何在不重写代码的情况下切换视频模型？", "acceptedAnswer": {"@type": "Answer", "text": "修改提交体中的 model 字段。端点、认证、响应形状、状态处理和下载 URL 在所有 26 个支持的模型中是相同的。模型特定的可选设置按模型验证，因此首先查询 /api/v1/videos/models 以确认你想要的组合是否受支持。"}}, {"@type": "Question", "name": "AI 视频生成需要多长时间？", "acceptedAnswer": {"@type": "Answer", "text": "通常 30 秒到几分钟，取决于模型、分辨率和片段长度。这就是为什么 API 是异步的而不是阻塞请求。推荐轮询间隔是 30 秒。"}}, {"@type": "Question", "name": "视频生成是否符合零数据保留？", "acceptedAnswer": {"@type": "Answer", "text": "不符合。异步检索步骤要求生成的输出被短暂保留以便下载，因此强制 ZDR 的账户不会被路由到视频生成。对于符合 ZDR 的视频，必须直接与每个供应商的端点集成。"}}, {"@type": "Question", "name": "我可以使用 Webhook 而不是轮询吗？", "acceptedAnswer": {"@type": "Answer", "text": "可以。在提交体中传递 callback_url，OpenRouter 将在任务达到终态时 POST 到该 URL。每次投递都包含 X-OpenRouter-Idempotency-Key 头用于去重。"}}, {"@type": "Question", "name": "我应该为批量 UGC 选择哪个模型？", "acceptedAnswer": {"@type": "Answer", "text": "Wan 2.6 $0.04-0.08/秒（无音频）是最便宜的 720p 选项。Veo 3.1 Lite $0.05/秒（带音频）是最便宜的带音频 720p 选项。"}}]};

const zhBody = "<h1 class=\"text-3xl font-bold text-gray-900 mt-8 mb-4\">OpenRouter \u89c6\u9891\u751f\u6210 API 2026 \u5b8c\u6574\u6307\u5357</h1>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">2026 \u5e74 8 \u6708 25 \u65e5\uff0cOpenRouter \u4e0a\u7ebf\u4e86\u4e00\u4e2a\u7edf\u4e00\u7684\u5f02\u6b65\u7aef\u70b9 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">POST /api/v1/videos</code>\uff0c\u5c06 <strong>26 \u4e2a\u89c6\u9891\u751f\u6210\u6a21\u578b</strong>\u96c6\u4e2d\u6258\u7ba1\u2014\u2014\u8986\u76d6\u5b57\u8282\u8df3\u52a8\u7684 Seedance\u3001\u8c37\u6b4c\u7684 Veo\u3001OpenAI \u7684 Sora 2\u3001\u963f\u91cc\u4e91\u7684 Wan\u3001Runway\u3001Kling\u3001HeyGen\u3001Black Forest Labs \u7684 FLUX \u4ee5\u53ca MiniMax \u7684 Hailuo\u3002\u5728\u6b64\u4e4b\u524d\uff0c\u8981\u7ed9\u5e94\u7528\u6dfb\u52a0\u89c6\u9891\u751f\u6210\u80fd\u529b\u610f\u5473\u7740\u6bcf\u4e2a\u4f9b\u5e94\u5546\u90fd\u8981\u63a5\u4e00\u5957\u72ec\u7acb\u7684 SDK\uff0c\u6bcf\u5957\u90fd\u6709\u81ea\u5df1\u7684\u8ba4\u8bc1\u3001\u8bf7\u6c42\u683c\u5f0f\u3001\u4efb\u52a1\u72b6\u6001\u3001\u8f6e\u8be2\u8282\u594f\u548c\u4e0b\u8f7d URL\u3002OpenRouter \u7684\u505a\u6cd5\u628a\u8fd9\u4e00\u5207\u538b\u7f29\u6210\u4e86\u4e00\u4e2a\u5de5\u4f5c\u6d41\uff1a\u63d0\u4ea4\u4efb\u52a1 \u2192 \u8f6e\u8be2 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">polling_url</code> \u2192 \u62c9\u53d6\u5b8c\u6210\u7684 MP4\u3002</p>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u672c\u6587\u57fa\u4e8e OpenRouter \u5b98\u65b9 2026 \u5e74 8 \u6708 25 \u65e5\u53d1\u5e03\u6307\u5357\u3001\u5f53\u65e5\u6293\u53d6\u7684 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">/api/v1/videos/models</code> \u5728\u7ebf\u76ee\u5f55\uff0826 \u4e2a\u6a21\u578b\uff09\u4ee5\u53ca\u5404\u6a21\u578b\u8fd4\u56de\u7684 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">pricing_skus</code> \u4ef7\u683c\u8868\u3002</p>\n\n<h2 class=\"text-2xl font-bold text-gray-900 mt-10 mb-4\">\u4e3a\u4ec0\u4e48\u662f\u5f02\u6b65 API\uff0c\u800c\u4e0d\u662f\u666e\u901a\u7684\u963b\u585e\u8c03\u7528</h2>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u5178\u578b\u7684\u6587\u672c\u8865\u5168 API \u5728 200-800 \u6beb\u79d2\u5185\u8fd4\u56de\u3002\u5178\u578b\u7684\u56fe\u50cf\u751f\u6210 API \u5728 1-4 \u79d2\u5185\u8fd4\u56de\u3002<strong>\u89c6\u9891\u751f\u6210\u662f\u7b2c\u4e00\u4e2a\u751f\u6210\u65f6\u95f4\u7ecf\u5e38\u8d85\u8fc7\u5355\u6b21 HTTP \u8bf7\u6c42\u8d85\u65f6\u5bb9\u5fcd\u5ea6\u7684 API \u7c7b\u522b</strong>\u3002OpenRouter \u7684\u6307\u5357\u5c06 30 \u79d2\u5230\u51e0\u5206\u949f\u7684\u751f\u6210\u65f6\u957f\u5217\u4e3a\u5e38\u89c1\u60c5\u51b5\u3002Serverless \u5e73\u53f0\uff08Cloudflare Workers\u3001AWS Lambda\uff09\u7684\u6267\u884c\u65f6\u957f\u4e0a\u9650\u662f 30 \u79d2\u5230 15 \u5206\u949f\uff1b\u4f01\u4e1a\u4ee3\u7406\u548c\u8d1f\u8f7d\u5747\u8861\u5668\u5728 60-300 \u79d2\u540e\u95f2\u7f6e\u8d85\u65f6\uff1b\u79fb\u52a8\u7f51\u7edc\u5728 30-60 \u79d2\u65e0\u54cd\u5e94\u540e\u65ad\u5f00\u3002</p>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u5f02\u6b65\u6a21\u5f0f\u662f\u6559\u79d1\u4e66\u7ea7\u522b\u7684\u4fee\u590d\u65b9\u6848\uff1a\u628a\u63d0\u4ea4\u548c\u5b8c\u6210\u5206\u5f00\u3002</p>\n\n<h2 class=\"text-2xl font-bold text-gray-900 mt-10 mb-4\">\u4ef7\u683c\uff1a$0.03/\u79d2 \u5230 $0.60/\u79d2</h2>\n\n<div class=\"overflow-x-auto my-6\"><table class=\"min-w-full divide-y divide-gray-200 border border-gray-200 text-sm\">\n<thead class=\"bg-gray-50\"><tr><th class=\"px-4 py-2 text-left font-semibold text-gray-900\">\u6a21\u578b</th><th class=\"px-4 py-2 text-left font-semibold text-gray-900\">\u8ba1\u8d39\u6a21\u5f0f</th><th class=\"px-4 py-2 text-left font-semibold text-gray-900\">720p/1080p \u4ef7\u683c</th><th class=\"px-4 py-2 text-left font-semibold text-gray-900\">4K \u6863</th><th class=\"px-4 py-2 text-left font-semibold text-gray-900\">\u652f\u6301\u97f3\u9891</th></tr></thead>\n<tbody class=\"divide-y divide-gray-100 bg-white\"><tr><td class=\"px-4 py-2 text-gray-700\">Veo 3.1</td><td class=\"px-4 py-2 text-gray-700\">$0.20/\u79d2\uff08\u65e0\u97f3\u9891\uff09/ $0.40/\u79d2\uff08\u97f3\u9891\uff09</td><td class=\"px-4 py-2 text-gray-700\">$0.20-0.40/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.40-0.60/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Veo 3.1 Fast</td><td class=\"px-4 py-2 text-gray-700\">$0.10/\u79d2\uff08\u65e0\u97f3\u9891\uff09/ $0.12/\u79d2\uff08\u97f3\u9891\uff09</td><td class=\"px-4 py-2 text-gray-700\">$0.08-0.10/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.25-0.30/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Veo 3.1 Lite</td><td class=\"px-4 py-2 text-gray-700\">$0.05/\u79d2\uff08\u65e0\u97f3\u9891\uff09/ $0.08/\u79d2\uff08\u97f3\u9891\uff09</td><td class=\"px-4 py-2 text-gray-700\">$0.03-0.05/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Sora 2 Pro</td><td class=\"px-4 py-2 text-gray-700\">$0.30-0.50/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.30\uff08720p\uff09/ $0.50\uff081080p\uff09</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Seedance 2.5</td><td class=\"px-4 py-2 text-gray-700\">video_tokens: $0.0000107/token</td><td class=\"px-4 py-2 text-gray-700\">~$0.18/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Seedance 2.0</td><td class=\"px-4 py-2 text-gray-700\">video_tokens: $0.000007/token</td><td class=\"px-4 py-2 text-gray-700\">~$0.13/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.000004/token</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Seedance 2.0 Fast</td><td class=\"px-4 py-2 text-gray-700\">video_tokens: $0.0000042/token</td><td class=\"px-4 py-2 text-gray-700\">~$0.08/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Seedance 2.0 Mini</td><td class=\"px-4 py-2 text-gray-700\">video_tokens: $0.0000035/token</td><td class=\"px-4 py-2 text-gray-700\">~$0.07/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Wan 3.0</td><td class=\"px-4 py-2 text-gray-700\">$0.05-0.10/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.10\uff08720p\uff09/ $0.20\uff081080p\uff09</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Wan 2.7</td><td class=\"px-4 py-2 text-gray-700\">$0.10/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.10/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Wan 2.6</td><td class=\"px-4 py-2 text-gray-700\">$0.04-0.08/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.08\uff08720p\uff09/ $0.12\uff081080p\uff09</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Kling v3.0 Pro</td><td class=\"px-4 py-2 text-gray-700\">$0.112/\u79d2\uff08+$0.056 \u97f3\u9891\uff09</td><td class=\"px-4 py-2 text-gray-700\">$0.112/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.112\uff081080p\uff09</td><td class=\"px-4 py-2 text-gray-700\">\u2705</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Runway Gen-4.5</td><td class=\"px-4 py-2 text-gray-700\">$0.12/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.12/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">Runway Aleph 2.0</td><td class=\"px-4 py-2 text-gray-700\">$0.28/\u79d2\uff0c\u6700\u4f4e $0.56</td><td class=\"px-4 py-2 text-gray-700\">$0.28/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">MiniMax H3</td><td class=\"px-4 py-2 text-gray-700\">$0.13/\u79d2 + $0.04/\u53c2\u8003\u56fe</td><td class=\"px-4 py-2 text-gray-700\">$0.13/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr><tr><td class=\"px-4 py-2 text-gray-700\">HeyGen Avatar IV</td><td class=\"px-4 py-2 text-gray-700\">$0.05/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">$0.05/\u79d2</td><td class=\"px-4 py-2 text-gray-700\">\u2014</td><td class=\"px-4 py-2 text-gray-700\">\u274c</td></tr></tbody></table></div>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u6765\u6e90\uff1a<code class=\"bg-gray-100 px-1 rounded text-pink-700\">https://openrouter.ai/api/v1/videos/models</code>\uff0c\u6293\u53d6\u65f6\u95f4 2026 \u5e74 8 \u6708 26 \u65e5\u3002</p>\n\n<p class=\"text-gray-700 leading-relaxed my-4\"><strong>Veo 3.1 Lite $0.03-0.05/\u79d2\u662f\u5e26\u97f3\u9891\u7684\u6700\u4fbf\u5b9c 720p \u6a21\u578b</strong>\uff0c<strong>Wan 2.6 $0.04-0.08/\u79d2\u662f\u4e0d\u5e26\u97f3\u9891\u7684\u6700\u4fbf\u5b9c 720p \u6a21\u578b</strong>\u3002\u4e00\u6bb5\u5e26\u97f3\u9891\u7684 5 \u79d2 1080p \u89c6\u9891\u7247\u6bb5\u4ef7\u683c\u4ece <strong>$0.40\uff08Wan 2.6\uff09</strong> \u5230 <strong>$3.00\uff08Veo 3.1 4K \u97f3\u9891\uff09</strong>\u3002</p>\n\n<h2 class=\"text-2xl font-bold text-gray-900 mt-10 mb-4\">\u5df2\u9a8c\u8bc1\u7684\u7aef\u70b9\u884c\u4e3a</h2>\n\n<h3 class=\"text-xl font-semibold text-gray-900 mt-8 mb-3\">\u63d0\u4ea4\u4efb\u52a1</h3>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u552f\u4e00\u7684\u63d0\u4ea4\u7aef\u70b9\u662f <code class=\"bg-gray-100 px-1 rounded text-pink-700\">POST https://openrouter.ai/api/v1/videos</code>\u3002\u6210\u529f\u63d0\u4ea4\u8fd4\u56de <strong>HTTP 202 Accepted</strong> \u4ee5\u53ca\u4efb\u52a1\u5c01\u88c5\uff1a</p>\n\n<pre class=\"bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm my-4\"><code>\n{\n  \"id\": \"job-abc123\",\n  \"status\": \"pending\",\n  \"polling_url\": \"https://openrouter.ai/api/v1/videos/job-abc123\"\n}\n</code></pre>\n\n<h3 class=\"text-xl font-semibold text-gray-900 mt-8 mb-3\">\u8f6e\u8be2\u4efb\u52a1</h3>\n\n<p class=\"text-gray-700 leading-relaxed my-4\"><code class=\"bg-gray-100 px-1 rounded text-pink-700\">polling_url</code> \u4e0e <code class=\"bg-gray-100 px-1 rounded text-pink-700\">GET https://openrouter.ai/api/v1/videos/{id}</code> \u76f8\u540c\u3002\u4efb\u52a1\u4f1a\u7ecf\u5386\uff1a<code class=\"bg-gray-100 px-1 rounded text-pink-700\">pending</code> \u2192 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">in_progress</code> \u2192 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">completed</code> / <code class=\"bg-gray-100 px-1 rounded text-pink-700\">failed</code> / <code class=\"bg-gray-100 px-1 rounded text-pink-700\">cancelled</code> / <code class=\"bg-gray-100 px-1 rounded text-pink-700\">expired</code>\u3002\u63a8\u8350\u8f6e\u8be2\u95f4\u9694 <strong>30 \u79d2</strong>\u3002</p>\n\n<h3 class=\"text-xl font-semibold text-gray-900 mt-8 mb-3\">\u4e0b\u8f7d\u5b8c\u6210\u7684\u89c6\u9891</h3>\n\n<p class=\"text-gray-700 leading-relaxed my-4\">\u5f53 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">status: \"completed\"</code> \u5230\u8fbe\u65f6\uff0c\u54cd\u5e94\u5305\u542b\u4e00\u4e2a\u586b\u5145\u597d\u7684 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">unsigned_urls</code> \u6570\u7ec4\uff0c\u9700\u8981 <code class=\"bg-gray-100 px-1 rounded text-pink-700\">Authorization: Bearer</code> \u8bf7\u6c42\u5934\uff1a</p>\n\n<pre class=\"bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm my-4\"><code>\ncurl \"https://openrouter.ai/api/v1/videos/job-abc123/content?index=0\" \\\n  -H \"Authorization: Bearer *** \\\n  --output out.mp4\n</code></pre>\n\n<h3 class=\"text-xl font-semibold text-gray-900 mt-8 mb-3\">\u4e00\u884c\u5207\u6362\u6a21\u578b</h3>\n\n<pre class=\"bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm my-4\"><code>\nMODEL = \"bytedance/seedance-2.0\"  # \u6216 \"google/veo-3.1\" \u6216 \"alibaba/wan-2.7\"\njob = submit_video(model=MODEL, prompt=PROMPT)\ncompleted_job = poll_video(job)\ndownload_video(completed_job)\n</code></pre>\n\n<h2 class=\"text-2xl font-bold text-gray-900 mt-10 mb-4\">\u5df2\u9a8c\u8bc1\u7684\u9650\u5236</h2>\n\n<ul class=\"list-disc pl-6 my-4 space-y-1 text-gray-700\">\n<li>**\u96f6\u6570\u636e\u4fdd\u7559\uff08ZDR\uff09\u4e0d\u652f\u6301**\u89c6\u9891\u751f\u6210\u3002</li>\n<li>**\u97f3\u9891\u80fd\u529b\u5dee\u5f02\u5de8\u5927**\u300226 \u4e2a\u6a21\u578b\u4e2d\u53ea\u6709 9 \u4e2a\u652f\u6301 `generate_audio: true`\u3002</li>\n<li>**\u5206\u8fa8\u7387\u652f\u6301\u5dee\u5f02\u5de8\u5927**\u3002\u6709\u4e9b\u4ec5\u652f\u6301 720p\uff0c\u6709\u4e9b\u652f\u6301 480p/720p/1080p\uff0c\u53ea\u6709 Veo 3.1 \u652f\u6301 4k\u3002</li>\n<li>**`unsigned_urls` \u662f\u8bef\u5bfc\u6027\u540d\u79f0**\u3002\u8fd9\u4e9b URL \u4e0d\u662f\u9884\u7b7e\u540d\u7684\u3002</li>\n</ul>\n\n<h2 class=\"text-2xl font-bold text-gray-900 mt-10 mb-4\">\u603b\u7ed3</h2>\n\n<p class=\"text-gray-700 leading-relaxed my-4\"><strong>OpenRouter \u7684\u89c6\u9891 API \u662f\u9996\u4e2a\u8986\u76d6\u751f\u4ea7\u89c6\u9891\u751f\u6210\u73b0\u5b9e\u4ef7\u683c/\u8d28\u91cf\u8de8\u5ea6\u7684\u5355\u7aef\u70b9\u62bd\u8c61</strong>\u300226 \u4e2a\u6a21\u578b\u8db3\u4ee5\u5bf9\u9884\u7b97\u4e0e\u65d7\u8230\u8f93\u51fa\u8fdb\u884c A/B \u6d4b\u8bd5\u3002</p>\n\n<p class=\"text-gray-700 leading-relaxed my-4\"><strong>\u6602\u8d35\u7684\u6a21\u578b\u53ea\u503c\u5f97\u7528\u4e8e\u6838\u5fc3\u5185\u5bb9</strong>\u3002Veo 3.1 $0.40/\u79d2 \u662f\u4ea7\u54c1\u5