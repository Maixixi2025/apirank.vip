---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'claude-cowork-chat-merge-developer-migration-2026';
const date = '2026-09-18';
const locale = 'zh';

const zhTitle = "Claude Cowork 合并 2026：开发者迁移指南";
const zhDescription = "Claude Cowork 与 chat 合并为一个 Claude：API 团队需要改什么，附 Fable 5.1、Opus 5、Sonnet 5 核验价格。最后核验 2026-09-18。";
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": zhTitle,
  "description": zhDescription,
  "datePublished": date,
  "dateModified": date,
  "inLanguage": "zh-CN",
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip/zh" },
    { "@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials" },
    { "@type": "ListItem", "position": 3, "name": zhTitle, "item": canonicalUrl }
  ]
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Claude Cowork 与 chat 合并为一个 Claude 后，发生了什么变化？", "acceptedAnswer": { "@type": "Answer", "text": "2026 年 9 月 16 日，Anthropic 把 Claude Cowork 与 chat 合并为单一的 Claude 界面。Cowork 原本是为更大型工作开辟的独立工作区，Design 是为视觉工作开辟的独立空间；用户反馈最令人烦躁的是判断一项任务该归到哪边，而在一个入口开始的工作无法延续到另一个。合并之后，Claude 自行判断任务需要什么，Cowork 与 Design 的能力可从任意对话调用，并带着已有的上下文、skills 与 connectors。目前已在 Pro 与 Max 套餐上线，未来数周覆盖 Web、桌面与移动端，Team 与 Free 套餐随后跟进。" } },
    { "@type": "Question", "name": "Anthropic 在这次合并的同时调整了每 token API 价格吗？", "acceptedAnswer": { "@type": "Answer", "text": "没有。截至 2026 年 9 月 18 日，Anthropic 公布的 list rate 没有变化。Claude Fable 5.1 与 Mythos 5.1 仍为每百万 token 输入 10 美元、输出 50 美元，Claude Opus 5 为 5/25 美元，Claude Sonnet 5 为 2/10 美元，Claude Haiku 4.5 为 1/5 美元。有两条脚注影响预算：Claude Mythos 5.1 的缓存写入定价为基础输入价的 0.025 倍，而其他所有模型使用标准的 0.1 倍；而 Sonnet 5 的 2/10 美元定价现已成为标准价，而非促销价。" } },
    { "@type": "Question", "name": "Sonnet 5 原定的涨价怎么样了？", "acceptedAnswer": { "@type": "Answer", "text": "没有发生。Anthropic 在定价文档中说明，Claude Sonnet 5 的每百万输入输出 token 2/10 美元定价，在发布时被表述为截至 2026 年 8 月 31 日的促销价，现在已成为标准价格；原定于 2026 年 9 月 1 日上调至每百万 3/15 美元的计划不会发生。如果你为 2026 年三季度的 Sonnet 涨价留了预算，这一项可以删掉。" } },
    { "@type": "Question", "name": "消费端合并如何映射到 Claude API 原语？", "acceptedAnswer": { "@type": "Answer", "text": "Anthropic 已在文档中提供的 API 原语与合并后的消费端体验高度对应。一次较长的 Cowork 或 Project 任务就是一个 session（agent 加 environment 加 events），使用 managed-agents-2026-04-01 beta 头。coordinator 下的并行 thread 就是 multiagent orchestration：所有 agent 共享 sandbox、文件系统与 vault 凭据，但各自运行在上下文隔离的 thread 中。跨 session 的持久记忆是 memory store。project 用量中描述的花费上限是 session budget，按公开 list rate 计价。而 Claude 执行前先询问对应权限策略与工具审批。" } },
    { "@type": "Question", "name": "什么是 Managed Agents 的 session budget，它如何表现？", "acceptedAnswer": { "@type": "Answer", "text": "session budget 是在创建 session 时设置的可选硬性花费上限。平台会按公开 list rate 持续为该 session 消耗的一切计价，并在成本触及 budget 时停止发出新的模型请求。跨越上限时在途的请求仍会跑完，因此最终 list cost 可能略微超出。达到 budget 的 session 会暂停并进入 idle，而不是被终止；修改或移除 budget 会自动恢复其工作。budget 字段是 type 为 limit、加上 max_list_cost，金额是以字符串书写的整数美分，因此带引号的 125 表示 1.25 美元；像 25.00 这样的十进制写法会被拒绝。" } },
    { "@type": "Question", "name": "为什么 memory store 调用会返回 400 错误？", "acceptedAnswer": { "@type": "Answer", "text": "因为组合了 beta 头。Anthropic 的 memory 文档指出，在 memory store 请求上不应把 agent-memory-2026-07-22 与 managed-agents-2026-04-01 组合使用，因为两个都发会返回 400 错误。正确做法是在 memory store 调用上用 agent-memory-2026-07-22 替换 managed-agents-2026-04-01，而不是追加第二个值。Session 端点，包括把 memory store 挂到 session 上，仍然使用 managed-agents-2026-04-01。" } },
    { "@type": "Question", "name": "Claude Managed Agents 是否符合 Zero Data Retention 或 HIPAA BAA？", "acceptedAnswer": { "@type": "Answer", "text": "目前不符合。Anthropic 说明，由于 Claude Managed Agents 在设计上是有状态的，长时间运行的 session 会在服务端存储会话历史、sandbox 状态与产出，因此它目前不符合 Zero Data Retention 或 HIPAA BAA 的适用范围。数据控制权在你手上：你随时可以通过 API 删除 session，并单独删除你上传的文件。如果你的合规模型要求 ZDR，这个界面目前还不适合那类负载。" } },
    { "@type": "Question", "name": "Anthropic 在改版的 Claude Code project 里发布了什么？", "acceptedAnswer": { "@type": "Answer", "text": "该功能于 2026 年 9 月 17 日发布，改版后的 project 用一个指挥 thread 的 coordinator 取代了旧的人工交接流程。你选定一个目标加上代码仓库或上下文，Claude 会界定请求范围、委派工作、协调并行 thread、审查产出并组装结果。每个 thread 都是一个完整的 Claude Code cloud session，在自己的分支与仓库副本上工作；重叠部分像任何其他 PR 一样以合并冲突解决。每个 thread 都会写入并读取同一份共享记忆。首批开放给使用 cloud session、且原本没有 Web 或桌面端 project 的部分 Pro 与 Max 订阅者，随后一周逐步扩大。" } },
    { "@type": "Question", "name": "这次合并之后，API 团队应该先改什么？", "acceptedAnswer": { "@type": "Answer", "text": "把工作单元建模为 session 而不是 request，因为 session 在设计上是有状态的、暂停后可干净恢复，并在服务端存储历史、sandbox 状态与产出。然后在增加自主性之前先加 budget，使用以引号发送的整数美分 max_list_cost。把 beta 头搞对：session 与 orchestration 调用用 managed-agents-2026-04-01，memory store 调用用 agent-memory-2026-07-22。最后围绕有状态数据的取舍做规划，因为 Managed Agents 目前不符合 ZDR 或 HIPAA BAA，并在承诺上线日期前核对推出顺序。" } }
  ]
};

const bodyContent = `<article class="prose prose-lg max-w-none">
  <h2 id="announcement">Anthropic 把两个最大的入口合并成了一个 Claude</h2>
  <p><strong>2026 年 9 月 16 日</strong>，Anthropic 发布了 <em>Claude Cowork and chat are now one Claude</em>，结束了自 Cowork 作为独立工作区上线以来的产品分裂状态。这篇博文很短，措辞也刻意保持非技术化，但开发者要付出的迁移成本并不小：这家公司正在围绕单一对话界面收敛产品边界，而且同一天还上线了三个新的内容产物——Claude Docs、Claude Slides，以及现在可以在对话内部使用的 Claude Design。目前已在 Pro 和 Max 套餐上线，未来数周会覆盖 Web、桌面与移动端 App，Team 和 Free 套餐随后跟进。</p>

  <p>如果只读营销话术，你会把这件事归类为界面调整。它不是。Anthropic 每合并一次入口，底层的原语——session、memory、工具权限、上下文窗口、effort 等级——都会被重新审视一次，因为只有当同一个对话既能做五秒的查询、又能跑四小时的任务时，合并才成立。这次重新审视正是 API 侧迁移成本的所在，也是本文要讲的东西。</p>

  <p>给 API 团队的一句话结论：<strong>你的每 token 价格没有变</strong>，但你建模「一个工作单元」的方式应该变了。Anthropic 的平台文档里其实已经备好了全部零件——带 session、memory store、budget 和 multiagent orchestration 的 Managed Agents——而这次消费端合并是一个很强的信号：告诉你哪些零件正在成为默认心智模型。</p>

  <h2 id="what-shipped">9 月 16 日到底发了什么</h2>
  <p>一篇博文里三件事，而且它们互相叠加：</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>Cowork 与 chat 合并为一个 Claude。</strong> Cowork 原本是为更大型工作开辟的独立空间，Design 是为视觉工作开辟的。Anthropic 说用户「两者都用，并告诉我们最让人烦躁的部分是要判断一项任务该归到哪边」，而且在一个入口开始的工作无法延续到另一个。合并取消了这个选择：Claude 自己判断任务需要什么，Cowork 与 Design 的能力从任意对话中都可调用，并带着用户已有的上下文、skills 和 connectors。</li>
    <li><strong>Claude Docs 与 Claude Slides 上线（beta，付费套餐）。</strong> 两者都在对话内生成。Anthropic 给的例子是：中午要交一份周报，用户先问上周管线里有什么变动，再补一句「按我们一贯的写法写，标出任何延误的地方，并把要点做成五页给管理层会议」，然后同一段对话里同时产出文档和幻灯片——所以幻灯片和报告天然一致。可以下载为 PowerPoint 或 PDF、直接在 Claude 里演示，也可以在线编辑。</li>
    <li><strong>Claude Design 现在可以在对话内使用。</strong> 如果你一直单独使用 Design，它照旧可用——对现有 Design 用户是增量，对其他所有人是新功能。</li>
  </ul>

  <p>那篇博文里有两个细节比看上去更重要。第一，<strong>Claude 现在默认在执行动作前先询问</strong>，你可以改成持续工作、只在需要细看时才来问——Anthropic 的原话是「最终决定权在你」。第二，用 Design、Slides 或 Docs 做出来的任何东西<strong>都会存在一个可分享的链接上</strong>。这两句话描述的分别是一个 agent 权限模型和一个持久化产物存储。两者对 API 来说都不新，但现在它们成了默认的消费端体验，而 Anthropic 正是用这种方式让开发者心智模型正常化。</p>

  <h2 id="companion">第二天那篇配套博文才是真正的信号</h2>
  <p><strong>2026 年 9 月 17 日</strong>——也就是第二天——Anthropic 发布了 <em>Projects redesigned: from folder to conversation</em>，这篇明确讲的是 Claude Code 和 cloud session。它是同一个故事的开发者侧那一半，也是架构真正落地的地方。</p>

  <p>旧模型是：「在同一个构建上管理多个 session，过去需要你自己切分工作、手动交接、再把结果拼回去。」新模型是：「你描述需要完成什么，Claude 来管理这些工作。Claude 界定请求范围、委派工作、协调并行线程、审查产出，并组装出最终结果。」Anthropic 自己给的例子是一个类似「把应用结账流程的 p75 延迟降下来」的目标，之后 Claude 会剖析每个端点、测试优化方案、并在并行线程里开 PR。</p>

  <p>对任何基于 API 做开发的人来说，这里面的结构性细节才是有用的部分：</p>

  <ul class="list-disc pl-6 space-y-1 text-gray-700">
    <li><strong>Project 由一个 coordinator 和若干 thread 组成。</strong> Thread 干活，coordinator 指挥。你选定一个目标加上代码仓库或上下文，Claude 会建议它可以立刻接手的工作。</li>
    <li><strong>每个 thread 都是一个完整的 Claude Code cloud session</strong>，在自己的分支和仓库副本上工作。如果两个 thread 动到同一处代码，重叠部分「像任何其他 PR 一样」以合并冲突的方式解决。</li>
    <li><strong>Thread 还能继续拆分。</strong> 每个 thread 都可以用 subagents、loops 和 workflows 把被委派的工作再拆细，让大型任务更快完成。</li>
    <li><strong>记忆是共享且累积的。</strong>「现在每个 thread 都会写入并读取同一份共享记忆，减少了对复杂 prompt engineering 的需要。」Anthropic 举的例子包括：发布日改到了周五、导出功能为什么被砍掉、动结算服务之前该找谁确认。</li>
    <li><strong>用量限制成了一等公民问题。</strong> 因为每个 thread 都是完整 session，「project 会更快触及用量上限」。Anthropic 的答案是：你可以查看 project 级别的用量，并为 coordinator 对话以及 worker threads 分别选择模型和 effort 等级。</li>
  </ul>

  <p>改版后的 Project 首批开放给使用 Claude Code cloud session、且原本没有 Web 或桌面端 project 的部分 Pro 和 Max 订阅者，一周内逐步扩大，随后覆盖 chat 和 Cowork，Team/Enterprise 更晚。现有 project 照旧可用。</p>

  <h2 id="api-mapping">把消费端合并映射到 API 原语</h2>
  <p>这一节帮你省钱。Anthropic 平台文档其实已经暴露了那两篇博文描述的每一个原语，而且命名足够接近，你不需要等消费端功能变更日志就能规划迁移。</p>

  <div class="overflow-x-auto my-6">
    <table class="min-w-full text-sm border border-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-3 py-2 text-left font-semibold text-gray-900 border-b">消费端界面</th>
          <th class="px-3 py-2 text-left font-semibold text-gray-900 border-b">API 原语</th>
          <th class="px-3 py-2 text-left font-semibold text-gray-900 border-b">Beta 头 / 状态</th>
        </tr>
      </thead>
      <tbody class="text-gray-700">
        <tr>
          <td class="px-3 py-2 border-b">一次较长的 Cowork / Project 任务</td>
          <td class="px-3 py-2 border-b">Session（agent + environment + events）</td>
          <td class="px-3 py-2 border-b"><code class="bg-gray-100 px-1 rounded text-xs">managed-agents-2026-04-01</code></td>
        </tr>
        <tr>
          <td class="px-3 py-2 border-b">coordinator 下的并行 thread</td>
          <td class="px-3 py-2 border-b">Multiagent orchestration（共享 sandbox/文件系统/vault，上下文隔离）</td>
          <td class="px-3 py-2 border-b"><code class="bg-gray-100 px-1 rounded text-xs">managed-agents-2026-04-01</code></td>
        </tr>
        <tr>
          <td class="px-3 py-2 border-b">「Claude 记得发布日改到了周五」</td>
          <td class="px-3 py-2 border-b">Memory store（以目录形式挂载进 sandbox）</td>
          <td class="px-3 py-2 border-b"><code class="bg-gray-100 px-1 rounded text-xs">agent-memory-2026-07-22</code></td>
        </tr>
        <tr>
          <td class="px-3 py-2 border-b">「Project 会更快触及用量上限」</td>
          <td class="px-3 py-2 border-b">Session budget（按 list rate 计价的硬性美元上限）</td>
          <td class="px-3 py-2 border-b"><code class="bg-gray-100 px-1 rounded text-xs">managed-agents-2026-04-01</code></td>
        </tr>
        <tr>
          <td class="px-3 py-2 border-b">「Claude 执行前先询问」</td>
          <td class="px-3 py-2 border-b">Permission policies / 工具审批</td>
          <td class="px-3 py-2 border-b">按工具分别记录</td>
        </tr>
        <tr>
          <td class="px-3 py-2 border-b">Docs / Slides / Design 产物</td>
          <td class="px-3 py-2 border-b">Files API + Messages 面上的 Artifacts</td>
          <td class="px-3 py-2 border-b">Messages API 已 GA</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>这张表里最重要的一个注意事项是 <strong>budget</strong>。Anthropic 的文档对它的行为描述得异常精确，而这个行为比大多数人对「消费上限」的预期要友好：平台会「按公开 list rate 持续为 session 消耗的一切计价」，并在「成本触及 budget 时停止发出新的模型请求」。在途的那个请求仍会跑完，所以最终成本可能略超上限。关键在于，<strong>「达到 budget 的 session 会暂停并进入 idle，而不是被终止」</strong>——而修改或移除 budget 会自动恢复工作。如果你正准备自己给失控的 agent 造一个急停开关，这就是官方支持的那一版。</p>

  <p>budget 字段也是一个很好的例子，说明略读文档会怎么坑你。它是 <code class="bg-gray-100 px-1 rounded text-sm">type: limit</code> 加 <code class="bg-gray-100 px-1 rounded text-sm">max_list_cost</code>，而金额是<strong>以字符串形式书写的整数美分</strong>——<code class="bg-gray-100 px-1 rounded text-sm">"125"</code> 表示 1.25 美元。像 <code class="bg-gray-100 px-1 rounded text-sm">"25.00"</code> 这样的十进制写法会被拒绝，文档还特别提醒要把金额加引号，让它以字符串而不是数字发送。这是典型的 JSON schema 陷阱伪装成了文档。</p>

  <h2 id="memory-caveat">Memory 头与 Agent 头会互相冲突</h2>
  <p>如果你只从本文带走一个操作性细节，带走这个。Memory store 和 Managed Agents 用的是<em>不同</em>的 beta 头，而且错误组合会产生硬失败，而不是降级行为。</p>

  <p>按 Anthropic 的 memory 文档：在 memory store 请求上不要把 <code class="bg-gray-100 px-1 rounded text-sm">agent-memory-2026-07-22</code> 和 <code class="bg-gray-100 px-1 rounded text-sm">managed-agents-2026-04-01</code> 组合使用——两个都发会返回 <strong>400 错误</strong>。正确做法是在 memory store 调用上把 Managed Agents 头<em>替换</em>成 memory 头，而不是追加第二个值。Session 端点——包括把 memory store 挂到 session 上——继续使用 <code class="bg-gray-100 px-1 rounded text-sm">managed-agents-2026-04-01</code>。</p>

  <p>正是这类细节决定了「我的 agent 为什么在悄悄遗忘」的调试会话是花两分钟改一行，还是花一整天翻文档，而它恰恰容易在平台快速迭代时被埋掉。Memory store 本身是一个 workspace 级别的文本文档集合，「为 Claude 优化过」，以目录形式挂载进 session 的 sandbox。agent 用和操作文件系统其余部分相同的文件工具读写它，而每个挂载点都会有一条说明自动加入 system prompt，告诉 agent 该去哪里找。这种设计选择——记忆是挂载目录而不是魔法检索层——正是为什么必须启用 memory 工具集它才能工作。</p>

  <h2 id="what-it-costs">成本：价格没有变</h2>
  <p>值得明说，因为这类合并常常会附带一次调价：<strong>截至 2026 年 9 月 18 日，Anthropic 公布的每 token API 价格没有变化</strong>。以下为 Anthropic 自家定价文档中核验过的 list rate：</p>

  <div class="overflow-x-auto my-6">
    <table class="min-w-full text-sm border border-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-3 py-2 text-left font-semibold text-gray-900 border-b">模型</th>
