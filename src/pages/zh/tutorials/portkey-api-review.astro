<tr><td class="border border-gray-200 px-3 py-2">Mistral</td><td class="border border-gray-200 px-3 py-2">Mistral Large 3、Small 4、Codestral、Pixtral</td><td class="border border-gray-200 px-3 py-2">支持</td></tr>
<tr><td class="border border-gray-200 px-3 py-2">DeepSeek</td><td class="border border-gray-200 px-3 py-2">DeepSeek V3、V4、R1、Coder V2</td><td class="border border-gray-200 px-3 py-2">支持</td></tr>
