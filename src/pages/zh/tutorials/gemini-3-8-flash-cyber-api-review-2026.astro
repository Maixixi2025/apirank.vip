---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'gemini-3-8-flash-cyber-api-review-2026';
const date = '2026-09-06';
const locale = 'zh';

const zhTitle = 'Gemini 3.8 Flash API 2026：$0.75/M + Cyber 安全版';
const zhDescription = 'Gemini 3.8 Flash API 价格 2026：$0.75/$3.75 首发价、effort 控制、新增 Flash Cyber 安全变体（CWE-Bench 47.2%）。依据 DeepMind 官方 2026 年 9 月公告验证。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const zhCanonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = {"@context": "https://schema.org", "@type": "Article", "headline": zhTitle, "description": zhDescription, "datePublished": date, "dateModified": date, "author": {"@type": "Organization", "name": "APIRank", "url": "https://apirank.vip"}, "publisher": {"@type": "Organization", "name": "APIRank", "logo": {"@type": "ImageObject", "url": "https://apirank.vip/favicon.svg"}}, "mainEntityOfPage": {"@type": "WebPage", "@id": `https://apirank.vip/zh/tutorials/${slug}`}};
const breadcrumbJsonLd = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip/zh"}, {"@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials"}, {"@type": "ListItem", "position": 3, "name": zhTitle, "item": `https://apirank.vip/zh/tutorials/${slug}`}]};
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
{"@type": "Question", "name": "什么是 Gemini 3.8 Flash，何时发布？", "acceptedAnswer": {"@type": "Answer", "text": "Gemini 3.8 Flash 是 Google DeepMind 六周内第三个 Flash 家族版本，2026 年 9 月 2 日发布，官方定位为'迄今为止最好的推理与编程模型，速度与成本与 3.7 相同'。发布包含两个共享同一基础智能的变体：Gemini 3.8 Flash（面向长时程编程与自主智能体）和 Gemini 3.8 Flash Cyber（网络安全变体，通过 Fairwind 计划仅限受信防御者使用）。3.8 家族通过 Gemini API（Google AI Studio、Antigravity）、Gemini Enterprise，以及 Google AI Pro/Ultra 用户在 Gemini 应用、搜索 AI Mode、Sheets 中的 Google Gemini 提供。"}},
{"@type": "Question", "name": "2026 年 Gemini 3.8 Flash API 价格是多少？", "acceptedAnswer": {"@type": "Answer", "text": "Gemini 3.8 Flash 以与 Gemini 3.7 Flash 相同的首发价推出：每百万输入 token 0.75 美元、每百万输出 token 3.75 美元。DeepMind 公告脚注表明该首发价于 2026 年 12 月 31 日到期，自 2027 年 1 月 1 日起调整为每百万输入 1.50 美元、每百万输出 7.50 美元，与此前公布的 3.7 Flash 排期完全一致。截至 9 月 2 日公告，Google 尚未针对 3.8 Flash 单独公布上下文缓存或超长上下文附加价目表，请以 Google AI Studio 实时定价页为准。"}},
{"@type": "Question", "name": "Gemini 3.8 Flash Cyber 是什么，有何特别？", "acceptedAnswer": {"@type": "Answer", "text": "Gemini 3.8 Flash Cyber 是 Google 最强的网络安全模型，专为自主漏洞发现与自动化补丁修复打造。Google 刻意将能力偏向防御性的'修复'而非攻击性的'利用'。它带有比普通 3.8 Flash 更宽松的网络安全缓解策略，因此仅通过 Fairwind 计划提供给政府机构、关键基础设施运营方与软件维护者等受信防御者。在 Collinear 运营的外部补丁基准 CWE-Bench 上，其 pass@1 达 47.2%，与领先前沿模型的 47.8% 基本持平且成本显著更低。Google Chrome 安全团队实测其对真实 Chrome 漏洞给出的正确补丁比更大的商用模型多 2.6 倍。"}},
{"@type": "Question", "name": "Gemini 3.8 Flash 价格是永久降价还是首发优惠？", "acceptedAnswer": {"@type": "Answer", "text": "这是有排期的首发价，结构与 Google 2026 年 8 月对 3.7 Flash 的处理一致。每百万 token 0.75/3.75 美元的价格仅到 2026 年 12 月 31 日有效；2027 年 1 月 1 日起即付即用价格翻倍为输入 1.50 美元 / 输出 7.50 美元。若在年底前锁定包量或预置吞吐合同，部分场景可维持低价；但 2027 年之后的标准按量 API 将从翻倍价起算。"}},
{"@type": "Question", "name": "为什么 Gemini 3.8 Flash 有时比 3.7 用更多 token？", "acceptedAnswer": {"@type": "Answer", "text": "Google 的描述是一个刻意的设计选择：'3.8 Flash 会更努力地工作'。在复杂任务上，模型会执行额外推理步骤并迭代式调用工具，因此在较高 effort 档位下可能消耗更多 token 以换取质量。对以计算效率为优先约束的工作负载，开发者可调低 effort 档位减少 token 开销，或继续使用仍被完整支持的 Gemini 3.7 Flash 处理效率优先任务。这意味着对智能体工作负载，每-token 价格只是规划的必要而非充分输入——真正的成本驱动是所选 effort 档位下每完成一项任务的 token 数。"}},
{"@type": "Question", "name": "Gemini 3.8 Flash Cyber 能通过 OpenRouter 或中转商使用吗？", "acceptedAnswer": {"@type": "Answer", "text": "Google 将 Gemini 3.8 Flash Cyber 置于 Fairwind 计划之后，需要申请且仅限受信防御者，并非通用的即付即用 SKU，任何中转或聚合商（包括 OpenRouter 类网关）都无法合法转售不受限的 Cyber 访问。标准 Gemini 3.8 Flash 通过 Google 自有 Gemini API 与 Google AI Studio 提供。截至 2026 年 9 月公告，Google 尚未宣布 3.8 Flash 权重的第三方中转可用性，因此将其他渠道出现的'3.8 Flash'列表一律视为重命名不可信处理。"}}
]};

const zhBody = `<h1 class="text-3xl font-bold mb-6">Gemini 3.8 Flash API 2026：$0.75/M + Cyber 安全版</h1>
<p class="text-sm text-gray-500 mb-4"><time datetime="2026-09-06">2026 年 9 月 6 日</time> · Google Gemini API 评测 · 约 11 分钟</p>
<p class="text-lg text-gray-600 leading-relaxed mb-6">2026 年 9 月 2 日，Google DeepMind 推出 <strong>Gemini 3.8</strong>——六周内第三个 Flash 家族发布，也是官方口中"迄今为止最好的推理与编程模型，速度与成本与 3.7 相同"。本次发布以 <strong>共享同一基础智能的两个变体</strong> 呈现：面向长时程编程与自主智能体的 <strong>Gemini 3.8 Flash</strong>，以及通过新的 <strong>Fairwind 计划</strong> 仅限受信防御者的最强网络安全模型 <strong>Gemini 3.8 Flash Cyber</strong>。API 头牌价与 3.7 Flash 完全一致——<strong>每百万输入 token 0.75 美元、每百万输出 3.75 美元</strong>，且首发脚注注明该价格于 2027 年 1 月 1 日翻倍。真正的新意在于其背后的工程取舍："3.8 Flash 会更努力地工作"，用额外推理 token 换取智能体可靠性；再加上一个 Google 声称以更低成本站上外部补丁前沿的安全变体。以下是从一手公告中能核实的定价、基准与 API 规划。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">Gemini 3.8 Flash 是什么？</h2>
<p>Gemini 3.8 是 Google 于 2026 年 8 月 13 日发布的稳定版 Gemini 3.7 Flash 的继任者。"六周内第三个 Flash 发布"说明 Google 在低成本 Flash 线的迭代速度已快于高端档——3.8 以完全相同的头牌价落地了这一节奏带来的推理与编程收益。两个变体源自一个共享核心，该核心经过"网络安全这一高要求领域的严格训练"，其推理收益又被"为递归评估与精化底层模型而设计的长时间自主循环"进一步放大。</p>
<ul class="list-disc pl-6 space-y-1 text-gray-700 my-3">
  <li><strong>Gemini 3.8 Flash</strong>——面向智能体工作流、编程 agent 与专业领域多步推理的通用主力，通过 Gemini API、Google AI Studio、Antigravity、Stitch 与 Gemini Enterprise 提供。</li>
  <li><strong>Gemini 3.8 Flash Cyber</strong>——网络安全变体，聚焦自主漏洞发现与自动化补丁，经 Fairwind 计划申请后仅限受信防御者使用。</li>
</ul>
<p>两个变体都带 Google Frontier Safety Framework 的同一套防护（标准模型上有 CBRN 与网络攻击护栏；Cyber 模型则刻意采用更宽松的缓解策略但限量分发）。共享核心还带来 Gray Swan 测得的"提示注入鲁棒性的显著跃升"，这对任何把不可信内容传入上下文的 agent 都重要。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">已核实的定价：同首发价，2027 翻倍</h2>
<p>Google 并未把 3.8 Flash 压到比 3.7 更低——发布沿用同一首发价并写入同一翻倍排期。依 DeepMind 公告脚注，0.75/3.75 美元的价格于 2026 年 12 月 31 日到期。</p>
<table class="min-w-full divide-y divide-gray-200 my-4 border border-gray-200 rounded-lg">
  <thead class="bg-gray-50">
    <tr>
      <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">费率</th>
      <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">现在（至 2026-12-31）</th>
      <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">自 2027-01-01</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
    <tr><td class="px-4 py-2 font-medium">每百万输入 token</td><td class="px-4 py-2">$0.75</td><td class="px-4 py-2">$1.50</td></tr>
    <tr><td class="px-4 py-2 font-medium">每百万输出 token</td><td class="px-4 py-2">$3.75</td><td class="px-4 py-2">$7.50</td></tr>
  </tbody>
</table>
<p>对照更广前沿：0.75/3.75 美元使 3.8 Flash 只有 Anthropic Opus 级或 OpenAI GPT-6 级旗舰（GPT-6 Astra 每百万 10/50 美元）的零头。它定位是<strong>量的主力档</strong>——便宜到足以支撑高频 agent 调用与长时程循环，只有当单个 agent 会话烧掉异常多输出 token 时才会变贵。</p>
<p><strong>9 月 2 日公告中 Google 未公布的内容：</strong>针对 3.8 Flash 的独立上下文缓存附加费、超长上下文乘数、或具体上下文窗口上限。我不会替 Google 把这些数字填上——在估算生产负载前请以 Google AI Studio 实时定价页与 ai.google.dev 文档中的稳定模型 ID 为准。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">基准：收益落在哪里</h2>
<p>公告的证据分三簇，方向一致：3.8 Flash 在许多 agent 与推理基准上以更低的成本逼近甚至超越更大的前沿模型。</p>
<h3 class="text-xl font-bold mt-6 mb-3">Agent 编程与长时程工程</h3>
<ul class="list-disc pl-6 space-y-1 text-gray-700 my-3">
  <li><strong>DeepSWE v1.1（长时程软件工程）</strong>——Google 称 3.8 Flash"以更低成本端到端自主解决复杂工程问题，优于多数更大的前沿模型"。此基准与分钟到小时级自主工作中编程 agent 的可靠性关联最强。</li>
  <li><strong>Vals Finance Agent V2</strong> 与 <strong>Harvey 法律 Agent 基准</strong>——在这些"需要高级分析与报告"的量化和专业领域，3.8 Flash 同时胜过自家的 3.7 Flash 与其他前沿模型。</li>
  <li><strong>HLE-Verified 54.9%</strong>——Google 引用跨 STEM、人文与专业领域的多步推理基准 HLE-Verified 54.9% 作为模型"更努力地工作"而非简单产出更长链的证据。</li>
</ul>
<h3 class="text-xl font-bold mt-6 mb-3">网络安全——差异化变体所在</h3>
<p>对 API 受众而言，Gemini 3.8 Flash Cyber 才是本次发布真正新颖之处。Google 公布且我据公告正文核实的数据：</p>
<ul class="list-disc pl-6 space-y-1 text-gray-700 my-3">
  <li><strong>CyberGym</strong>（自主漏洞发现）——达到前沿水平，超越自家 3.5 Flash Cyber 与"显著更大的前沿模型"。</li>
  <li><strong>内部 20 语言基准</strong>——因 CyberGym 偏 C/C++，Google 还跨 20 种编程语言的复杂代码库做了测试，成功率超过 70%，"较先前模型有显著跃升"。</li>
  <li><strong>CWE-Bench</strong>（Collinear 运营的外部补丁基准）——pass@1 达 <strong>47.2%</strong>，对比领先前沿模型 47.8%，使 3.8 Flash Cyber "站上帕累托前沿"且成本显著更低。</li>
  <li><strong>Google 内部采用（自报，非第三方）</strong>——Chrome 安全团队测得其对真实 Chrome 漏洞给出的正确补丁比更大的最佳商用模型多 2.6 倍；安全厂商 Wiz 测得其内部渗透基准召回率提高 +7.5-9.7%，成本却低 2.3-5.2 倍；Google 云漏洞研究团队用它不到两小时找到一个通常"要数月"才能完成的严重基础性漏洞。</li>
</ul>
<p>Google 明确把 3.8 Flash Cyber 引向<strong>防御</strong>——"我们从一开始就投入漏洞修复，并将其优先级置于利用等攻击性能力之上"。对一个想要模型辅助补丁而非又一个漏洞生成器的安全团队，这个定位就是产品本身。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">"更努力地工作"的 token 代价</h2>
<p>关于 3.8 Flash 最重要的规划事实是：<strong>每 token 价格并非全部成本</strong>。Google 明确说模型被调教得更勤勉——"在复杂任务上展现更大 diligence：执行额外推理步骤、迭代式调用工具。在高 effort 档位下，模型有时会用更多 token 来最大化表现。"</p>
<p>对 agent 工作负载，有意义的成本单位是<strong>所选 effort 档位下每完成一项任务的 token 数</strong>，而非每百万费率。两个推论：</p>
<ul class="list-disc pl-6 space-y-1 text-gray-700 my-3">
  <li><strong>计算受限任务调低 effort。</strong>Google 说开发者"可调低 effort 档位以减少 token 开销"——不需要深度推理的抓取与分类管道应在低档运行，避免为用不到的勤勉买单。</li>
  <li><strong>把 3.7 Flash 留在工具箱。</strong>Google 声明 Gemini 3.7 Flash"仍被完整支持用于效率优先工作负载"。若你的流量对延迟与 token 敏感且用不到 3.8 的推理收益，3.7 是更省钱的默认；只把困难子集路由到 3.8。</li>
</ul>

<h2 class="text-2xl font-bold mt-8 mb-4">代码示例：两段真实调用</h2>
<p>Gemini 3.8 Flash 走 Google 标准 Gemini API 面，请求形态与 3.7 Flash 相同，只改模型串并按需设置生成配置。</p>
<h3 class="text-xl font-bold mt-6 mb-3">示例 1 - curl：agent 风格调用</h3>
<pre class="bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm my-4"><code>curl "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent" \\
  -H "x-goog-api-key: $GEMINI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "contents": [ { "role": "user", "parts": [ { "text": "Review this TS for a race...\\nlet cache = {};..." } ] } ],
    "generationConfig": { "temperature": 0.2, "maxOutputTokens": 1024 }
  }'</code></pre>
<p class="text-sm text-gray-500 my-3">注意：上线前请到实时 AI Studio 模型列表确认稳定模型 ID（<code>gemini-3.8-flash</code> 是否为临时预览后缀）——Google 历史上会给新 Flash 模型加几天预览标签再落地稳定 ID。</p>
<h3 class="text-xl font-bold mt-6 mb-3">示例 2 - Python：高吞吐批处理调低 effort</h3>
<pre class="bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto text-sm my-4"><code>import google.generativeai as genai
import os

genai.configure(api_key=os.environ["GEMINI_API_KEY"])

model = genai.GenerativeModel("gemini-3.8-flash",
    generation_config={"temperature": 0.0})

for t in ["Classify: refund", "Classify: feature request"]:
    print(model.generate_content(t).text)</code></pre>
<p class="text-sm text-gray-500 my-3">Gemini 3.8 是封闭权重、仅 API，无自托管路径；Flash Cyber 也并非通用 API SKU，仅 Fairwind 计划访问。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">谁该用 Gemini 3.8 Flash</h2>
<p class="mb-2"><strong>适用（标准 3.8 Flash）：</strong></p>
<ul class="list-disc pl-6 space-y-1 text-gray-700 mb-3">
  <li><strong>自主 / 长时程编程 agent</strong>——IDE 插件、CI 代码评审机器人、运行数分钟的多文件重构 agent。DeepSWE v1.1 提升 + 高迭代工具调用是其目标场景。</li>
  <li><strong>大规模专业多步推理</strong>——金融文档分析、法律研究起草、监管摘要，HLE-Verified 54.9% 与 agent 收益可减少重跑次数。</li>
  <li><strong>预算内的推理重负载</strong>——想在低于 1 美元输入档获得接近前沿推理，而非 Opus/GPT-6 级 10 美元输入档的团队。</li>
</ul>
<p class="mb-2"><strong>观望，或用 3.7 Flash：</strong></p>
<ul class="list-disc pl-6 space-y-1 text-gray-700 mb-3">
  <li>效率优先、延迟敏感的管道——留在 3.7 Flash（Google 称其"仍被完整支持用于效率优先工作负载"）。</li>
  <li>依赖硬性上下文/价格估算的部署——发布时 Google 尚未公布 3.8 的缓存与超长上下文价目表，等稳定定价页落地再上。</li>
  <li>普通对话式通用聊天——免费的免费档或 GPT-5.6 级即可。</li>
</ul>
<p><strong>Gemini 3.8 Flash Cyber</strong> 不是自助 API 产品——是需要申请的受限能力，面向政府机构、关键基础设施运营方与软件维护者。若你符合，DeepMind 页面的 Fairwind 申请是唯一正路；把别处出现的"不受限 3.8 Cyber API"一律视为未经核实。</p>

<h2 class="text-2xl font-bold mt-8 mb-4">结论</h2>
<p>Gemini 3.8 Flash 对已在 Gemini 3.7 Flash 上跑编程 agent 或专业推理负载的团队是正确的增量升级：年底前同价、推理与 agent 能力有可量测跃升、并给出诚实的取舍（难任务多烧 token，可用 effort 控制）。若你需要 Opus/GPT-6 级旗舰的原始上限，它不足以构成迁移理由——3.8 Flash 是逼近而非超越最大前沿模型的主力档，Google 也按此定价。本次发布真正独特的是 <strong>3.8 Flash Cyber</strong>：首个把与前沿相当的自动化补丁模型（CWE-Bench pass@1 47.2%，最大对手约 47.8%）置于受限防御者门槛之后的主流发布，并刻意把补丁优先于利用。对有资格使用的安全团队，这是能力类别的新增而非又一次降价。对其他人：若打算让 3.8 Flash 跑过 2027，请在 12 月 31 日前锁定 0.75/3.75 美元的首发价——即付即用列表价于 1 月 1 日翻倍。</p>
`;

---

<BaseLayout
  title={zhTitle + ' | APIRank'}
  description={zhDescription}
  canonicalUrl={zhCanonicalUrl}
  lang="zh"
>
