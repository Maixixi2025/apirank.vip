const zhTitle = '英伟达收购 Hugging Face：开发者 API 影响全解读';
const zhDescription = '英伟达以 129.3 亿美元收购 Hugging Face。对开源模型推理 API 定价、18 家推理供应商路由与中立性的影响分析。2027 年完成交易。';
const canonicalUrl = `https://apirank.vip/tutorials/${slug}`;
