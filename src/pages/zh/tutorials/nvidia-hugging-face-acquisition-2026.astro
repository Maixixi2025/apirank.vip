const articleJsonLd = {"@context": "https://schema.org", "@type": "Article", "headline": zhTitle, "description": zhDescription, "datePublished": date, "dateModified": date, "author": {"@type": "Organization", "name": "APIRank", "url": "https://apirank.vip"}, "publisher": {"@type": "Organization", "name": "APIRank", "logo": {"@type": "ImageObject", "url": "https://apirank.vip/favicon.svg"}}, "mainEntityOfPage": {"@type": "WebPage", "@id": `https://apirank.vip/zh/tutorials/${slug}`}};
const breadcrumbJsonLd = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip/zh"}, {"@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials"}, {"@type": "ListItem", "position": 3, "name": zhTitle, "item": `https://apirank.vip/zh/tutorials/${slug}`}]};
const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
{"@type": "Question", "name": "英伟达收购 Hugging Face 花了多少钱？", "acceptedAnswer": {"@type": "Answer", "text": "英伟达于 2026 年 9 月 3 日宣布以 12,930,300,000 美元（约 129.3 亿美元）收购 Hugging Face。Hugging Face 上一次公开估值是 2023 年的 45 亿美元（Salesforce Ventures 领投的 D 轮，英伟达也参与其中）。"}},
{"@type": "Question", "name": "英伟达收购 Hugging Face 何时完成？", "acceptedAnswer": {"@type": "Answer", "text": "据 The Register 2026 年 9 月 3 日报道，交易预计在 2027 年上半年完成，需经监管批准及其他惯例交割条件。截至 2026 年 9 月 5 日，尚未见美国 FTC/DOJ、欧盟或英国 CMA 的正式审查公开报道。"}},
{"@type": "Question", "name": "被英伟达收购后，Hugging Face 还会保持中立开放吗？", "acceptedAnswer": {"@type": "Answer", "text": "英伟达 CEO 黄仁勋承诺 Hugging Face 将继续作为整个 AI 生态的开放平台，不强制使用英伟达计算平台，并继续支持多云多加速器。但 Forrester 分析师 Charlie Dai 提醒企业应关注后续转变，不要假定承诺会永久持续。"}},
{"@type": "Question", "name": "英伟达收购 Hugging Face 会影响推理 API 价格吗？", "acceptedAnswer": {"@type": "Answer", "text": "目前 Hugging Face 将推理流量路由到 18 家第三方提供商（Together、Groq、Cerebras、Fireworks、DeepInfra、Fal、Replicate 等），且不加价，直接透传提供商成本。英伟达自己的 NIM/DGX Cloud 目前不在提供商之列。短期内价格风险是间接的：2027 年上半年交割前能否保住中立、不加价的市场形态，才是关键。"}},
{"@type": "Question", "name": "英伟达 NIM 是 Hugging Face 的推理提供商吗？", "acceptedAnswer": {"@type": "Answer", "text": "不是。截至 2026 年 9 月 5 日，Hugging Face Inference Providers 名单为 Baseten、Cohere、Cerebras、DeepInfra、Fal AI、Featherless AI、Fireworks、Groq、hf-inference、Novita、Nscale、OVHcloud、PublicAI、Replicate、Scaleway、Together、WaveSpeedAI 和 Z.ai。英伟达 NIM/DGX Cloud 不在名单上，Hub API 也会拒绝 nvidia-nim 查询。"}},
{"@type": "Question", "name": "因为英伟达收购，开发者应该马上换掉 Hugging Face 吗？", "acceptedAnswer": {"@type": "Answer", "text": "没必要立刻迁移。交易最早 2027 年上半年才完成，且英伟达做了明确的多提供商、不强制用英伟达计算的承诺。务实做法是分散依赖：直接使用两家独立提供商（如 Together + Groq），或通过 OpenRouter 这类中立聚合器，避免单一平台变动影响生产。交割前重点观察路由中立性与提供商名单是否有变。"}}
]};

const zhBody = `<h1 class="text-3xl font-bold mb-6">英伟达收购 Hugging Face：2026 年 API 开发者必须知道的事</h1>

<p class="text-lg leading-relaxed mb-4">2026 年 9 月 3 日，英伟达 CEO 黄仁勋宣布，英伟达已同意以 <strong>12,930,300,000 美元</strong>（约 <strong>129.3 亿美元</strong>）收购 Hugging Face。这是英伟达有史以来第二大收购——仅次于 2025 年底约 200 亿美元收购 Groq 资产，超过 2019 年约 70 亿美元的 Mellanox 交易。Hugging Face 上一次公开估值是 2023 年的 <strong>45 亿美元</strong>，当时英伟达也参与了其 D 轮融资。</p>

<p class="text-lg leading-relaxed mb-4">对任何基于开源权重模型开发的人来说——这也是本网站跟踪的 AI API 世界里的主要人群——这不是一个遥远的芯片故事。Hugging Face 是开源模型生态的<strong>分发层</strong>，而且正在成长为一个独立的<strong>推理 API 市场</strong>。创始人给出的动机是规模化：正如 Clément Delangue 在 X 上所说，开源已经证明自己"可以成为闭源 API 的补充，甚至替代方案。但要更大规模地实现，需要更多算力、更多支持、更多协作、更多可见性。于是我们去找了 Jensen，他主动提出与我们一同实现这一切。"</p>

<p class="text-lg leading-relaxed mb-4">本文是从 API 开发者的角度解读这笔交易：数字本身、最关键的开放承诺、在预计 <strong>2027 年上半年交割</strong>之前推理层真正面临风险的部分，以及本周就能做、零成本的分散化动作。</p>

<p class="text-lg leading-relaxed mb-4">最后核实日期：<strong>2026-09-05</strong>。交易金额、公告日期、此前估值、预期交割窗口、18 家推理提供商名单、英伟达 NIM 缺席情况以及所有引文均经一手来源核实（英伟达博客、CNBC、The Register、TechCrunch、Wired、The Verge、SiliconANGLE、Hugging Face 文档与 Hub API）。此日期之后的监管进展与提供商名单变动可能改变本文建议。</p>

<h2 class="text-2xl font-semibold mt-10 mb-4">交易、平台，以及这个数字为何重要</h2>

<p class="mb-4">Hugging Face 不只是模型中心——它是开放 AI 领域分发最集中的节点。据英伟达官方公告，平台规模如下：</p>

<pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm overflow-x-auto mb-4"><code>HUGGING FACE 平台一览（英伟达博客，2026-09-03）
  • 1800 万+ 开发者、研究人员与创作者
  • 300 万+ 共享模型
  • 50 万数据集
  • 100 万应用
  • 20 万+ 家企业在使用
  • 上一次公开估值：45 亿美元（2023 D 轮）
  • 英伟达本就是其最大的开源模型贡献方
    （500+ 模型、250+ 开源数据集）</code></pre>

<p class="mb-4">129.3 亿美元对价约为 2023 年估值的 <strong>2.9 倍</strong>。背景：据英国《金融时报》此前报道，Hugging Face 上一年曾拒绝了英伟达约 5 亿美元、对应约 70 亿美元估值的投资要约。创始人——2016 年前后在纽约创业的三位法国企业家 Clément ("Clem") Delangue（CEO）、Julien Chaumond 与 Thomas Wolf——据报道曾以约 130 亿美元（约为 2023 年估值的 3 倍）的价格区间探索出售。Delangue 告诉 CNBC，是他先主动接触英伟达，因为那是"完美的归宿"，而且"洽谈进展很快"。</p>

<h2 class="text-2xl font-semibold mt-10 mb-4">开放承诺：英伟达究竟承诺了什么</h2>

<p class="mb-4">对 API 开发者而言，公告中最重要的句子是黄仁勋给出的明确的中立承诺。值得逐字阅读：</p>

<blockquote class="border-l-4 border-blue-200 pl-4 italic text-gray-700 mb-4">"Hugging Face 将保持作为整个 AI 生态的开放平台。开发者可以选择他们想要的模型、框架、云提供商、推理服务提供商和计算平台。构建或部署 Hugging Face 都不强制要求使用英伟达计算平台。" <strong>—— 黄仁勋，英伟达博客，2026-09-03</strong></blockquote>

<p class="mb-4">黄仁勋进一步强调了多云：Hugging Face 将"继续支持多云、多加速器开发与部署"。他给出的理由是开放权重能为防守方带来"不对称优势"——保护者多于攻击者，且能透明协作。</p>

<p class="mb-4">黄仁勋在这件事上并不只是出钱。他联合署名了一封关于开放权重对 AI 经济重要性的公开信，而英伟达本是向 Hugging Face 贡献开源模型与数据最多的企业。这不是英伟达在谈判桌上才发现开放 AI；而是这位占主导地位的 AI 芯片厂商，买下了它早已依赖的分发层。</p>

<h2 class="text-2xl font-semibold mt-10 mb-4">真正面临风险的部分：推理层</h2>

<p class="mb-4">除了模型中心，Hugging Face 还运营着一个日益重要的<strong>推理 API 市场</strong>，行为类似 OpenAI 兼容的代理。截至 2026 年 9 月初，它通过 <strong>18 家第三方推理提供商</strong>路由请求——关键在于，英伟达自己的 NIM/DGX Cloud <strong>并不在其中</strong>。已核实的名单：</p>

<pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm overflow-x-auto mb-4"><code>HUGGING FACE 推理提供商（2026-09-05 核实）
  Baseten, Cohere, Cerebras, DeepInfra, Fal AI,
  Featherless AI, Fireworks, Groq, hf-inference,
  Novita, Nscale, OVHcloud, PublicAI, Replicate,
  Scaleway, Together, WaveSpeedAI, Z.ai
  → 英伟达 NIM / DGX Cloud：不在名单</code></pre>

<p class="mb-4">这个层面有三点属性是开发者最关注的资产：</p>

<p class="mb-4"><strong>1. 零厂商锁定的路由。</strong>Hugging Face 的 Inference Providers 产品明确主打"Zero Vendor Lock-in"。你可以在模型 id 后加提供商名来指定提供商（例如 <code>openai/gpt-oss-120b:groq</code>），或让平台按策略路由：<code>:fastest</code>（每秒 token 最高）、<code>:cheapest</code>（每个输出 token 价格最低）或你自己的 <code>:preferred</code> 顺序。当某提供商不可用时，流量自动故障切换到另一家。</p>

<p class="mb-4"><strong>2. 不加价透传。</strong>在 Hugging Face 的推理市场上，"Hugging Face 与提供商收取相同的费率——我们只是直接把提供商成本透传给你。"这种透传中立，正是开发者和小型聚合商信任它、把它当作开源模型推理价格基准底价的原因。一个垂直整合的所有者，即便这种动机被推迟，最终也会与"我们不挣差价、谁便宜谁快就路由给谁"产生潜在冲突。</p>

<p class="mb-4"><strong>3. 免费额度与 PRO 经济学。</strong>HF 给免费用户每月 <strong>$0.10</strong> 的算力积分，给 PRO 订阅者（仍为 $9/月）所有 HF 算力服务每月 <strong>$2.00</strong> 及 20 倍推理积分。金额虽小，却是开源模型 API 试用的真实入门斜坡。大厂收购方可以原样保留（成本低、开发者漏斗价值大），也可能悄悄降级这些贴钱的公共层级。</p>

<h2 class="text-2xl font-semibold mt-10 mb-4">结论是"推迟判定"，不是一锤定音</h2>

<p class="mb-4">在英伟达真正拥有 Hugging Face 之前，上述属性一项都不会变。交易要到 <strong>2027 年上半年</strong>才交割（需监管批准），而截至 2026 年 9 月 5 日，美国、欧盟或英国都尚无正式审查公开报道。也就是说，大约有三个季度，平台的定价、提供商名单都与今天无异。</p>

<p class="mb-4">分析师的共识是英伟达<em>初期</em>会保留开放性——因为 Hugging Face 的价值<strong>本身就在于中立</strong>——但团队应为中期做准备。Forrester 的 Charlie Dai 直言了战略逻辑：英伟达已拥有 GPU、CUDA、网络、推理软件与 AI 框架；Hugging Face"会让它在开发者、模型分发与社区层占据更强位置"，这关乎塑造"AI 工作负载在哪里被构建与部署"。企业应"关注后续转变"。Forrester 的 Naveen Chhabra 则把动机概括为锁定软件层："纯硬件公司会随时间被商品化"，而拥有模型分发层能带给英伟达客户偏好洞察。</p>

<div class="bg-amber-50 border border-amber-200 rounded-xl p-5 my-6">
  <h3 class="font-bold text-lg mb-2">⚠️ 2027 交割前重点观察的三件事</h3>
  <ul class="list-disc pl-5 space-y-2 text-sm">
    <li><strong>英伟达 NIM/DGX Cloud 会不会加入推理提供商名单？</strong>若加入，且 <code>:fastest</code>/<code>:cheapest</code> 路由偏向自有硬件，市场就失去了中立价格底价。</li>
    <li><strong>"不加价 + 透传"的说法能否延续？</strong>任何偏向英伟达计费、或捆绑定价的动作，都是整合最早的实质信号。</li>
    <li><strong>独立提供商（Together、Groq、Cerebras、Fireworks、Fal、Replicate）是否愿意继续合作？</strong>若任何一家退出 HF 路由，受损害的正是维持开源模型 API 价格公允的竞争。</li>
  </ul>
</div>

<h2 class="text-2xl font-semibold mt-10 mb-4">今天如何调用 Hugging Face 推理（代码）</h2>

<p class="mb-4">如果你已经在用 Hugging Face 的路由器，现在什么都不用改。OpenAI 兼容端点 <code>https://router.huggingface.co/v1</code> 继续可用，你可以显式指定提供商——这正是 Hugging Face 官方文档用 <code>openai/gpt-oss-120b:groq</code> 展示的写法。下面是固定路由到 Groq 的 curl 示例：</p>

<pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm overflow-x-auto mb-4"><code>curl https://router.huggingface.co/v1/chat/completions \\
  -H "Authorization: Bearer $HF_TOKEN" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "openai/gpt-oss-120b:groq",
    "messages": [{"role": "user", "content": "用一句话概括英伟达-Hugging Face 交易。"}]
  }'
# 加 :together / :groq / :fireworks-ai / :cerebras 等可固定到任意名单内提供商。
# 用 :fastest（默认）追求最高吞吐，或用 :cheapest 追求最低每输出 token 价格。
# 返回结构与 OpenAI 兼容（id / object / choices）。</code></pre>

<p class="mb-4">用 OpenAI SDK 走同一路由器的 Python 示例，使用 HF 默认的 <code>:fastest</code> 策略：</p>

<pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-sm overflow-x-auto mb-4"><code>import os
from openai import OpenAI

# HF 的路由器是即插即用的 OpenAI 兼容端点。模型 id 可带路由后缀：
# :fastest（默认）、:cheapest、:preferred，或提供商名（如 "openai/gpt-oss-120b:groq"）。
client = OpenAI(
    base_url="https://router.huggingface.co/v1",
    api_key=os.environ["HF_TOKEN"],   # 你的 HF 访问令牌
)

reply = client.chat.completions.create(
    model="openai/gpt-oss-120b:fastest",
    messages=[{"role": "user", "content": "用两句话解释一下提供商侧路由。"}],
    temperature=0.3,
    max_tokens=200,
)
print(reply.choices[0].message.content)

# 免费/PRO 用户使用每月算力积分（免费 $0.10、PRO $2.00）；
# 超出后购买额外积分，或设置 Custom Provider Key（BYOK），
# 绕过 HF 计费、直接按提供商原始费率付费。</code></pre>

<h2 class="text-2xl font-semibold mt-10 mb-4">本周零成本可以做的分散化动作</h2>

<p class="mb-4">因为交割要到 2027 年上半年，现在没有理由恐慌性迁移。但面对一次不确定的所有权更替，最便宜的保险就是让开源模型栈<em>现在</em>就已可移植。三个低成本动作，承诺递增：</p>

<p class="mb-4"><strong>1. 掌握你的直连提供商凭据。</strong>名单里的 18 家（Together、Groq、Cerebras、Fireworks、DeepInfra、Novita、Baseten、Replicate、Fal 等）都直接对外出售访问。如果今天你只有 HF token，在当中两家开个免费账户，就有了一条几分钟搞定的回退路径。</p>

<p class="mb-4"><strong>2. 任何必须持续运行的负载，优先走中立聚合器。</strong>位于 Hugging Face <em>之上</em>的聚合器——不拥有硬件、只路由到多家独立提供商——受这次特定整合的影响，小于"芯片厂商收购自己的分发层"的情形。在"加一层路由"就算增加复杂度，更是增加可选性。</p>

<p class="mb-4"><strong>3. 今天就固定你的关键模型。</strong>如果生产负载依赖 HF 的 <code>:fastest</code>/<code>:cheapest</code> 自动路由，记下当前每种策略实际命中的提供商。当交割后名单或路由算法变化，你能立刻知道<em>变的是什么</em>，而不必重新排查流量落在哪家。</p>

<h2 class="text-2xl font-semibold mt-10 mb-4">结论</h2>

<p class="mb-4">英伟达以约 129.3 亿美元收购 Hugging Face、预计 2027 年上半年交割，赌的是掌控开放 AI 的分发层——而不是短期内改变任何开源模型 API 的价格。平台真正的商业价值在于中立：一个 18 家提供商、不加价、多加速器的市场，其透传定价构成了开源推理公允价格的基准。</p>

<p class="mb-4">开发者的正确动作是：假定平台会保持开放（初期会的，因为那正是英伟达花钱买的资产），同时<em>现在</em>就消除单点依赖——交易窗口给了你三个干净的季度可以从容处理。备好双提供商回退、固定对路由敏感的负载、在交割时重新核查提供商名单与透传措辞——那时才是真正故事、以及任何真实价格影响开始上演的时刻。</p>

<p class="text-sm text-gray-500 mt-8">最后核实 2026-09-05。一手来源：英伟达博客（交易金额、平台数据、开放承诺）、CNBC（交易背景、Delangue 与黄仁勋引语）、The Register（预期 2027 上半年交割）、TechCrunch / Wired / The Verge / SiliconANGLE（此前估值、投资方、分析师引语）、Hugging Face Inference Providers 文档与 Hub API（18 家提供商名单、不加价路由、免费/PRO 积分）。Reuters 转载在抓取时被机器人拦截，已改用上述来源交叉印证。</p>
`;
---

<BaseLayout
  title={zhTitle + ' | APIRank'}
  description={zhDescription}
  canonicalUrl={zhCanonicalUrl}
  lang="zh"
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
      <article class="prose prose-lg max-w-none">
        <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
