    <meta itemprop="datePublished" content="{date}" />
    <meta itemprop="dateModified" content="{date}" />
    
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <div set:html={zhBody} />

    <!-- Affiliate CTA -->
    <div class="mt-12 p-6 bg-gradient-to-r from-indigo-50 to-blue-50 rounded-xl border border-indigo-100">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{affiliateSidebar.title}</h3>
          <p class="text-sm text-gray-600 mt-1">{affiliateSidebar.description}</p>
        </div>
        <a href={affiliateSidebar.url} class="inline-flex items-center px-5 py-2.5 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors" rel="nofollow sponsored" target="_blank">{affiliateSidebar.cta} →</a>
      </div>
    </div>
  </article>
</BaseLayout>
