const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Tavily 是什么？为什么 2026 年它成为默认搜索 API？", "acceptedAnswer": {"@type": "Answer", "text": "Tavily 是专为 AI Agent 设计的搜索 API。与 Google Custom Search、SerpAPI 只返回十条蓝色链接和 sitemap 不同，Tavily 返回的是答案——一个结构化 JSON 对象，包含原始页面内容、相关性评分、AI 生成摘要和引用图谱。Agent 在多步研究任务中只需一次调用就能拿到全部所需信息，工作流从 8 分钟缩短到 8 秒。它是 LangChain/LlamaIndex/AutoGen/CrewAI/smolagents 的默认搜索工具，且是 Trusted by 2M+ developers 的生态默认项。"}}, {"@type": "Question", "name": "Tavily 2026 年的端点目录是什么？", "acceptedAnswer": {"@type": "Answer", "text": "Tavily 暴露 6 个端点加 1 个 MCP server：Search（实时网页搜索+AI 摘要，1,000/月免费，$0.008/次）、Extract（从已知 URL 提取 markdown，1,000/月免费，$0.002/页）、Crawl（从根 URL BFS 遍历所有可达页面，500 页/月免费，$0.001/页）、Map（域名级 sitemap 发现，500/月免费，$0.001/页）、Research（多步搜索+合成，返回结构化研究简报，50/月免费，$0.04/次）、AI Extraction（按 JSON schema 结构化提取，1,000/月免费，$0.005/次）、MCP Server（2026 年 3 月上线，暴露 Search+Extract 作为标准 MCP 工具）。"}}, {"@type": "Question", "name": "Tavily 的免费层是真的免费吗？", "acceptedAnswer": {"@type": "Answer", "text": "是真的。Tavily 免费层提供 1,000 credits/月（滚动 30 天窗口），无信用卡、无功能阉割、无超额计费（超额返 HTTP 429 而非扣费）。Search 占 1,000 credits，Crawl 单独占 500 页配额。20 次/天的 Search 加 3 次/天的 Extract 约 690 credits/月，solo developer 跑生产研究 agent 完全免费。Project $30/月 起步提供 4,000 credits，Growth $200/月 40,000 credits，Pro $1,000/月 250,000 credits，Enterprise 合同制。"}}, {"@type": "Question", "name": "Tavily 的 Research 端点值得 $0.04/次 吗？", "acceptedAnswer": {"@type": "Answer", "text": "对 5+ 步搜索的研究工作流来说，几乎总是值得。Research 单次返回 answer + sources + research_steps（每步的子查询和结果数）+ citations + response_time。/research_steps 数组是审计利器，可直接日志、回放和验证。对比自建 agent 跑 10 次 Search + 5 次 Extract + 1 次合成 LLM（约 $0.15、25-35 秒），Research 是 $0.04、5-15 秒，便宜 4 倍、快 2-3 倍。仅当需要按域名过滤、按时间加权、跳过某些内容类型等细粒度策略时，Research 才不合适——此时用 Search+Extract 自定义。"}}, {"@type": "Question", "name": "Tavily 的 MCP server 怎么用？", "acceptedAnswer": {"@type": "Answer", "text": "Tavily MCP server 于 2026 年 3 月上线，已接入 Databricks MCP Marketplace 和 IBM WatsonX 平台，并与 JetBrains 集成，是 Claude Desktop 和 Cursor 生态中安装量最大的 MCP server。在 Claude Code、Codex、Cursor、Cline 中安装 Tavily MCP server 后重启编辑器，Search 和 Extract 即成为原生 agent 工具，无需写一行集成代码。MCP 与直接 API 同价，无 MCP 加价。唯一限制：MCP server 不暴露 /research 端点，多步研究工作流仍需从 agent 代码调用 Research。"}}, {"@type": "Question", "name": "Tavily 与 Jina AI、Exa、SerpAPI 相比如何？", "acceptedAnswer": {"@type": "Answer", "text": "Tavily 是唯一默认集成在 LangChain/LlamaIndex/AutoGen 中并自带 AI 摘要、Research 端点、MCP server 的方案；Jina AI 优势是 Reader API 便宜（按 token 计费，约 $0.06/M tokens）和更快（0.6s vs 1.4s P50），但 Jina 本质是内容提取 API 不是搜索 API；Exa 神经搜索语义理解更强（理解 papers on RLHF 这种查询），成本约 2x Tavily；SerpAPI 是 Google 结果抓取不是 AI 搜索 API，返回十条蓝色链接，需配合 Jina+LLM 三 API 工作流。决策：RAG agent 默认选 Tavily；纯提取选 Jina；学术/小众领域神经搜索选 Exa；SEO 工具需 Google SERP 选 SerpAPI。"}}, {"@type": "Question", "name": "Tavily 怎么处理速率限制和超额？", "acceptedAnswer": {"@type": "Answer", "text": "免费层超额直接 HTTP 429，无超额计费——agent 停止工作直到滚动窗口重置。付费层有超额计费，Developer $0.008/credit、Pro $0.005/credit。可在仪表板设硬性支出上限，达上限后自动切回 429 行为。这是生产 agent 的最佳默认：失控的 agent 循环在 2026 年制造过几笔惊人账单，硬性上限是最便宜的保险。"}}, {"@type": "Question", "name": "Tavily 能自托管吗？", "acceptedAnswer": {"@type": "Answer", "text": "不能。Tavily 是 hosted-only 服务，搜索索引、提取管道、Research 多步规划全部跑在 Tavily 自己的基础设施上，公司未发布自托管方案。需自托管的最接近替代：SearXNG（开源元搜索，无 AI 摘要、无 Research 端点）、Meilisearch（开源全文搜索，需自带内容）、Exa 企业版（合同制，需销售对接）。对 2026 年大多数生产 agent，hosted-only 是合理权衡——自托管搜索栈的工程时间成本往往高于 API 账单。"}}, {"@type": "Question", "name": "Tavily 的数据保留策略是什么？", "acceptedAnswer": {"@type": "Answer", "text": "Tavily 不保留超出运营所需的搜索查询或结果。query 和 results 载荷在内存中处理、评分、返回，不写入持久存储。唯一持久日志是聚合速率限制计数器和计费记录（含时间戳、端点、credit 消耗元数据），不含查询内容。企业客户可签 'no logs' 合约附加条款，进一步限制聚合元数据——这是医疗、金融、政府等查询内容本身受监管的工作负载的正确层级。"}}, {"@type": "Question", "name": "Tavily 与带浏览能力的 LLM 有什么区别？", "acceptedAnswer": {"@type": "Answer", "text": "OpenAI 带浏览的 GPT 模型、Anthropic 的 web search 工具、Google Gemini with Search Grounding 都返回基于实时网页数据的合成自然语言答案，但不给原始搜索结果、页面内容、引用图谱。LLM+浏览对聊天机器人是正确形态；对需要进一步加工搜索结果的 agent（结构化提取、存入向量数据库、与其他工具调用串联），Tavily 是正确形态。可靠性方面：带浏览的 LLM 偶尔不跟随重定向、被 JavaScript-heavy 页面卡住、返回幻觉引用；Tavily 管道为 agent 场景定制，失败模式不同且更可预测。对需可靠处理广泛网页内容的生产 agent，Tavily 是更可依赖的后端。"}}]};
const affiliateSidebar = {"title": "试试 FreeModel 多 Provider 路由", "description": "FreeModel 提供跨 OpenAI/Anthropic/DeepSeek/Gemini 等 50+ 模型的无缝路由，注册即得额度、零加价。", "url": "https://freemodel.dev/invite/FRE-7a3b6220", "cta": "免费试用"};

const zhBody = `<h1 class="text-3xl font-bold text-gray-900 mt-8 mb-4">Tavily 2026：被 LangChain/LlamaIndex/AutoGen 默认集成的 AI Agent 搜索 API</h1>

<p class="text-gray-700 leading-relaxed my-4">Tavily 是专为 AI Agent 设计的搜索 API。2026-07-31 核对：Tavily 是 LangChain TavilySearchResults、LlamaIndex TavilyToolSpec、AutoGen TavilySearchTool、CrewAI TavilySearchTool、smolagents TavilySearchTool 的默认集成，且 Trusted by 2M+ developers。其 Series A 融资 $25M（2026 H1），是生态默认的 agent-first 搜索层。</p>

<p class="text-gray-700 leading-relaxed my-4">本评测从 2026 年中工程师视角覆盖 Tavily API：Search/Extract/Crawl/Map/Research/AI Extraction 六大端点、按 credit 计费的价格模型、与 MCP server 的集成（Claude Code/Cursor/Codex 即装即用），以及与 Jina AI、Exa、SerpAPI 在相同工作负载下的对比。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">TL;DR</h2>

<ul class="list-disc list-inside text-gray-700 my-4 space-y-1">
<li><strong>AI Agent 默认搜索 API</strong>：LangChain/LlamaIndex/AutoGen/CrewAI/smolagents 全部默认集成，开发者在 2026 年写 RAG agent 第一个搜索补全是 Tavily</li>
<li><strong>1,000 credits/月免费层</strong>：无信用卡、无功能阉割、无超额计费（超额返 HTTP 429），RAG agent 原型阶段零成本</li>
<li><strong>/research 端点</strong>：5 credits/次，内嵌多步搜索+提取+合成 LLM，单次调用替代 50-100 行 agent 代码</li>
<li><strong>MCP server（2026-03）</strong>：Databricks MCP Marketplace + IBM WatsonX + JetBrains 集成，Claude Code/Cursor/Codex 零代码集成</li>
<li><strong>$0.008/credit 起</strong>：Pay-as-you-go，Project $30/月 4,000 credits、Growth $200/月 40,000 credits、Pro $1,000/月 250,000 credits</li>
<li><strong>Search+Extract 单调用范式</strong>：一次返回 answer + raw_content + 0-1 relevance score，省去后续提取步骤，2-5 秒/研究步骤</li>
<li><strong>2M+ developers</strong>：2026 H1 Series A $25M 融资，生态默认位置锁定</li>
<li><strong>最佳场景</strong>：RAG agent/自动化研究 agent、多步研究工作流、预算敏感 solo developer、Claude Code/Cursor MCP 集成</li>
</ul>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">为什么 Tavily 在 2026 年重要</h2>

<p class="text-gray-700 leading-relaxed my-4">2026 年的 AI 推理市场，搜索 API 已经从通用 Google Custom Search + SerpAPI 的传统栈，转向专为 agent 设计的新型 API。Tavily 是这一转型的领跑者，背后是三个与"搜索 API"对比表无关的关键事实：</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第一，它是每个主流 agent 框架的默认项。</strong>LangChain 的 TavilySearchResults、LlamaIndex 的 TavilyToolSpec、AutoGen 的 TavilySearchTool、CrewAI 的 TavilySearchTool、smolagents 的 TavilySearchTool 都调用同一个 API。当 2026 年的开发者写 RAG agent 搜索网页时，第一个自动补全建议就是 Tavily。这种网络效应比任何单独定价层级都重要。</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第二，1,000 calls/月免费层是真实的产能配额，不是降级 demo。</strong>无信用卡、无配额审批、无 7 天试用。免费层走的是与付费层完全相同的后端，相同延迟、相同结果质量。solo developer 或小团队可以在免费层上跑 24/7 研究 agent，只在工作流真正起飞时再付费。</p>

<p class="text-gray-700 leading-relaxed my-4"><strong>第三，Research 模式取代手写多步循环。</strong>Research 端点（2025-12 发布，2026-02 全面 GA）接受单条自然语言查询，自己跑多步规划、搜索、提取、合成循环，返回结构化研究简报。这原本需要 50-100 行 agent 代码，现在是一次 API 调用。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Tavily 端点目录（2026 年 6 月）</h2>

<p class="text-gray-700 leading-relaxed my-4">Tavily 暴露六个端点，每个为 agent 信息收集循环的特定阶段设计。自 2026 年 2 月 Research GA 以来端点目录稳定，新端点大约每季度发布一次。</p>

<table class="min-w-full border border-gray-300 my-4 text-sm">
<thead><tr class="bg-gray-100"><th class="border border-gray-300 px-3 py-2 text-left">端点</th><th class="border border-gray-300 px-3 py-2 text-left">用途</th><th class="border border-gray-300 px-3 py-2 text-left">免费层配额</th><th class="border border-gray-300 px-3 py-2 text-left">付费单价</th></tr></thead>
<tbody><tr><td class="border border-gray-300 px-3 py-2"><strong>Search</strong></td><td class="border border-gray-300 px-3 py-2">实时网页搜索 + AI 摘要</td><td class="border border-gray-300 px-3 py-2">1,000/月</td><td class="border border-gray-300 px-3 py-2">$0.008</td></tr>
<tr><td class="border border-gray-300 px-3 py-2"><strong>Extract</strong></td><td class="border border-gray-300 px-3 py-2">从已知 URL 拉取干净 markdown</td><td class="border border-gray-300 px-3 py-2">1,000/月</td><td class="border border-gray-300 px-3 py-2">$0.002/页</td></tr>
<tr><td class="border border-gray-300 px-3 py-2"><strong>Crawl</strong></td><td class="border border-gray-300 px-3 py-2">从根 URL BFS，返回所有可达页面</td><td class="border border-gray-300 px-3 py-2">500 页/月</td><td class="border border-gray-300 px-3 py-2">$0.001/页</td></tr>
<tr><td class="border border-gray-300 px-3 py-2"><strong>Map</strong></td><td class="border border-gray-300 px-3 py-2">域名级 sitemap 发现</td><td class="border border-gray-300 px-3 py-2">500/月</td><td class="border border-gray-300 px-3 py-2">$0.001/页</td></tr>
<tr><td class="border border-gray-300 px-3 py-2"><strong>Research</strong></td><td class="border border-gray-300 px-3 py-2">多步搜索+合成，返回研究简报</td><td class="border border-gray-300 px-3 py-2">50/月</td><td class="border border-gray-300 px-3 py-2">$0.04</td></tr>
<tr><td class="border border-gray-300 px-3 py-2"><strong>AI Extraction</strong></td><td class="border border-gray-300 px-3 py-2">按 JSON schema 结构化提取</td><td class="border border-gray-300 px-3 py-2">1,000/月</td><td class="border border-gray-300 px-3 py-2">$0.005</td></tr>
</tbody></table>

<p class="text-gray-700 leading-relaxed my-4">Search 和 Extract 的分离是刻意的。Search 用于发现（你不知道哪个 URL 有答案）；Extract 用于摄取（你已有 URL，需要内容）。大多数 agent 工作流调用 Search 找候选 URL，再调用 Extract 摄取 top 3，然后循环。</p>

<p class="text-gray-700 leading-relaxed my-4">Crawl 是需要摄取整个域名时的更便宜替代——用于从文档站构建知识库。Map 介于 Search 和 Crawl 之间：它给出域名的 URL 拓扑但不取内容，这是构建规划 agent 决定读取哪些子页面时的正确形态。</p>

<p class="text-gray-700 leading-relaxed my-4">Research 是最贵的端点，但单价误导：单次 Research 调用替代了 5-10 次 Search 加 2-3 次 Extract 加 1 次合成 LLM。对多步研究工作流，Research 是通向结构化答案的最便宜路径。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Tavily 价格：credits 在实践中如何工作</h2>

<p class="text-gray-700 leading-relaxed my-4">Tavily 用 credit 系统，每个端点每次调用消耗不同数量的 credits。免费层 1,000 credits/月，听起来不多，但 Search 1 credit/次、Extract 1 credit/页、Crawl 1 credit/页、Research 5 credit/次。</p>

<p class="text-gray-700 leading-relaxed my-4">对 solo developer 跑每日研究 agent（每天 20 次 Search + 3 次 Extract），月度 credit 消耗约 690——免费层足够。小团队三个生产 agent，每个每天 200 次 Search 加每周每个 agent ~5,000 页 Crawl，月度消耗约 50,000 credits，付费层约 $80。</p>

<p class="text-gray-700 leading-relaxed my-4">付费层级（2026 年 6 月）：</p>

<table class="min-w-full border border-gray-300 my-4 text-sm">
<thead><tr class="bg-gray-100"><th class="border border-gray-300 px-3 py-2 text-left">计划</th><th class="border border-gray-300 px-3 py-2 text-left">月费</th><th class="border border-gray-300 px-3 py-2 text-left">包含 credits</th><th class="border border-gray-300 px-3 py-2 text-left">超额</th></tr></thead>
<tbody><tr><td class="border border-gray-300 px-3 py-2">Free</td><td class="border border-gray-300 px-3 py-2">$0</td><td class="border border-gray-300 px-3 py-2">1,000</td><td class="border border-gray-300 px-3 py-2">无——超额返 429</td></tr>
<tr><td class="border border-gray-300 px-3 py-2">Project</td><td class="border border-gray-300 px-3 py-2">$30</td><td class="border border-gray-300 px-3 py-2">4,000</td><td class="border border-gray-300 px-3 py-2">$0.008/credit</td></tr>
<tr><td class="border border-gray-300 px-3 py-2">Growth</td><td class="border border-gray-300 px-3 py-2">$200</td><td class="border border-gray-300 px-3 py-2">40,000</td><td class="border border-gray-300 px-3 py-2">$0.006/credit</td></tr>
<tr><td class="border border-gray-300 px-3 py-2">Pro</td><td class="border border-gray-300 px-3 py-2">$1,000</td><td class="border border-gray-300 px-3 py-2">250,000</td><td class="border border-gray-300 px-3 py-2">$0.005/credit</td></tr>
<tr><td class="border border-gray-300 px-3 py-2">Enterprise</td><td class="border border-gray-300 px-3 py-2">合同制</td><td class="border border-gray-300 px-3 py-2">合同制</td><td class="border border-gray-300 px-3 py-2">合同制</td></tr>
</tbody></table>

<p class="text-gray-700 leading-relaxed my-4">Project 是大多数生产 agent 的起点。Growth 是量价折扣开始重要的拐点——月耗超过 40,000 credits 后边际价降至 $0.006，比 Developer 超额便宜 25%。月耗超过 250,000 credits 后，Pro 层的 $0.005 边际价对摄取大型文档站的工作流才有意义。</p>

<p class="text-gray-700 leading-relaxed my-4">月耗超过 100 万 credits 的工作流，Enterprise 包含专属搜索索引、自定义速率上限、延迟 SLA。公开案例客户没披露实际费率，Enterprise 大约 $5,000-15,000/月，取决于 SLA 和地理搜索覆盖要求。</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Search 端点实际返回什么</h2>

<p class="text-gray-700 leading-relaxed my-4">Search 是大多数开发者的起点，响应形态是大多数人抄进 agent 代码却没读的内容。典型 Search 响应查询 "OpenAI moderation API pricing 2026" 看起来是：</p>

<pre class="bg-gray-900 text-gray-100 p-4 rounded my-4 overflow-x-auto"><code>&#123;
  "query": "OpenAI moderation API pricing 2026",
