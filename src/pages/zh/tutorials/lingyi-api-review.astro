---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'lingyi-api-review';
const date = '2026-06-14';
const locale = 'zh';

const zhTitle = '零一万物 Yi API 测评 2026：¥0.99/百万 token 的超低价智能路由';
const zhDescription = '完整测评零一万物 Yi API：Yi-Lightning 智能路由 ¥0.99/百万总 token、DeepSeek-V3/Qwen3.5 自动路由、OpenAI 兼容 API、国内直连、优缺点与竞品对比。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": zhTitle,
  "description": zhDescription,
  "datePublished": date,
  "dateModified": date,
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://apirank.vip/zh/tutorials/${slug}` }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip" },
    { "@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials" },
    { "@type": "ListItem", "position": 3, "name": zhTitle, "item": `https://apirank.vip/zh/tutorials/${slug}` }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Yi-Lightning 能让我选择使用哪个底层模型吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "不能。智能路由系统会自动为每次请求选择 DeepSeek-V3、Qwen3.5-30B-A3B 或 Yi-Lightning 之一。没有参数可以固定到特定模型。如果您需要确定性模型选择，请直接使用 DeepSeek 或使用 FreeModel 这类聚合器。" }
    },
    {
      "@type": "Question",
      "name": "「合并计费」在实践中意味着什么？",
      "acceptedAnswer": { "@type": "Answer", "text": "零一万物按总 token 计费——输入 token 加输出 token 的总和。提示和补全没有不同的费率。每百万总 token 统一 ¥0.99。这简化了成本追踪，但无法分别优化提示和生成的成本。" }
    },
    {
      "@type": "Question",
      "name": "零一万物 Yi 在国内能用吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "可以。零一万物是拥有完整国内合规资质的中国公司：ICP 备案、大陆手机号注册、支付宝/微信支付、无需代理直连。API 也支持全球访问，但主要针对中国用户优化。" }
    },
    {
      "@type": "Question",
      "name": "Yi-Lightning 相比直接调用 DeepSeek-V3 速度如何？",
      "acceptedAnswer": { "@type": "Answer", "text": "零一万物不公布每个模型的延迟基准。由于路由在推理前增加了一个决策层，预计首 token 时间比直接调用 DeepSeek-V3 略高。大多数用户报告的典型聊天查询响应时间在 2 秒以内。" }
    },
    {
      "@type": "Question",
      "name": "Yi-Lightning 是否适合生产环境？",
      "acceptedAnswer": { "@type": "Answer", "text": "适合对模型选择非确定性可接受的工作负载。对于需要特定模型行为的场景（如数学题始终使用 DeepSeek-V3），路由抽象是一个隐患。如需固定模型访问，可考虑 FreeModel。" }
    },
    {
      "@type": "Question",
      "name": "零一万物 Yi 和 FreeModel 相比如何？",
      "acceptedAnswer": { "@type": "Answer", "text": "零一万物 Yi 是单一提供商的智能路由端点，¥0.99/百万。FreeModel（freemodel.dev/invite/FRE-7a3b6220）是一个多提供商聚合器，将 OpenAI、Anthropic、DeepSeek、Yi 等捆绑在一个 API 密钥后，提供确定性模型选择和国内直连。" }
    }
  ]
};
---

<BaseLayout
  title={zhTitle + ' | APIRank'}
  description={zhDescription}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <link rel="alternate" hreflang="en-US" href={enCanonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={enCanonicalUrl} />

  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/zh" class="hover:text-blue-600">首页</a>
        <span>›</span>
        <a href="/zh/tutorials" class="hover:text-blue-600">教程</a>
        <span>›</span>
        <span class="text-gray-900 font-medium">零一万物 Yi API 测评</span>
      </nav>
    </div>
  </div>

  <article class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">

          <header>
            <h1 class="text-3xl font-bold text-gray-900 mb-4">零一万物 Yi API 测评 2026：¥0.99/百万 token 的超低价智能路由</h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
              <time datetime="2026-06-14">2026 年 6 月 14 日</time>
              <span>•</span>
              <span>API 测评</span>
              <span>•</span>
              <span>~10 分钟阅读</span>
            </div>
            <p class="text-lg text-gray-600 leading-relaxed">
              零一万物由李开复博士创立，以明确的理念进入 AI API 市场：中国开发者需要兼容 OpenAI 的 API，但要以中国用户友好的价格。Yi-Lightning 应运而生——一个统一的 API 端点，定价仅 ¥0.99/百万总 token，通过智能路由层为每次请求自动选择最佳模型（DeepSeek-V3、Qwen3.5 或 Yi-Lightning）。本测评覆盖 API 平台、定价、智能路由机制及竞品对比。
            </p>
          </header>

          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-r">
            <p class="text-blue-800 text-sm">
              <strong>TL;DR：</strong>零一万物 Yi-Lightning 提供单一智能路由 API 端点，¥0.99/百万总 token——每次请求自动在 DeepSeek-V3、Qwen3.5-30B-A3B 和 Yi-Lightning 之间选择。输入+输出合并计费，统一费率。100% OpenAI 兼容 API，支持流式、JSON 模式和函数调用。国内直连，支持支付宝/微信支付。仅 2 个模型（Yi-Lightning + Yi-Vision-v2），无法固定选择模型，无初始免费额度。最适合注重成本的中国团队，无需管理模型选择即可获得前沿级别回复。
            </p>
          </div>

          <div class="prose prose-lg max-w-none">
            <h2>引言：零一万物的独特定位</h2>
            <p>零一万物由李开复博士创立（前 Google 中国总裁、微软亚洲研究院副院长），以明确的理念进入 AI API 市场：中国开发者需要兼容 OpenAI 的 API，但要以中国用户友好的价格。Yi-Lightning 应运而生——一个统一的 API 端点，定价仅 ¥0.99/百万总 token，通过智能路由层为每次请求自动选择最佳模型。</p>
            <p>与大多数暴露单个模型检查点的提供商不同，零一万物的 Yi-Lightning 端点使用智能路由系统。每次请求都会经过分析，分发到三个底层模型之一：<strong>DeepSeek-V3</strong>、<strong>Qwen3.5-30B-A3B</strong> 或 <strong>Yi-Lightning（零一万物自研模型）</strong>。用户永远不会知道具体选择了哪个模型——他们只以 ¥0.99/百万总 token 的固定价格获得回复。</p>
            <p>这种"模型即服务"的抽象是零一万物最大的差异化优势，也是最具争议的设计选择。对于关心"我到底在调用什么模型？"的团队来说，黑盒路由让人不安。对于关心"回复质量够不够好？价格够不够低？"的团队来说，这种抽象是解放。</p>

            <h2>零一万物 Yi API 提供什么</h2>
            <p>零一万物的 API 平台（<code>platform.lingyiwanwu.com</code>）目前提供两个模型：</p>
            <table>
              <thead>
                <tr><th>模型</th><th>适用场景</th><th>价格（总 token）</th></tr>
              </thead>
              <tbody>
                <tr><td><strong>Yi-Lightning</strong></td><td>通用对话、推理、编程——智能路由至 DeepSeek-V3 / Qwen3.5 / Yi-Lightning</td><td>¥0.99/百万总 token</td></tr>
                <tr><td><strong>Yi-Vision-v2</strong></td><td>视觉理解——路由至 Qwen2.5-VL-72B 或 Yi-Vision-V2</td><td>¥6.00/百万总 token</td></tr>
              </tbody>
            </table>
            <p>两个模型均采用 <strong>输入+输出合并计费</strong>——没有独立的输入和输出费率。无论 token 是用于提示还是生成，您每使用一百万个 token 只需支付 ¥0.99。</p>
            <p>智能路由机制是关键创新。当您向 Yi-Lightning 发送请求时，零一万物的路由层会评估请求特征（领域、复杂度、语言、token 预算），并在以下模型中做出选择：</p>
            <ul>
              <li><strong>DeepSeek-V3</strong> —— 最适合复杂推理、数学和代码生成</li>
              <li><strong>Qwen3.5-30B-A3B</strong> —— 最适合中文任务和通用知识</li>
              <li><strong>Yi-Lightning（零一万物专有）</strong> —— 最适合双语对话和均衡性能</li>
            </ul>
            <p>路由是非确定性的——您无法固定到某个特定底层模型。这既是特性（简化决策），也是限制（无法控制模型）。</p>

            <h2>API 接口：标准 OpenAI 兼容端点</h2>
            <p>Yi API 100% 兼容 OpenAI。基础 URL 为 <code>https://api.lingyiwanwu.com/v1</code>，<code>/v1/chat/completions</code> 端点接受标准的 OpenAI 请求体。支持流式传输、JSON 模式和函数调用。</p>
            <pre><code class="language-python">from openai import OpenAI

client = OpenAI(
    base_url="https://api.lingyiwanwu.com/v1",
    api_key="YOUR_YI_API_KEY"
)

completion = client.chat.completions.create(
    model="yi-lightning",
    messages=[&#123;"role": "user", "content": "用三句话解释智能路由的概念。"&#125;],
    max_tokens=512
)

print(completion.choices[0].message.content)</code></pre>
            <p>对于已在使用 OpenAI Python SDK 的团队，迁移只需一行改动：替换 <code>base_url</code> 和 <code>api_key</code>。无需重写 SDK，无需重构请求体。</p>
            <p>API 还支持 <strong>流式传输</strong>（<code>stream=True</code>）、<strong>函数调用</strong>以及 <strong>JSON 模式</strong>（<code>response_format=&#123;"type": "json_object"&#125;</code>）。</p>

            <h2>定价：¥0.99/百万的故事</h2>
            <p>¥0.99 每百万总 token 的价格使 Yi-Lightning 成为中国最便宜的 API 产品之一。与其他提供商的对比如下：</p>
            <table>
              <thead>
                <tr><th>提供商</th><th>等效模型</th><th>每百万 token 价格</th><th>计费模式</th></tr>
              </thead>
              <tbody>
                <tr><td><strong>零一万物 Yi-Lightning</strong></td><td>智能路由（DeepSeek-V3 / Qwen3.5 / Yi）</td><td>¥0.99</td><td>输入+输出合并</td></tr>
                <tr><td><strong>DeepSeek（官方）</strong></td><td>DeepSeek-V3</td><td>~¥1.00-¥2.00</td><td>输入/输出分离</td></tr>
                <tr><td><strong>SiliconFlow</strong></td><td>托管的 DeepSeek-V3</td><td>~¥1.00-¥4.00</td><td>输入/输出分离</td></tr>
                <tr><td><strong>腾讯混元</strong></td><td>大模型</td><td>~¥0.80-¥3.00</td><td>输入/输出分离</td></tr>
                <tr><td><strong>OpenAI GPT-4o</strong></td><td>GPT-4o（美元）</td><td>~$2.50/¥18+</td><td>输入/输出分离</td></tr>
              </tbody>
            </table>
            <p>¥0.99 的价格对于 bundle 的内容来说非常惊人。您可以访问 DeepSeek-V3——推理和编程领域最强的开放权重模型之一——实际费率比直接通过官方 API 调用 DeepSeek 还低。对于中文任务，路由到 Qwen3.5，对于双语对话则使用 Yi 自家模型，使端点在各用例中都具有通用性。</p>
            <p><strong>Yi-Vision-v2</strong> 的 ¥6.00/百万总 token 价格较高，但在中国视觉 API 市场中仍具有竞争力——同类产品价格从 ¥4 到 ¥20 每百万 token 不等。</p>

            <h2>可用性与入门</h2>
            <p>零一万物是一家拥有完整国内合规资质的中国公司：</p>
            <ul>
              <li>✅ ICP 备案 — 在中国监管框架内合法运营</li>
              <li>✅ 手机号注册 — 支持中国大陆手机号</li>
              <li>✅ 支付宝/微信支付 — 支持国内支付方式</li>
              <li>✅ 直连 — 中国大陆无需代理</li>
              <li>❌ 无初始免费额度 — 必须先充值才能调用 API</li>
              <li>✅ 免费速率限制 — 无需付费即可获得有限的 RPM/TPM</li>
            </ul>
            <p>注册流程简单：访问 <code>platform.lingyiwanwu.com</code>，使用手机号注册，然后充值。首次 API 调用需要先充值——这点与提供 ¥5-¥20 新用户赠额的竞争对手不同。</p>

            <h2>优点与缺点</h2>
            <p><strong>优点</strong></p>
            <ul>
              <li>✅ ¥0.99/百万总 token — 中国前沿级别回复中最便宜的 API 价格之一</li>
              <li>✅ 智能路由 — 自动为每次请求选择 DeepSeek-V3、Qwen3.5 或 Yi-Lightning</li>
              <li>✅ 100% OpenAI 兼容 — 零 SDK 迁移成本</li>
              <li>✅ 合并计费 — 无需分别追踪输入和输出，统一费率</li>
              <li>✅ 国内可用 — ICP 备案、支付宝/微信支付、大陆直连</li>
              <li>✅ 李开复博士创立 — 强大的研发背景和开源贡献</li>
              <li>✅ 支持流式、函数调用、JSON 模式</li>
            </ul>
            <p><strong>缺点</strong></p>
            <ul>
              <li>❌ 仅 2 个 API 模型 — Yi-Lightning + Yi-Vision-v2，无法直接访问 Llama、Qwen 或其他开源模型</li>
              <li>❌ 智能路由非确定性 — 无法固定到 DeepSeek-V3 或控制哪个模型回答</li>
              <li>❌ 合并计费不透明 — 无法判断支付 ¥0.99 是在使用便宜的 DeepSeek-V3 推理还是昂贵的 Yi-Lightning 计算</li>
              <li>❌ 无初始免费额度 — 首次调用必须充值</li>
              <li>❌ 英文支持较弱 — 文档和社区主要以中文为主</li>
              <li>❌ 无模型级 SLA — 路由导致单个模型的延迟和质量存在差异</li>
            </ul>

            <h2>用例推荐</h2>
            <table>
              <thead>
                <tr><th>使用场景</th><th>推荐模型</th><th>原因</th></tr>
              </thead>
              <tbody>
                <tr><td>通用双语对话</td><td>Yi-Lightning</td><td>¥0.99/百万，路由自动选最佳模型</td></tr>
                <tr><td>中文问答</td><td>Yi-Lightning</td><td>路由至 Qwen3.5-30B-A3B 处理中文任务</td></tr>
                <tr><td>复杂推理/数学</td><td>Yi-Lightning</td><td>路由至 DeepSeek-V3 处理难题</td></tr>
                <tr><td>图像理解</td><td>Yi-Vision-v2</td><td>¥6.00/百万用于视觉任务</td></tr>
                <tr><td>成本敏感的大批量处理</td><td>Yi-Lightning</td><td>固定 ¥0.99/百万费率，无意外定价</td></tr>
                <tr><td>需要模型控制的生产系统</td><td>❌ 不推荐</td><td>非确定性路由带来可靠性问题</td></tr>
              </tbody>
            </table>

            <h2>对比：零一万物 Yi vs 主要竞争对手</h2>
            <table>
              <thead>
                <tr><th>提供商</th><th>最佳场景</th><th>国内访问</th><th>计费</th><th>模型数量</th></tr>
              </thead>
              <tbody>
                <tr><td><strong>零一万物 Yi</strong></td><td>智能路由，¥0.99 统一费率</td><td>✅ 直连</td><td>合并</td><td>2（路由）</td></tr>
                <tr><td><strong>DeepSeek</strong></td><td>直接 DeepSeek-V3/R1 访问</td><td>✅ 直连</td><td>分离</td><td>3</td></tr>
                <tr><td><strong>SiliconFlow</strong></td><td>开源模型多样性</td><td>✅ 直连</td><td>分离</td><td>100+</td></tr>
                <tr><td><strong>腾讯混元</strong></td><td>企业级中文大模型</td><td>✅ 直连</td><td>分离</td><td>~5</td></tr>
                <tr><td><strong>Novita AI</strong></td><td>开源+专有混合</td><td>✅ 直连</td><td>分离</td><td>200+</td></tr>
                <tr><td><strong>FreeModel</strong></td><td>多提供商聚合</td><td>✅ 直连</td><td>按模型</td><td>50+</td></tr>
              </tbody>
            </table>

            <h2>常见问题 FAQ</h2>
            <p><strong>问：Yi-Lightning 能让我选择使用哪个底层模型吗？</strong></p>
            <p>答：不能。智能路由系统会自动为每次请求选择 DeepSeek-V3、Qwen3.5-30B-A3B 或 Yi-Lightning 之一。没有参数可以固定到特定模型。如果您需要确定性模型选择，请直接使用 DeepSeek 或使用 FreeModel 这类聚合器。</p>
            <p><strong>问：「合并计费」在实践中意味着什么？</strong></p>
            <p>答：零一万物按总 token 计费——输入 token 加输出 token 的总和。提示和补全没有不同的费率。每百万总 token 统一 ¥0.99。这简化了成本追踪，但无法分别优化提示和生成的成本。</p>
            <p><strong>问：零一万物 Yi 在国内能用吗？</strong></p>
            <p>答：可以。零一万物是拥有完整国内合规资质的中国公司：ICP 备案、大陆手机号注册、支付宝/微信支付、无需代理直连。</p>
            <p><strong>问：Yi-Lightning 相比直接调用 DeepSeek-V3 速度如何？</strong></p>
            <p>答：零一万物不公布每个模型的延迟基准。由于路由在推理前增加了一个决策层，预计首 token 时间比直接调用 DeepSeek-V3 略高。大多数用户报告的响应时间在 2 秒以内。</p>
