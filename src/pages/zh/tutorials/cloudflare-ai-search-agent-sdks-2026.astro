const zhTitle = 'Cloudflare AI Search 2026：三大 Agent 框架集成横向评测';
const zhDescription = 'Cloudflare AI Search 2026-07-30 一次性发布 Vercel AI SDK / LangChain / Agents SDK 三大框架集成：retriever 类型、鉴权方式、混合检索、10 行代码开箱即用 RAG。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

