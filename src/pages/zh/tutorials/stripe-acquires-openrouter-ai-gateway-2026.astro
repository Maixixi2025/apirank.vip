const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'Stripe 真的收购了 OpenRouter 吗？', acceptedAnswer: { '@type': 'Answer', text: '是的。彭博社 2026 年 8 月 16 日报道 Stripe 已完成收购 OpenRouter 的协议，交易金额超过 70 亿美元；TechCrunch、Fortune、SiliconANGLE 与 Seeking Alpha 当天同步确认，The Information 8 月 17 日报道交易以 70 亿+ 美元达成。华尔街日报 7 月 23 日首次报道双方进入洽谈。Stripe 发言人拒绝置评，称公司不对猜想与传闻发表评论。' } },
  { '@type': 'Question', name: 'Stripe 为什么想要 OpenRouter？', acceptedAnswer: { '@type': 'Answer', text: 'OpenRouter 是最大的 AI 模型网关与市场：开发者用一个 API Key 即可调用 400+ 模型并统一计费，防止被任何单一模型厂商锁定。AI 推理支出正成为重要的支付品类，Stripe 收购 OpenRouter 就能占据路由与结算层，把它和自己的支付、计费产品捆绑，掌握 AI 用量这一未来支付主赛道。' } },
  { '@type': 'Question', name: 'Stripe 花了多少钱收购 OpenRouter？', acceptedAnswer: { '@type': 'Answer', text: '超过 70 亿美元（彭博、TechCrunch、Fortune、The Information 均确认）。对比背景：OpenRouter 2026 年 5 月完成 1.13 亿美元 B 轮融资，估值约 13 亿美元（投资方含红杉、a16z、Menlo Ventures、Alphabet Capital G）。本次退出价约为该估值的 5 倍，说明市场给模型网关层给出了显著溢价。' } },
