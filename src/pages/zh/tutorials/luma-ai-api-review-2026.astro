const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首页', item: 'https://apirank.vip/zh' }, { '@type': 'ListItem', position: 2, name: '教程', item: 'https://apirank.vip/zh/tutorials' }, { '@type': 'ListItem', position: 3, name: zhTitle, item: canonicalUrl }] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'Luma AI 有公开 API 吗？', acceptedAnswer: { '@type': 'Answer', text: "有——Luma Agents API（docs.agents.lumalabs.ai）是单一异步 REST 接口。POST /v1/generations 提交，GET /v1/generations/{id} 轮询，state 达到 completed 后从预签名 URL 下载。" } },
  { '@type': 'Question', name: 'Luma API 有免费层吗？', acceptedAnswer: { '@type': 'Answer', text: "无永久免费 API 层。新用户在平台有少量一次性积分，但持续使用需要 Plus 方案 $30/月（10,000 积分）。" } },
  { '@type': 'Question', name: '2026 年 Luma 最好的视频模型是什么？', acceptedAnswer: { '@type': 'Answer', text: "Ray 3.2 是旗舰：1080p 输出、单片段最多 16 关键帧、V2V 最长 20 秒，支持原生 HDR 生成与 16-bit EXR 导出用于后期制作。" } },
  { '@type': 'Question', name: 'Luma 能用已有视频生成视频吗？', acceptedAnswer: { '@type': 'Answer', text: "能——Ray 3.2 的 V2V（视频到视频）最长 20 秒，可在保持运动与内容的同时重风格、延伸或重构现有片段。" } },
  { '@type': 'Question', name: 'Luma 定价对比 Runway 如何？', acceptedAnswer: { '@type': 'Answer', text: "Luma 是订阅 + 积分（Plus $30/月，10,000 积分）；Runway 是 $12 起预付积分包。按片段，Luma 5 秒 720p 约 100 积分（Pro 下约 $0.30），Runway Gen-4 Turbo 5 秒约 $0.50。" } },
  { '@type': 'Question', name: 'Luma API 能从中国用吗？', acceptedAnswer: { '@type': 'Answer', text: "只能通过稳定海外代理。Luma 无中国大陆直连端点或官方中国访问计划，中国生产环境需要代理基础设施。" } },
  { '@type': 'Question', name: 'Luma 聚合了哪些第三方模型？', acceptedAnswer: { '@type': 'Answer', text: "Veo 3.1、Kling 3.0 / Kling Omni / Kling 2.6、Seedance 2.0、MiniMax H3、Flux 3、GPT Image 2、Nano Banana、Seedream，以及 ElevenLabs v3 TTS 与 SFX 音频。" } },
