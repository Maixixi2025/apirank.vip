  "mainEntity": [
    {
      "@type": "Question",
      "name": "OpenRouter MCP 服务器免费吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "4 个只读 tool（model_search、model_info、pricing_compare、provider_routing）免费。chat_completion tool 用你的 PAYG 余额按标准费率加 5.5% 平台费计费。" }
    },
    {
      "@type": "Question",
      "name": "Claude Desktop（不是 Code）能用吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "能。Claude Desktop 从 1.5 起支持远程 MCP 服务器。配置在 macOS 的 ~/Library/Application Support/Claude/claude_desktop_config.json 或 Windows/Linux 等价路径。" }
    },
    {
      "@type": "Question",
      "name": "免费 OpenRouter 账号能用 MCP 服务器吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "可以安装并探索 4 个只读 tool。chat_completion tool 需要 PAYG 额度（最少 $5 充值）。" }
    },
    {
      "@type": "Question",
      "name": "这和 OpenRouter REST API 有什么区别？",
      "acceptedAnswer": { "@type": "Answer", "text": "REST API 暴露 chat completion 和额度管理。MCP 服务器暴露目录发现和路由智能。两者互补：大多数工作流用 MCP tool 浏览和比较，生产环境流式调用降级到 REST。" }
    },
    {
      "@type": "Question",
      "name": "MCP 服务器走厂商直连端点还是总走 OpenRouter 基础设施？",
      "acceptedAnswer": { "@type": "Answer", "text": "总是走 OpenRouter 基础设施。如果需要厂商直连路由（为了更低延迟或合规原因），用 provider_routing tool 发现哪些厂商服务这个模型，然后直连它们的 API。" }
    },
    {
      "@type": "Question",
      "name": "MCP 服务器支持 ZDR（零数据留存）吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "MCP tool 本身不存任何数据。chat completion 时，你可以在请求体里传 zdr: true，服务器把它转发给支持 ZDR 的厂商。" }
    }
