---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'claude-project-fetch-2026';
const date = '2026-06-23';
const locale = 'zh';

const zhTitle = 'Claude Project Fetch 2026：自主 API 任务 20 倍提速';
const zhDescription = 'Anthropic Project Fetch Phase Two：Claude Opus 4.7 自主编写代码、连接硬件传感器，完成任务比人类快19-38倍。Claude Code API 实战指南。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": zhTitle,
  "description": zhDescription,
  "datePublished": date,
  "dateModified": date,
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://apirank.vip/zh/tutorials/${slug}` }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://apirank.vip" },
    { "@type": "ListItem", "position": 2, "name": "教程", "item": "https://apirank.vip/zh/tutorials" },
    { "@type": "ListItem", "position": 3, "name": zhTitle, "item": `https://apirank.vip/zh/tutorials/${slug}` }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Project Fetch Phase Two 可以通过常规 API 使用吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "可以。自主任务能力通过 Claude Code CLI 实现，使用 Claude Opus 4.7 或更新模型。API 接口不变，自主性来自 Claude Code 的代理架构。" }
    },
    {
      "@type": "Question",
      "name": "Opus 4.7、4.8 和 Fable 5 有什么区别？",
      "acceptedAnswer": { "@type": "Answer", "text": "Opus 4.7（4月16日）引入新 tokenizer 和自主能力。Opus 4.8（5月28日）是微调更新。Fable 5（6月9日）是当前前沿模型，$10/$50 每百万 token。Project Fetch 使用 Opus 4.7，能力向前兼容。" }
    },
    {
      "@type": "Question",
      "name": "国内能使用 Claude 自主任务能力吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "Anthropic 需美国账户且有出口管制限制。国内团队可使用 FreeModel 等提供多厂商路由的聚合平台。" }
    },
    {
      "@type": "Question",
      "name": "一次自主任务大概需要多少费用？",
      "acceptedAnswer": { "@type": "Answer", "text": "以 $5/$25 每百万 token 计，一次生成约 10K token 的多步骤任务成本约 $0.25-0.50。即使考虑 30% tokenizer 开销，仍比雇 3-6 名工程师便宜几个数量级。" }
    },
    {
      "@type": "Question",
      "name": "Claude Code 能用于非 Anthropic 模型吗？",
      "acceptedAnswer": { "@type": "Answer", "text": "Claude Code 专为 Anthropic 模型设计。如需多厂商自主工作流，可考虑 FreeModel 等提供统一 API 的聚合平台。" }
    }
  ]
};
---

<BaseLayout
  title={zhTitle + ' | APIRank'}
  description={zhDescription}
  canonicalUrl={canonicalUrl}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
  <link rel="alternate" hreflang="en-US" href={enCanonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={enCanonicalUrl} />

  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-blue-600">首页</a>
        <span>›</span>
        <a href="/zh/tutorials" class="hover:text-blue-600">教程</a>
        <span>›</span>
        <span class="text-gray-900 font-medium">Claude Project Fetch 2026</span>
      </nav>
    </div>
  </div>

  <article class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">

          <header>
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Claude Opus 4.7 Project Fetch：自主 API 任务提速 20 倍</h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
              <time datetime="2026-06-23">2026年6月23日</time>
              <span>•</span>
              <span>测评</span>
              <span>•</span>
              <span>阅读约 10 分钟</span>
            </div>
            <p class="text-lg text-gray-600 leading-relaxed">
              Anthropic Frontier Red Team 于 2026 年 6 月 18 日发布 Project Fetch Phase Two 实验结果——Claude Opus 4.7 通过 Claude Code 全自主完成机器人软件开发任务。4 个任务仅用 9 分 35 秒，而最快的人类团队需要 181 分钟——提速 18.9 倍。这是首个包含真实硬件交互的 AI 自主开发基准测试，Anthropic 称之为"物理自主 AI 的早期时代"。
            </p>
          </header>

          <!-- TL;DR -->
          <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
            <p class="text-sm font-semibold text-blue-800 mb-1">核心要点</p>
            <p class="text-sm text-blue-700 leading-relaxed">
              <strong>Project Fetch Phase Two：</strong>Claude Opus 4.7 完成含硬件交互的软件开发任务，比人类团队快 19-38 倍——4 个任务 9 分 35 秒 vs 181 分钟。<strong>API 开发者关注：</strong>Claude Code + Opus 4.7 的自主任务执行已可投入生产。<strong>定价：</strong>$5/$25 每百万 token。国内团队可通过 <a href="https://freemodel.dev/invite/FRE-7a3b6220"class="text-blue-600 underline" target="_blank" rel="sponsored noopener">FreeModel</a> 获得多厂商路由的 OpenAI 兼容访问。
            </p>
          </div>

          <!-- What Is Project Fetch -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Project Fetch Phase Two 是什么</h2>
            <p class="text-gray-700 leading-relaxed mb-4">
              2026 年 6 月 18 日，Anthropic Frontier Red Team 发表 Project Fetch Phase Two——对 2025 年 8 月实验的升级。原实验中人类团队使用 Claude 辅助操作四足机器人（"机器狗"），而这次 <strong>Claude Opus 4.7 通过 Claude Code 完全自主运行</strong>。
            </p>
            <p class="text-gray-700 leading-relaxed mb-4">
              人类研究员仅负责：插电源、输入初始提示、批准命令和任务切换。代码编写、硬件连接、传感器集成、调试全部由 Claude 完成。
            </p>
          </section>

          <!-- Benchmark -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">基准测试数据</h2>
            <table class="w-full border-collapse mb-6">
              <thead>
                <tr class="bg-gray-100">
                  <th class="border p-2 text-left text-sm font-semibold">指标</th>
                  <th class="border p-2 text-right text-sm font-semibold">Opus 4.7</th>
                  <th class="border p-2 text-right text-sm font-semibold">人类+Claude</th>
                  <th class="border p-2 text-right text-sm font-semibold">纯人类</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b bg-blue-50"><td class="border p-2 text-sm font-semibold">4 个可比任务</td><td class="border p-2 text-sm text-right font-semibold">9 分 35 秒</td><td class="border p-2 text-sm text-right">181 分钟</td><td class="border p-2 text-sm text-right">361 分钟</td></tr>
                <tr class="border-b"><td class="border p-2 text-sm">比纯人类快</td><td class="border p-2 text-sm text-right font-semibold">37.7x</td><td class="border p-2 text-sm text-right">—</td><td class="border p-2 text-sm text-right">1x</td></tr>
                <tr class="border-b bg-gray-50"><td class="border p-2 text-sm">比人类+Claude 快</td><td class="border p-2 text-sm text-right font-semibold">18.9x</td><td class="border p-2 text-sm text-right">1x</td><td class="border p-2 text-sm text-right">—</td></tr>
                <tr class="border-b"><td class="border p-2 text-sm">全部 5 个任务（平均）</td><td class="border p-2 text-sm text-right font-semibold">12 分 7 秒</td><td class="border p-2 text-sm text-right">264 分钟</td><td class="border p-2 text-sm text-right">—</td></tr>
                <tr class="bg-gray-50"><td class="border p-2 text-sm">编写代码行数</td><td class="border p-2 text-sm text-right font-semibold">1,045 行</td><td class="border p-2 text-sm text-right">10,309 行</td><td class="border p-2 text-sm text-right">1,136 行</td></tr>
              </tbody>
            </table>
          </section>

          <!-- Code Example -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">API 代码示例</h2>
            <pre><code class="language-python">import anthropic

client = anthropic.Anthropic(api_key="YOUR_API_KEY")

# Claude 可自主处理多步骤任务
response = client.messages.create(
    model="claude-opus-4-7",
    max_tokens=64000,
    messages=[
        &#123;"role": "user", "content": "写一个 Python 程序，连接 USB 摄像头，以 30fps 采集画面，用 OpenCV 检测红色物体，并支持键盘控制。"&#125;
    ]
)

print(response.content[0].text)</code></pre>
          </section>

          <!-- Pricing -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">定价对比</h2>
            <table class="w-full border-collapse mb-6">
              <thead>
                <tr class="bg-gray-100">
                  <th class="border p-2 text-left text-sm font-semibold">模型</th>
                  <th class="border p-2 text-right text-sm font-semibold">输入（每百万）</th>
                  <th class="border p-2 text-right text-sm font-semibold">输出（每百万）</th>
                  <th class="border p-2 text-right text-sm font-semibold">上下文</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b bg-blue-50"><td class="border p-2 text-sm font-semibold">Claude Opus 4.7</td><td class="border p-2 text-sm text-right font-semibold">$5.00</td><td class="border p-2 text-sm text-right font-semibold">$25.00</td><td class="border p-2 text-sm text-right">1M</td></tr>
                <tr class="border-b"><td class="border p-2 text-sm">Claude Opus 4.8</td><td class="border p-2 text-sm text-right">$5.00</td><td class="border p-2 text-sm text-right">$25.00</td><td class="border p-2 text-sm text-right">1M</td></tr>
                <tr class="border-b bg-gray-50"><td class="border p-2 text-sm">Claude Fable 5</td><td class="border p-2 text-sm text-right">$10.00</td><td class="border p-2 text-sm text-right">$50.00</td><td class="border p-2 text-sm text-right">1M</td></tr>
                <tr><td class="border p-2 text-sm">GPT-5.5</td><td class="border p-2 text-sm text-right">$15.00</td><td class="border p-2 text-sm text-right">$60.00</td><td class="border p-2 text-sm text-right">256K</td></tr>
              </tbody>
            </table>
          </section>

          <!-- Verdict -->
          <section>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">总结</h2>
            <p class="text-gray-700 leading-relaxed mb-4">
              Project Fetch Phase Two 是自主 API 代理能力的里程碑。Claude Opus 4.7 以比人类快 20 倍的速度完成含硬件交互的软件工程任务——这不是理论，是可复现的真实结果。
            </p>
            <div class="bg-gray-50 rounded-lg p-5 mb-4">
              <p class="text-sm font-semibold text-gray-700 mb-2">选择建议：</p>
              <ul class="text-sm text-gray-600 space-y-1">
                <li><strong>需要包含硬件交互的自主编码？</strong> Claude Opus 4.7+ via Claude Code</li>
                <li><strong>纯软件且预算敏感？</strong> Opus 4.7 的 $5/$25 性价比极高</li>
                <li><strong>需要多厂商路由？</strong> 考虑 <a href="https://freemodel.dev/invite/FRE-7a3b6220"class="text-blue-600 underline" target="_blank" rel="sponsored noopener">FreeModel</a> 统一 API</li>
                <li><strong>国内直连？</strong> 使用 OpenAI 兼容聚合服务</li>
                <li><strong>追求极致编程质量？</strong> Fable 5 最强，但 Opus 4.7 以一半价格提供接近的能力</li>
              </ul>
            </div>
          </section>

        </div>

        <!-- Sidebar -->
        <aside class="space-y-6">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-5">
            <p class="text-sm font-bold text-blue-800 mb-2">试试 FreeModel</p>
            <p class="text-xs text-blue-700 mb-3">OpenAI 兼容聚合平台，支持多厂商路由和国内直连。免费额度 1000 次/月，支持 DeepSeek、Llama、Qwen、Mistral 等模型。</p>
            <a href="https://freemodel.dev/invite/FRE-7a3b6220"class="text-xs text-blue-600 underline break-all" target="_blank" rel="sponsored noopener">freemodel.dev/invite/FRE-7a3b6220</a>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
            <p class="text-sm font-bold text-gray-800 mb-2">快速参考</p>
            <ul class="text-xs text-gray-600 space-y-1">
              <li><strong>模型</strong>：claude-opus-4-7</li>
              <li><strong>输入</strong>：$5/百万 token</li>
              <li><strong>输出</strong>：$25/百万 token</li>
              <li><strong>上下文</strong>：1M tokens</li>
              <li><strong>最大输出</strong>：128K tokens</li>
            </ul>
          </div>

          <div class="bg-gray-100 border border-gray-200 rounded-lg p-6 text-center">
            <p class="text-gray-500 text-sm">广告</p>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
