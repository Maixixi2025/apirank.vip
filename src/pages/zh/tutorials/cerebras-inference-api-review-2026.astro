const slug = 'cerebras-inference-api-review-2026';
const date = '2026-09-01';
const locale = 'zh';

const zhTitle = 'Cerebras Inference 评测 2026：晶圆级 AI 推理 API';
const zhDescription = 'Cerebras Inference 评测 2026：CS-4 晶圆芯片、Gemma 4 多模态、Z.ai GLM 4.7、OpenAI gpt-oss-120b。OpenAI 兼容 API、$5 试用额度。';
const canonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;
const enCanonicalUrl = `https://apirank.vip/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
