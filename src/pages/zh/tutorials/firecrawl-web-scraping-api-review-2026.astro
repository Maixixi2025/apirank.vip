<tr><td class="px-3 py-2"><strong>Standard</strong></td><td class="px-3 py-2">100,000</td><td class="px-3 py-2">25</td><td class="px-3 py-2">$83/月（$99/月付）</td><td class="px-3 py-2">$5 / 2,000 credits</td></tr>
<tr><td class="px-3 py-2"><strong>Growth</strong></td><td class="px-3 py-2">500,000</td><td class="px-3 py-2">50</td><td class="px-3 py-2">$333/月（$399/月付）</td><td class="px-3 py-2">$5 / 2,500 credits</td></tr>
<tr><td class="px-3 py-2"><strong>Scale</strong></td><td class="px-3 py-2">1,000,000</td><td class="px-3 py-2">100</td><td class="px-3 py-2">$599/月</td><td class="px-3 py-2">$5 / 5,000 credits</td></tr>
<tr><td class="px-3 py-2"><strong>Enterprise</strong></td><td class="px-3 py-2">Custom</td><td class="px-3 py-2">100+</td><td class="px-3 py-2">联系销售</td><td class="px-3 py-2">Custom + ZDR Search</td></tr>
