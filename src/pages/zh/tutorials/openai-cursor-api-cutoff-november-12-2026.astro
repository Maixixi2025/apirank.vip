<thead class="bg-gray-100">
<tr><th class="border border-gray-300 px-4 py-2 text-left">模型</th><th class="border border-gray-300 px-4 py-2 text-right">输入 $/M</th><th class="border border-gray-300 px-4 py-2 text-right">输出 $/M</th><th class="border border-gray-300 px-4 py-2 text-right">上下文</th></tr>
</thead>
<tbody>
<tr><td class="border border-gray-300 px-4 py-2"><code class="bg-gray-100 px-1 rounded text-sm">openai/gpt-5.6-luna</code></td><td class="border border-gray-300 px-4 py-2 text-right">$0.20</td><td class="border border-gray-300 px-4 py-2 text-right">$1.20</td><td class="border border-gray-300 px-4 py-2 text-right">1,050,000</td></tr>
<tr><td class="border border-gray-300 px-4 py-2"><code class="bg-gray-100 px-1 rounded text-sm">openai/gpt-5.6-luna:batch</code></td><td class="border border-gray-300 px-4 py-2 text-right">$0.10</td><td class="border border-gray-300 px-4 py-2 text-right">$0.60</td><td class="border border-gray-300 px-4 py-2 text-right">1,050,000</td></tr>
<tr><td class="border border-gray-300 px-4 py-2"><code class="bg-gray-100 px-1 rounded text-sm">openai/gpt-5.6-sol</code></td><td class="border border-gray-300 px-4 py-2 text-right">$2.00</td><td class="border border-gray-300 px-4 py-2 text-right">$10.00</td><td class="border border-gray-300 px-4 py-2 text-right">1,050,000</td></tr>
<tr><td class="border border-gray-300 px-4 py-2"><code class="bg-gray-100 px-1 rounded text-sm">anthropic/claude-opus-5</code></td><td class="border border-gray-300 px-4 py-2 text-right">$5.00</td><td class="border border-gray-300 px-4 py-2 text-right">$25.00</td><td class="border border-gray-300 px-4 py-2 text-right">1,000,000</td></tr>
