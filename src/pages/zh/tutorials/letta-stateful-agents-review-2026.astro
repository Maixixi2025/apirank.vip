const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首页', item: 'https://apirank.vip/zh' }, { '@type': 'ListItem', position: 2, name: '教程', item: 'https://apirank.vip/zh/tutorials' }, { '@type': 'ListItem', position: 3, name: zhTitle, item: canonicalUrl }] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'Letta 是什么？', acceptedAnswer: { '@type': 'Answer', text: 'Letta（letta.com）是总部位于旧金山的一家开源 agent 平台公司，核心是「一等公民的持久化记忆」。主仓库 letta-ai/letta 是 Apache-2.0 许可、24,000+ GitHub 星，CLI 端 @letta-ai/letta-code 在 npm 上周下载 64,000+ 次。Letta Agents SDK 提供以记忆为先的 runtime，与闭源 agent 平台正面竞争——但把记忆、技能、工具的所有权都放在 agent harness（而不是某个插件）手里。' } },
  { '@type': 'Question', name: 'Letta 怎么计费？', acceptedAnswer: { '@type': 'Answer', text: '按套餐 + 用量计费。Free 档 $0/月，最多 3 个有状态 agent、BYOK；Pro 档 $20/月，最多 20 个 agent + Letta Auto 周/月额度 + 按量超额；Teams Pro 按席位，额外加共享 agent + 权限；Developer Plan 凭 API key 纯按量、不限 agent 数量；Enterprise 商务报价，支持自托管。服务端 Letta API 工具按 CPU 时间 $0.00015/秒计费；远程 MCP 工具由 MCP 供应商计费，不消耗 Letta 信用。' } },
  { '@type': 'Question', name: 'Letta 的「记忆块」和向量数据库有什么区别？', acceptedAnswer: { '@type': 'Answer', text: '向量数据库对嵌入做索引用于检索；Letta 的记忆块是 agent 可以在运行时读取、改写、重写的持久化文件。Letta 把记忆分成三块：core（始终在上下文里）、archival（长期可搜索）、recall（最近消息），agent 可用记忆工具自行更新。关键不是检索质量，而是状态所有权：agent 能从过去的运行中学到东西，并把学到的东西带下去，不需要开发者在每次 prompt 时重新做嵌入。' } },
  { '@type': 'Question', name: 'Letta 跟 Anthropic Skills API 和 Computer Use 比起来如何？', acceptedAnswer: { '@type': 'Answer', text: '它们解决的是同一个 agent 技术栈的不同层。Anthropic Skills API 把可复用工作流打包给 Claude 按需调用；Letta Skills 也一样，但面向你自带的任意模型。Anthropic Computer Use 让 Claude 驱动桌面浏览器；Letta Channels 把 AI 同事送进 Slack/Telegram/Discord，配 always-on 云 VM。两者可组合得很好：Letta agent 可用 Claude 做推理，用 Mods 重塑工具栈，再通过 Channel 交付结果——全程记忆跨会话保留。' } },
  { '@type': 'Question', name: 'Letta 适合做生产级编码 agent 吗？', acceptedAnswer: { '@type': 'Answer', text: '适合想要「以记忆为先、模型无关、不会被厂商锁定」运行时的团队。Letta Code 在 2025-12 发布，是 Terminal-Bench 榜单上 #1 的模型无关开源 agent；桌面端 + CLI + Cloud Agents 三种入口共用同一个 agent；Apache-2.0 许可让你可以把整套自托管。但要注意：Letta 是 agent runtime，不是模型 API——你得自带 LLM key（或走 Letta Auto），并单独支付模型用量。' } }
] };
