<tr><td class="border p-2"><strong>Pro</strong></td><td class="border p-2">$10</td><td class="border p-2">$96（年付省 20%）</td><td class="border p-2">2,500/月 (~500 首)</td><td class="border p-2">完整商用授权</td><td class="border p-2">否</td></tr>
<tr><td class="border p-2"><strong>Premier</strong></td><td class="border p-2">$30</td><td class="border p-2">$288（年付省 20%）</td><td class="border p-2">10,000/月 (~2,000 首)</td><td class="border p-2">完整商用授权</td><td class="border p-2">Studio + MIDI + Persona</td></tr>
<tr><td class="border p-2"><strong>积分加购</strong></td><td class="border p-2">灵活</td><td class="border p-2">—</td><td class="border p-2">+ 积分</td><td class="border p-2">订阅有效期内</td><td class="border p-2">—</td></tr>
