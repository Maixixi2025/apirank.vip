---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import providers from '../../../data/providers.json';
import { modelsData, pricingMeta, lastVerifiedLabel, monthlyCostCents, formatCents } from '../../../lib/pricing';
import type { Model, Tier, AvailabilityCN } from '../../../lib/pricing';

// A-04: 模型详情页模板 (中文镜像)
// getStaticPaths 为 models.json 中的每个模型生成一个静态页面。

export function getStaticPaths() {
  return modelsData.models.map((m) => ({
    params: { slug: m.id },
    props: { model: m },
  }));
}

const { model } = Astro.props as { model: Model };

if (!model) {
  return Astro.redirect('/zh/providers');
}

const aliases: Record<string, string[]> = {
  'claude-fable-5': ['Claude Fable 5', 'Claude 4.5', 'Claude Sonnet'],
  'claude-opus-4-8': ['Claude Opus 4.8', 'Claude Opus'],
  'claude-sonnet-4-6': ['Claude Sonnet 4.6', 'Claude Sonnet'],
  'claude-haiku-4-5': ['Claude Haiku 4.5', 'Claude Haiku'],
  'gpt-5': ['GPT-5'],
  'gpt-5-mini': ['GPT-5 mini'],
  'gpt-5-nano': ['GPT-5 nano'],
  'o3': ['OpenAI o3', 'o3'],
  'gemini-2-5-pro': ['Gemini 2.5 Pro'],
  'gemini-2-0-flash': ['Gemini 2.0 Flash'],
  'grok-3': ['Grok-3', 'Grok 3'],
  'grok-3-mini': ['Grok-3 mini'],
  'deepseek-v4-pro': ['DeepSeek V4 Pro'],
  'deepseek-v4-flash': ['DeepSeek V4 Flash'],
  'deepseek-r1': ['DeepSeek R1'],
  'kimi-k2-7': ['Kimi K2.7'],
  'kimi-k2-6': ['Kimi K2.6'],
  'glm-5-2': ['GLM-5.2'],
  'glm-5-1': ['GLM-5.1'],
  'glm-5-flash': ['GLM-5-Flash'],
  'mistral-small-3': ['Mistral Small 3'],
  'qwen-turbo': ['Qwen-Turbo'],
  'hunyuan-turbo': ['Hunyuan-Turbo'],
  'doubao-lite': ['Doubao Lite'],
  'ernie-speed': ['ERNIE-Speed'],
  'llama-3-3-70b': ['Llama 3.3 70B'],
};

const modelAliases = aliases[model.id] ?? [model.name];
const offeringProviders = providers
  .filter((p: any) =>
    Array.isArray(p.models) &&
    p.models.some((m: string) => modelAliases.some(a => m.includes(a)))
  )
  .sort((a: any, b: any) => (a.overallRank ?? 99) - (b.overallRank ?? 99));

const alternatives = modelsData.models
  .filter((m) => m.tier === model.tier && m.id !== model.id)
  .slice(0, 6);

const scenarios = [
  { id: 'chatbot',     name: 'AI 客服',     dailyCalls: 5000,  inputSharePct: 60, avgTokensPerCall: 600,  cacheHitRatePct: 30 },
  { id: 'rag',         name: 'RAG 问答',    dailyCalls: 2000,  inputSharePct: 85, avgTokensPerCall: 1500, cacheHitRatePct: 60 },
  { id: 'codeassist',  name: '代码助手',    dailyCalls: 1500,  inputSharePct: 70, avgTokensPerCall: 2000, cacheHitRatePct: 20 },
  { id: 'doc-summary', name: '长文总结',    dailyCalls: 500,   inputSharePct: 90, avgTokensPerCall: 8000, cacheHitRatePct: 10 },
];

const scenarioCosts = scenarios.map((s) => ({
  ...s,
  cents: monthlyCostCents(model, {
    dailyCalls: s.dailyCalls,
    inputSharePct: s.inputSharePct,
    avgTokensPerCall: s.avgTokensPerCall,
    cacheHitRatePct: s.cacheHitRatePct,
  }),
}));

const tierLabel: Record<Tier, string> = {
  frontier: '旗舰',
  mid: '中端',
  budget: '经济',
};

const tierLabelEn: Record<Tier, string> = {
  frontier: 'Frontier',
  mid: 'Mid-tier',
  budget: 'Budget',
};

const cnLabel: Record<AvailabilityCN, { text: string; cls: string }> = {
  direct:         { text: '国内直连',     cls: 'bg-emerald-100 text-emerald-700 border-emerald-200' },
  proxy_required: { text: '需代理',       cls: 'bg-amber-100 text-amber-700 border-amber-200' },
  blocked:        { text: '国内无法访问', cls: 'bg-rose-100 text-rose-700 border-rose-200' },
};

const title = `${model.nameZh} — 价格、规格、供应商 (2026) | APIRank`;
const description = `${model.nameZh} API 价格（USD/百万 tokens）、上下文窗口、能力、国内访问情况，以及提供该模型的供应商。${model.contextWindow.toLocaleString()} tokens 上下文。${tierLabel[model.tier]} 级别。`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${model.nameZh} API — 2026 价格与规格`,
  description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: 'APIRank' },
  publisher: { '@type': 'Organization', name: 'APIRank', url: 'https://apirank.vip' },
  datePublished: modelsData.lastVerified,
  dateModified: pricingMeta.lastVerified,
  about: {
    '@type': 'SoftwareApplication',
    name: model.nameZh,
    applicationCategory: 'AI API',
    operatingSystem: 'Cloud',
    offers: {
      '@type': 'Offer',
      price: model.pricing.input,
      priceCurrency: 'USD',
      description: '输入价格 / 百万 tokens',
    },
  },
};

const verifiedLabel = lastVerifiedLabel('zh');
---

<BaseLayout title={title} description={description} type="article">
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumbs -->
    <nav class="text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
      <a href="/zh" class="hover:text-blue-600">首页</a>
      <span class="mx-2">/</span>
      <a href="/zh/providers" class="hover:text-blue-600">全部厂商</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">{model.nameZh}</span>
    </nav>

    <!-- Hero -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class={`text-xs font-medium px-2 py-1 rounded border ${cnLabel[model.availabilityCN].cls}`}>
          {cnLabel[model.availabilityCN].text}
        </span>
        <span class="text-xs font-medium px-2 py-1 rounded bg-gray-100 text-gray-700 border border-gray-200">
          {tierLabel[model.tier]}
        </span>
        <span class="text-xs text-gray-500">{verifiedLabel}</span>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-2">{model.nameZh}</h1>
      <p class="text-gray-600 text-lg max-w-3xl">{model.noteZh}</p>
      <div class="mt-4 text-sm text-gray-500">
        供应商：<a href={`/zh/providers/${model.providerId}`} class="text-blue-600 hover:underline">{model.providerZh}</a>
        ·
        <a href={model.officialUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">官方价格 ↗</a>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Main column -->
      <div class="lg:col-span-2 space-y-8">

        <!-- 价格 -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-4">💰 价格（每百万 tokens）</h2>
          <div class="grid grid-cols-3 gap-4">
            <div class="bg-blue-50 rounded-lg p-4 border border-blue-100">
              <div class="text-xs text-blue-700 font-medium uppercase tracking-wide">输入</div>
              <div class="text-2xl font-bold text-blue-900 mt-1">
                ${model.pricing.input.toFixed(2)}
              </div>
            </div>
            <div class="bg-purple-50 rounded-lg p-4 border border-purple-100">
              <div class="text-xs text-purple-700 font-medium uppercase tracking-wide">输出</div>
              <div class="text-2xl font-bold text-purple-900 mt-1">
                ${model.pricing.output.toFixed(2)}
              </div>
            </div>
            <div class="bg-emerald-50 rounded-lg p-4 border border-emerald-100">
              <div class="text-xs text-emerald-700 font-medium uppercase tracking-wide">缓存</div>
              <div class="text-2xl font-bold text-emerald-900 mt-1">
                ${model.pricing.cache.toFixed(2)}
              </div>
            </div>
          </div>
          <p class="text-xs text-gray-500 mt-4">USD / 百万 tokens。缓存 = 缓存读取。人民币 ≈ ×7。</p>
        </section>

        <!-- 规格 -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-4">📋 规格</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="border-b border-gray-100 pb-3">
              <dt class="text-sm text-gray-500">上下文窗口</dt>
              <dd class="text-lg font-semibold text-gray-900">{model.contextWindow.toLocaleString()} tokens</dd>
            </div>
            <div class="border-b border-gray-100 pb-3">
              <dt class="text-sm text-gray-500">级别</dt>
              <dd class="text-lg font-semibold text-gray-900">{tierLabel[model.tier]}</dd>
            </div>
            <div class="border-b border-gray-100 pb-3">
              <dt class="text-sm text-gray-500">能力</dt>
              <dd class="flex flex-wrap gap-1 mt-1">
                {model.capabilities.map((cap) => (
                  <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700 border border-gray-200">{cap}</span>
                ))}
              </dd>
            </div>
            <div class="border-b border-gray-100 pb-3">
              <dt class="text-sm text-gray-500">国内访问</dt>
              <dd>
                <span class={`inline-block text-xs font-medium px-2 py-1 rounded border ${cnLabel[model.availabilityCN].cls}`}>
                  {cnLabel[model.availabilityCN].text}
                </span>
              </dd>
            </div>
          </dl>
        </section>

        <!-- 月度成本估算 -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-1">📊 月度成本估算</h2>
          <p class="text-sm text-gray-500 mb-4">4 种典型工作负载 · 30 天 · 美元</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {scenarioCosts.map((s) => (
              <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 transition-colors">
                <div class="flex justify-between items-start">
                  <div>
                    <div class="font-semibold text-gray-900">{s.name}</div>
                    <div class="text-xs text-gray-500 mt-1">
                      {(s.dailyCalls * 30).toLocaleString()} 次调用 · {s.avgTokensPerCall} tok 均值 · {s.cacheHitRatePct}% 缓存
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-bold text-blue-700">{formatCents(s.cents)}</div>
                    <div class="text-xs text-gray-500">/ 月</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <a
            href={`/zh/calculator?model=${model.id}`}
            class="mt-4 inline-block text-sm text-blue-600 hover:underline"
          >
            用你的数据计算 →
          </a>
        </section>

        <!-- 提供该模型的供应商 -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-1">🌐 在哪里获取 {model.nameZh}</h2>
          <p class="text-sm text-gray-500 mb-4">
            {offeringProviders.length === 0
              ? '我们的数据库中暂无供应商列出此模型。'
              : `${offeringProviders.length} 家供应商提供该模型（按排名排序）。`}
          </p>
          {offeringProviders.length > 0 && (
            <div class="space-y-2">
              {offeringProviders.slice(0, 10).map((p: any) => (
                <a
                  href={`/zh/providers/${p.id}`}
                  class="flex items-center justify-between p-3 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50/30 transition-colors"
                >
                  <div>
                    <div class="font-medium text-gray-900">{p.nameCn || p.name}</div>
                    <div class="text-xs text-gray-500">{p.availabilityCN || p.availabilityEN}</div>
                  </div>
                  <span class="text-sm text-gray-400">#{p.overallRank}</span>
                </a>
              ))}
            </div>
          )}
        </section>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">

        <!-- CTAs -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h3 class="font-bold text-gray-900 mb-3">立即试用</h3>
          <a
            href={`/zh/calculator?model=${model.id}`}
            class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors mb-2"
          >
            计算成本
          </a>
          {offeringProviders.length > 0 && (
            <a
              href={`/zh/providers/${offeringProviders[0].id}`}
              class="block w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-900 font-medium py-2 px-4 rounded-lg transition-colors mb-2"
            >
              查看首选供应商
            </a>
          )}
          <a
            href={model.officialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors"
          >
            官方价格 ↗
          </a>
        </div>

        <!-- 同级别替代模型 -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h3 class="font-bold text-gray-900 mb-3">{tierLabel[model.tier]}级别替代</h3>
          <div class="space-y-2">
            {alternatives.map((alt) => (
              <a
                href={`/zh/models/${alt.id}`}
                class="flex items-center justify-between py-1.5 text-sm hover:text-blue-600 transition-colors"
              >
                <span>{alt.nameZh}</span>
                <span class="text-gray-400 text-xs">${alt.pricing.input}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 顶级供应商 -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
          <h3 class="font-bold text-gray-900 mb-3">🏆 顶级供应商</h3>
          <div class="space-y-2">
            {providers
              .sort((a: any, b: any) => a.overallRank - b.overallRank)
              .slice(0, 5)
              .map((p: any) => (
                <a
                  href={`/zh/providers/${p.id}`}
                  class="flex items-center justify-between py-1.5 text-sm hover:text-blue-600 transition-colors"
                >
                  <span>{p.nameCn || p.name}</span>
                  <span class="text-gray-400 text-xs">#{p.overallRank}</span>
                </a>
              ))}
          </div>
        </div>

      </aside>

    </div>
  </article>

  <!-- A-09: model_view event -->
  <script is:inline define:vars={{ modelId: model.id, modelName: model.nameZh }}>
    window.__analytics && window.__analytics.track('model_view', {
      model_id: modelId,
      model_name: modelName,
      locale: 'zh',
    });
  </script>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>