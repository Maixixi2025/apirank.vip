    <tr><td class="px-3 py-2 border-b"><strong>AI21</strong></td><td class="px-3 py-2 border-b">Jamba 1.5 Mini</td><td class="px-3 py-2 border-b">$0.20</td><td class="px-3 py-2 border-b">256K</td><td class="px-3 py-2 border-b"><strong>$0.78</strong></td></tr>
