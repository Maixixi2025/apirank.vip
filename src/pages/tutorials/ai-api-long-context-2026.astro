    <tr><td class="px-3 py-2 border-b"><strong>Google</strong></td><td class="px-3 py-2 border-b">Gemini 2.5 Pro</td><td class="px-3 py-2 border-b">$1.25</td><td class="px-3 py-2 border-b">1M</td><td class="px-3 py-2 border-b"><strong>$1.25</strong></td></tr>
    <tr><td class="px-3 py-2 border-b"><strong>OpenAI</strong></td><td class="px-3 py-2 border-b">GPT-4o-mini</td><td class="px-3 py-2 border-b">$0.15</td><td class="px-3 py-2 border-b">128K</td><td class="px-3 py-2 border-b"><strong>$1.17</strong></td></tr>
    <tr><td class="px-3 py-2 border-b"><strong>DeepSeek</strong></td><td class="px-3 py-2 border-b">V3</td><td class="px-3 py-2 border-b">$0.27</td><td class="px-3 py-2 border-b">128K</td><td class="px-3 py-2 border-b"><strong>$2.11</strong></td></tr>
  </tbody>
