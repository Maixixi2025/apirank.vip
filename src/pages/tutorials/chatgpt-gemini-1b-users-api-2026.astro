const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Did ChatGPT really pass 1 billion users in 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. OpenAI reported ChatGPT passing 1 billion weekly active users during July 2026, and the company says its broader AI platform has more than 1 billion total active users and 2 million business customers. It reached the 1 billion monthly-app-user mark in May 2026, the fastest any app has done it, according to Sensor Tower and Reuters data reported in early June 2026." }
    },
    {
      "@type": "Question",
      "name": "When did Google Gemini hit 1 billion users?",
      "acceptedAnswer": { "@type": "Answer", "text": "On August 11, 2026, Google CEO Sundar Pichai announced that the Gemini app had passed 1 billion monthly active users, making it Google's fastest-growing product ever. Gemini sat at about 950 million monthly users in late July 2026, so the final push from roughly 950M to 1B took only a few weeks." }
    },
    {
      "@type": "Question",
      "name": "Why did OpenAI cut GPT-5.6 API prices by 80%?",
      "acceptedAnswer": { "@type": "Answer", "text": "On July 30, 2026 OpenAI cut GPT-5.6 Luna API prices by about 80% and GPT-5.6 Terra by about 20%. Independently reported reasons include intensifying competition from Anthropic and Google, growing enterprise price sensitivity, and the need to make high-volume agent workloads economical. The WSJ first reported in June that OpenAI was weighing drastic cuts in anticipation of a price war with Anthropic." }
    },
    {
      "@type": "Question",
      "name": "Is Gemini cheaper than OpenAI for API use in 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "For most price-sensitive workloads, yes. Gemini 3.5 Flash and the newer 3.6 Flash / 3.5 Flash-Lite tiers are positioned well below GPT-5.6 Sol on a per-token basis, and independent comparisons put Flash roughly one-third the cost of an Opus-class flagship while landing within a few points on benchmarks. The right answer depends on your workload, but the 2026 trend is that Google is the aggressive price leader at the Flash tier and OpenAI is defending share with deep cuts on Luna." }
    },
    {
      "@type": "Question",
      "name": "What do the 1-billion-user milestones mean for API prices?",
      "acceptedAnswer": { "@type": "Answer", "text": "The consumer milestones translate directly into API price pressure because both companies fund consumer scale with inference efficiency and use API volume to amortize it. OpenAI's 80% Luna cut, Google's cheap Flash tiers, and DeepSeek's 75% price cut on V4 together pushed the effective cost floor down across 2026. For developers this is structurally a buyer's market: prices are falling, so locking a single provider into a long contract is riskier than routing across providers." }
    },
    {
      "@type": "Question",
      "name": "Should I route across multiple providers instead of committing to one?",
      "acceptedAnswer": { "@type": "Answer", "text": "Increasingly yes. With OpenAI, Anthropic, Google, and DeepSeek all cutting prices and releasing new tiers faster than any single contract can track, a multi-provider routing layer lets you switch the cheapest adequate model per query, keep a fallback when one provider hits a rate limit or outage, and re-price automatically when anyone releases a cheaper tier. The cost of this flexibility is integration and key management overhead, which is exactly what a gateway or unified API key is designed to absorb." }
    }
