const slug = 'chatgpt-gemini-1b-users-api-2026';
const date = '2026-08-12';
const locale = 'en';
const enTitle = 'ChatGPT & Gemini Cross 1B Users: API Selection in 2026';
const enDescription = 'ChatGPT passed 1B weekly users; Gemini hit 1B monthly on Aug 11. Both giants are now racing on API price cuts. How developers pick providers in 2026.';
