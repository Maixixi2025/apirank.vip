</tr>
<tr>
<td class="border border-gray-200 px-4 py-2 font-semibold">GPT-5.6 Luna</td>
<td class="border border-gray-200 px-4 py-2">~$0.30 (post-cut)</td>
<td class="border border-gray-200 px-4 py-2">~$1.20 (post-cut)</td>
