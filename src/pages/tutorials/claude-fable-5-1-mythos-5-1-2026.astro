        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">Fable 5.1</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">Fable 5</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">Opus 5</th>
        <th class="px-4 py-2 text-left text-sm font-semibold text-gray-900">Domain</th>
      </tr>
