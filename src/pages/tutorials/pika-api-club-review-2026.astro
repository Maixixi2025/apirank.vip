  "mainEntity": [
    { "@type": "Question", "name": "What is the Pika API Club in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "The Pika API Club is a wholesale Gen-Media API membership launched by Pika (formerly the AI video startup behind pika.art) on August 5, 2026. For a flat $10 per month it exposes more than 100 third-party Gen-Media models — video, image, and audio generation plus some LLM endpoints — behind a single OpenAI-compatible, 'agent-native' API at wholesale prices. It aggregates models routed through upstream providers such as Alibaba, Anthropic, ByteDance, DeepSeek, ElevenLabs, Google, Ideogram, MiniMax, Moonshot, OpenAI, xAI, and Z.ai." } },
