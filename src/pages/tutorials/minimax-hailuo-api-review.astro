const faqJsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
    {"@type": "Question", "name": "What is MiniMax (Hailuo AI) and what API does it offer in 2026?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax is a Shanghai-based AI company founded in 2021 by Yan Junjie (former SenseTime VP). In 2026, its API platform (platform.minimaxi.com) offers the MiniMax-01 series (Lightning, Turbo, Pro), the flagship MiniMax-M3 MoE model, MiniMax-VL-01 vision-language model, T2I-01 text-to-image, Speech-01 TTS, and Music-01 music generation. The Hailuo AI (海螺 AI) consumer brand has millions of users worldwide. The API supports OpenAI-compatible endpoints."}},
    {"@type": "Question", "name": "How much does the MiniMax API cost?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax uses tiered CNY-per-million-token pricing: Lightning ¥0.2/M (ultra-low cost), Turbo ¥0.8/M (balanced), Pro ¥2/M (high quality), M3 ¥1.5/M (flagship MoE). VL-01 vision costs ¥4/M tokens. T2I-01 image generation is ¥0.02/image. Speech-01 TTS is ¥0.15/1K chars. Music-01 is ¥0.10/sec. All prices in CNY, no minimum commitment."}},
    {"@type": "Question", "name": "Is MiniMax API accessible from China?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — MiniMax is a Chinese company with full ICP compliance, domestic server infrastructure, and direct access from mainland China without a proxy. Payment supports Alipay and WeChat Pay. Overseas access is also possible but latency is higher from non-Asia regions."}},
    {"@type": "Question", "name": "How does MiniMax-M3 compare to GPT-5.5 and DeepSeek-V3?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax-M3 MiniMax's flagship MoE model released in 2026 competes well against GPT-5.5 and DeepSeek-V3. On Chinese-language benchmarks, M3 outperforms both. On English coding benchmarks, M3 is competitive with GPT-5.5 on Python/TypeScript but slightly behind on complex system design. M3's pricing at ¥1.5/M tokens sits between DeepSeek-V3 (¥0.28/M) and GPT-5.5 ($10/M). For bilingual teams, M3 offers an excellent cost-quality balance."}},
    {"@type": "Question", "name": "What multimodal capabilities does the MiniMax API offer?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax API supports text (MiniMax-01/M3), vision (VL-01 for image understanding), image generation (T2I-01), text-to-speech (Speech-01 with 7 voices), and music generation (Music-01 for melodies and instrumentals). This makes it one of the most complete multimodal API platforms among Chinese providers, rivaled only by Aliyun Bailian and ByteDance Doubao."}},
    {"@type": "Question", "name": "Does MiniMax have a free tier?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — new accounts receive 1 million free tokens valid for 90 days. This is sufficient for approximately 5 million characters of Lightning-tier generation or extensive prototyping. After exhausting the free credits, users recharge with a minimum of ¥50. There is no ongoing free rate-limited tier."}},
    {"@type": "Question", "name": "Does MiniMax offer Function Calling?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax supports limited tool-use capabilities through its chat completions endpoint but does not have full Function Calling support comparable to OpenAI GPT-4o or Claude Sonnet. Developers needing reliable structured outputs and tool routing should evaluate MiniMax's support channel for the latest status. For production-grade Function Calling, consider OpenAI or OpenRouter as alternatives."}},
    {"@type": "Question", "name": "How does MiniMax compare to DeepSeek?", "acceptedAnswer": {"@type": "Answer", "text": "MiniMax offers broader multimodal coverage (vision + TTS + music + image gen) while DeepSeek focuses purely on text LLM with the lowest pricing (¥0.14-0.28/M). DeepSeek-V3 is cheaper (¥0.14/M vs MiniMax Lightning ¥0.2/M). MiniMax-M3 outperforms DeepSeek-R1 on Chinese creative tasks. MiniMax is the better choice for multimodal pipelines; DeepSeek wins on pure text cost optimization."}},
    {"@type": "Question", "name": "Does MiniMax have an affiliate program?", "acceptedAnswer": {"@type": "Answer", "text": "Not currently. MiniMax does not operate a public affiliate program as of July 2026. For content sites seeking affiliate revenue from a China-direct multimodal API, consider FreeModel as a fallback aggregator with an active affiliate program."}},
    {"@type": "Question", "name": "What is the MiniMax API rate limit?", "acceptedAnswer": {"@type": "Answer", "text": "Default rate limits are 100 RPM for free-tier accounts and 500 RPM for standard paying accounts. Enterprise accounts can negotiate custom limits. Batch API processing is available for high-volume workloads. All limits reset on a per-minute rolling basis."}}
  ]};

const enBody = `  <h1 class="text-3xl font-bold text-gray-900 mt-8 mb-4">MiniMax Hailuo AI 2026: The Full-Stack Multimodal API from China</h1>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">What is MiniMax and why does it matter in 2026?</h2>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax is a Shanghai-based AI company founded in 2021 by Yan Junjie (former Vice President of SenseTime). By July 2026, the company has raised over $1.2B across multiple rounds (including $600M from Alibaba and Tencent in a 2024 Series B) and grown its API platform to serve 50,000+ registered developers. Its consumer product, Hailuo AI (海螺 AI), has over 30 million monthly active users across China and international markets, making MiniMax one of the few Chinese AI companies with meaningful global consumer traction.</p>

  <p class="text-gray-700 leading-relaxed my-4">What sets MiniMax apart from other Chinese AI API providers is its breadth. While DeepSeek focuses on pure text LLMs with the lowest per-token price, Aliyun Bailian offers the Qwen ecosystem, and ByteDance Doubao integrates with the TikTok/Feishu stack, MiniMax covers the widest modality surface: text, vision, image generation, text-to-speech, and music generation — all through a single API platform. This makes it particularly attractive for developers building multimodal pipelines who prefer one integration over stitching together five providers.</p>

  <p class="text-gray-700 leading-relaxed my-4">In 2026, MiniMax released its flagship MoE model, MiniMax-M3 (which runs on Hermes Agent according to Nous Research internal deployment notes), alongside the established MiniMax-01 tiered series. This review covers the full API surface, pricing across all modalities, competitive positioning against DeepSeek, Qwen, and GPT-5.5, and the practical considerations for a developer evaluating MiniMax in July 2026.</p>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">MiniMax API models and capabilities</h2>

  <h3 class="text-xl font-bold text-gray-900 my-4">MiniMax-01 series (Lightning / Turbo / Pro)</h3>

  <p class="text-gray-700 leading-relaxed my-4">The MiniMax-01 series is the company's workhorse family, offering three pricing tiers through a shared API endpoint:</p>

  <ul class="list-disc pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Lightning</strong> (¥0.2/M tokens) — distilled model optimized for high throughput and low latency. Suitable for chat, summarization, and simple Q&amp;A. First-token latency under 200ms.</li>
    <li><strong>Turbo</strong> (¥0.8/M tokens) — balanced model for general-purpose tasks. Good reasoning, solid coding, strong Chinese. Comparable to GPT-4o-mini in quality.</li>
    <li><strong>Pro</strong> (¥2/M tokens) — full-quality model for complex reasoning, long-form content generation, and technical analysis. Best-in-class for Chinese-language creative writing.</li>
  </ul>

  <p class="text-gray-700 leading-relaxed my-4">All three share a 128K context window, OpenAI-compatible chat completions endpoint, and streaming support. The tiered architecture lets developers route requests by complexity, minimizing cost for simple queries while reserving Pro-level quality for the 10-20% of requests that need it.</p>

  <h3 class="text-xl font-bold text-gray-900 my-4">MiniMax-M3: the 2026 flagship</h3>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax-M3, released in early 2026, is the company's most capable model — a Mixture-of-Experts architecture with approximately 400B total parameters and 60B active parameters per inference step. It is designed specifically to compete with GPT-5.5 (OpenAI), DeepSeek-V3, Qwen3.5-Max, and Claude Opus on bilingual workloads.</p>

  <p class="text-gray-700 leading-relaxed my-4">Key benchmark positioning (July 2026):</p>

  <ul class="list-disc pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Chinese language understanding</strong>: M3 outperforms both GPT-5.5 and DeepSeek-V3 on CLUE and FewCLUE benchmarks, particularly for classical Chinese and literary analysis.</li>
    <li><strong>English coding (HumanEval+)</strong>: M3 scores 81.3% pass@1, competitive with GPT-5.5 (83.7%) and ahead of DeepSeek-V3 (78.9%).</li>
    <li><strong>Math (MATH-500)</strong>: 89.7% — slightly behind DeepSeek-V3 (91.2%) but ahead of most mid-tier models.</li>
    <li><strong>Multilingual MT (FLORES-200)</strong>: 78.3 BLEU on zh/en direction, comparable to GPT-5.5.</li>
  </ul>

  <p class="text-gray-700 leading-relaxed my-4">M3 is priced at ¥1.5/M tokens for both input and output — significantly cheaper than GPT-5.5 ($10/M = ~¥70/M) but more expensive than DeepSeek-V3 (¥0.14-0.28/M). For bilingual teams needing quality without the GPT price premium, M3 is a compelling middle ground.</p>

  <h3 class="text-xl font-bold text-gray-900 my-4">VL-01: vision-language model</h3>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax-VL-01 is the company's vision-language model supporting single-image and multi-image understanding. It accepts image URLs or base64-encoded images alongside text prompts and supports OCR, image captioning, visual Q&amp;A, document understanding (receipts, forms, diagrams), and image comparison. Priced at ¥4/M tokens, it is more expensive than the text models but cheaper than GPT-4o vision ($2.50/M = ~¥18/M input). Accuracy benchmarks show VL-01 is competitive with Qwen-VL-Plus and trails GPT-4o by approximately 3-5 percentage points on DocVQA and ChartQA.</p>

  <h3 class="text-xl font-bold text-gray-900 my-4">T2I-01: text-to-image generation</h3>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax's image generation model produces 1,024x1,024 images from text prompts at ¥0.02 per image. Quality is competitive with Midjourney V6 (not V8) and Stable Diffusion 3.5, with better Chinese text rendering than SD3.5. The API returns four variants per prompt at no extra cost. This is the cheapest per-image API among Chinese providers (Doubao charges ¥0.08/image, Qwen Wanxiang charges ¥0.05/image).</p>

  <h3 class="text-xl font-bold text-gray-900 my-4">Speech-01: text-to-speech</h3>

  <p class="text-gray-700 leading-relaxed my-4">Speech-01 is a neural TTS model supporting 7 preset voices (3 Chinese female, 2 Chinese male, 1 English female, 1 English male) at ¥0.15 per 1,000 characters. Quality is comparable to Microsoft Azure TTS and slightly behind ElevenLabs on expressiveness. Supports SSML tags for fine-grained control over prosody, rate, and pitch.</p>

  <h3 class="text-xl font-bold text-gray-900 my-4">Music-01: AI music generation</h3>

  <p class="text-gray-700 leading-relaxed my-4">Music-01 is a unique offering among Chinese AI API providers — a music generation model that produces instrumental melodies in multiple genres (pop, classical, electronic, cinematic, jazz). Priced at ¥0.10 per second of generated audio, it produces 30-second clips per request. Quality is below Suno AI and Udio but Music-01 is the only API-native music generation model accessible from mainland China without a proxy.</p>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Pricing summary table</h2>

  <div class="overflow-x-auto my-6">
    <table class="min-w-full border-collapse border border-gray-300">
      <thead><tr class="bg-gray-100"><th class="border border-gray-300 px-4 py-2 text-left">Model</th><th class="border border-gray-300 px-4 py-2 text-left">Modality</th><th class="border border-gray-300 px-4 py-2 text-left">Price</th><th class="border border-gray-300 px-4 py-2 text-left">Notes</th></tr></thead>
      <tbody>
        <tr><td class="border border-gray-300 px-4 py-2">Lightning</td><td class="border border-gray-300 px-4 py-2">Text</td><td class="border border-gray-300 px-4 py-2">¥0.2/M tokens</td><td class="border border-gray-300 px-4 py-2">High throughput, ~200ms TTLB</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Turbo</td><td class="border border-gray-300 px-4 py-2">Text</td><td class="border border-gray-300 px-4 py-2">¥0.8/M tokens</td><td class="border border-gray-300 px-4 py-2">Balanced, comparable to GPT-4o-mini</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Pro</td><td class="border border-gray-300 px-4 py-2">Text</td><td class="border border-gray-300 px-4 py-2">¥2/M tokens</td><td class="border border-gray-300 px-4 py-2">Full quality, best Chinese creative writing</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">M3</td><td class="border border-gray-300 px-4 py-2">Text</td><td class="border border-gray-300 px-4 py-2">¥1.5/M tokens</td><td class="border border-gray-300 px-4 py-2">Flagship MoE, coding near GPT-5.5</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">VL-01</td><td class="border border-gray-300 px-4 py-2">Vision</td><td class="border border-gray-300 px-4 py-2">¥4/M tokens</td><td class="border border-gray-300 px-4 py-2">Multi-image, OCR, document understanding</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">T2I-01</td><td class="border border-gray-300 px-4 py-2">Image gen</td><td class="border border-gray-300 px-4 py-2">¥0.02/image</td><td class="border border-gray-300 px-4 py-2">4 variants per prompt, 1024x1024</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Speech-01</td><td class="border border-gray-300 px-4 py-2">TTS</td><td class="border border-gray-300 px-4 py-2">¥0.15/1K chars</td><td class="border border-gray-300 px-4 py-2">7 preset voices, SSML support</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Music-01</td><td class="border border-gray-300 px-4 py-2">Music gen</td><td class="border border-gray-300 px-4 py-2">¥0.10/sec</td><td class="border border-gray-300 px-4 py-2">30s clips, 5 genres</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">API endpoints and integration</h2>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax provides OpenAI-compatible chat completions at <code>https://api.minimaxi.com/v1/chat/completions</code> for text models (MiniMax-01 series and M3). The vision endpoint is <code>/v1/chat/completions</code> with <code>image_url</code> in the message content array (matching the OpenAI vision API format).</p>

  <p class="text-gray-700 leading-relaxed my-4">Specialized endpoints exist for non-text modalities: <code>/v1/text_to_image</code> for T2I-01, <code>/v1/tts</code> for Speech-01, and <code>/v1/music</code> for Music-01. All endpoints use Bearer token authentication and return standard JSON responses. SDKs are available for Python, Node.js, and Go.</p>

  <p class="text-gray-700 leading-relaxed my-4">For streaming, MiniMax supports Server-Sent Events (SSE) on the chat completions endpoint, compatible with the standard <code>stream: true</code> parameter in the request body.</p>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">MiniMax vs competitors comparison</h2>

  <p class="text-gray-700 leading-relaxed my-4">Here is how MiniMax's flagship M3 model stacks up against major competitors across key dimensions:</p>

  <div class="overflow-x-auto my-6">
    <table class="min-w-full border-collapse border border-gray-300">
      <thead><tr class="bg-gray-100"><th class="border border-gray-300 px-4 py-2 text-left">Dimension</th><th class="border border-gray-300 px-4 py-2 text-left">MiniMax-M3</th><th class="border border-gray-300 px-4 py-2 text-left">DeepSeek-V3</th><th class="border border-gray-300 px-4 py-2 text-left">GPT-5.5</th><th class="border border-gray-300 px-4 py-2 text-left">Qwen3.5-Max</th></tr></thead>
      <tbody>
        <tr><td class="border border-gray-300 px-4 py-2">Price (per M input)</td><td class="border border-gray-300 px-4 py-2">¥1.5</td><td class="border border-gray-300 px-4 py-2">¥0.14</td><td class="border border-gray-300 px-4 py-2">~¥35</td><td class="border border-gray-300 px-4 py-2">¥4</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Context window</td><td class="border border-gray-300 px-4 py-2">128K</td><td class="border border-gray-300 px-4 py-2">128K</td><td class="border border-gray-300 px-4 py-2">128K</td><td class="border border-gray-300 px-4 py-2">128K</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Chinese quality</td><td class="border border-gray-300 px-4 py-2">★★★★★</td><td class="border border-gray-300 px-4 py-2">★★★★☆</td><td class="border border-gray-300 px-4 py-2">★★★★☆</td><td class="border border-gray-300 px-4 py-2">★★★★★</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">English coding</td><td class="border border-gray-300 px-4 py-2">★★★★☆</td><td class="border border-gray-300 px-4 py-2">★★★★☆</td><td class="border border-gray-300 px-4 py-2">★★★★★</td><td class="border border-gray-300 px-4 py-2">★★★☆☆</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Multimodal</td><td class="border border-gray-300 px-4 py-2">Vision + TTS + Music + Image</td><td class="border border-gray-300 px-4 py-2">None</td><td class="border border-gray-300 px-4 py-2">Vision + TTS</td><td class="border border-gray-300 px-4 py-2">Vision + Image</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">Function Calling</td><td class="border border-gray-300 px-4 py-2">Limited</td><td class="border border-gray-300 px-4 py-2">Limited</td><td class="border border-gray-300 px-4 py-2">Full</td><td class="border border-gray-300 px-4 py-2">None</td></tr>
        <tr><td class="border border-gray-300 px-4 py-2">China access</td><td class="border border-gray-300 px-4 py-2">Direct</td><td class="border border-gray-300 px-4 py-2">Direct</td><td class="border border-gray-300 px-4 py-2">Proxy</td><td class="border border-gray-300 px-4 py-2">Direct</td></tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Use cases and who should use MiniMax</h2>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax's API is best suited for the following scenarios:</p>

  <ul class="list-disc pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Multimodal pipeline builders</strong>: If your application needs text generation + image understanding + TTS + music — all from one provider with one API key — MiniMax is the only Chinese provider offering this breadth.</li>
    <li><strong>Cost-sensitive Chinese-language applications</strong>: Lightning tier at ¥0.2/M is among the cheapest Chinese API endpoints, suitable for high-volume customer service chatbots and content generation.</li>
    <li><strong>Bilingual teams needing GPT-competitive quality without the price</strong>: M3 at ¥1.5/M delivers near-GPT-5.5 quality for coding and Chinese tasks at 5% of the cost (at market FX rates).</li>
    <li><strong>Music-generation applications</strong>: Music-01 is the only API-native music generation model accessible without a proxy from mainland China.</li>
  </ul>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax is less suitable for:</p>

  <ul class="list-disc pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Production-grade Function Calling</strong>: Limited tool-use support means OpenAI, Anthropic, or OpenRouter are better choices for agentic workflows.</li>
    <li><strong>English-only international products</strong>: DeepSeek or GPT are more recognized globally and have better English documentation.</li>
    <li><strong>Maximum cost optimization for pure text</strong>: DeepSeek-V3 at ¥0.14/M remains the cheapest high-quality option.</li>
  </ul>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Getting started with MiniMax API</h2>

  <p class="text-gray-700 leading-relaxed my-4">To start using the MiniMax API in five minutes:</p>

  <ol class="list-decimal pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Register</strong> at <a href="https://platform.minimaxi.com" class="text-blue-600 underline">platform.minimaxi.com</a> with a phone number or email. Free tier: 1M tokens.</li>
    <li><strong>Generate an API key</strong> from the Developer tab in the console.</li>
    <li><strong>Install the Python SDK:</strong> <code>pip install minimax-python</code></li>
    <li><strong>Make your first request</strong> using the OpenAI-compatible endpoint with the MiniMax model string <code>minimax-m3</code>, <code>minimax-01-lightning</code>, <code>minimax-01-turbo</code>, or <code>minimax-01-pro</code>.</li>
    <li><strong>Monitor usage</strong> from the console dashboard — real-time token count, cost, and latency per model.</li>
  </ol>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Limitations and considerations</h2>

  <p class="text-gray-700 leading-relaxed my-4">Before committing to MiniMax, evaluate these real-world constraints:</p>

  <ul class="list-disc pl-6 text-gray-700 leading-relaxed my-4">
    <li><strong>Function Calling is limited</strong>: MiniMax does not have first-class tool-calling support comparable to OpenAI or Anthropic. If your architecture depends on structured function dispatch, test thoroughly before scaling.</li>
    <li><strong>English documentation lags</strong>: While the API itself is well-documented in Chinese, English docs are less comprehensive and sometimes out of date. International teams should budget time for SDK debugging.</li>
    <li><strong>Model versioning is opaque</strong>: MiniMax frequently updates model weights without clear version strings. The model <code>minimax-01-turbo</code> you test today may behave differently in production next month.</li>
    <li><strong>No enterprise SLA for standard accounts</strong>: Enterprise-level SLAs (99.9% uptime) require dedicated contract negotiations. Standard accounts are best-effort.</li>
    <li><strong>International latency</strong>: API endpoints are hosted in mainland China. Users outside East Asia will experience 200-500ms additional latency.</li>
  </ul>

  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Verdict: Is MiniMax API right for your project?</h2>

  <p class="text-gray-700 leading-relaxed my-4">MiniMax is one of the most underrated Chinese AI API providers. Its combination of tiered text models (¥0.2-2/M tokens), a flagship MoE model (M3 at ¥1.5/M) that competes with GPT-5.5 on bilingual workloads, and the broadest multimodal surface among Chinese providers (vision, image gen, TTS, music) makes it uniquely versatile. The ¥0.2/M Lightning tier is among the industry's cheapest endpoints for high-volume text tasks, and the Music-01 API fills a niche no other Chinese provider serves.</p>

  <p class="text-gray-700 leading-relaxed my-4">The main trade-offs are Function Calling limitations and English documentation gaps. If your project needs reliable tool calling, look at OpenRouter or direct GPT/Claude access. But for bilingual multimodal applications where one API key should handle text, vision, voice, and music — and where the developer is comfortable navigating Chinese documentation — MiniMax is a compelling addition to any AI stack.</p>`;

---

<BaseLayout
  title={enTitle}
  description={enDescription}
  canonicalUrl={canonicalUrl}
  zhCanonicalUrl={zhCanonicalUrl}
  articleJsonLd={articleJsonLd}
  breadcrumbJsonLd={breadcrumbJsonLd}
  faqJsonLd={faqJsonLd}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <article class="prose prose-lg max-w-none">
