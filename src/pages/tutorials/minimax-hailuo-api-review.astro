---
import BaseLayout from '../../layouts/BaseLayout.astro';

const slug = 'minimax-hailuo-api-review';
const date = '2026-07-05';
const locale = 'en';

const enTitle = 'MiniMax Hailuo AI 2026: Full API Review & Pricing';
const enDescription = 'MiniMax Hailuo AI API review: MiniMax-01 series, M3 model pricing, VL-01 vision, TTS and music generation. Compare to DeepSeek, Qwen, GPT APIs.';
const canonicalUrl = `https://apirank.vip/tutorials/${slug}`;
const zhCanonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = {
