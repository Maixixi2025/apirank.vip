const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does SWE-2 Flash cost per 1M tokens?",
      "acceptedAnswer": {
