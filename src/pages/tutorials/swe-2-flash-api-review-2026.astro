const slug = 'swe-2-flash-api-review-2026';
const enTitle = 'SWE-2 Flash 2026: Coding Model Price vs Limits';
const enDescription = "Cognition's SWE-2 Flash is a 276B coding model at 1/5 SWE-2 price and 3x speed. Benchmarks, access limits, and where cheaper APIs win.";
const date = '2026-11-05';
const locale = 'en';
const canonicalUrl = `https://apirank.vip/tutorials/${slug}/`;
