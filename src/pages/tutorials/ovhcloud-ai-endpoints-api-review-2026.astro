      <tr><td>Mistral-7B-Instruct-v0.3</td><td>LLM</td><td>—</td><td>0.11</td><td>0.11</td><td>$0.11</td><td>$0.11</td></tr>
      <tr><td>Qwen3-Embedding-8B</td><td>Embeddings</td><td>—</td><td>0.10</td><td>—</td><td>$0.12</td><td>—</td></tr>
