  <thead><tr><th class="border border-gray-200 px-3 py-2 bg-gray-50 text-left text-sm font-semibold">Model</th><th class="border border-gray-200 px-3 py-2 bg-gray-50 text-left text-sm font-semibold">Input /1M</th><th class="border border-gray-200 px-3 py-2 bg-gray-50 text-left text-sm font-semibold">Output /1M</th><th class="border border-gray-200 px-3 py-2 bg-gray-50 text-left text-sm font-semibold">Best for</th></tr></thead>
  <tbody>
    <tr><td class="border border-gray-200 px-3 py-2 text-sm">DeepSeek V4 Flash</td><td class="border border-gray-200 px-3 py-2 text-sm">$0.09</td><td class="border border-gray-200 px-3 py-2 text-sm">$0.18</td><td class="border border-gray-200 px-3 py-2 text-sm">Default agent loops, bulk generation</td></tr>
