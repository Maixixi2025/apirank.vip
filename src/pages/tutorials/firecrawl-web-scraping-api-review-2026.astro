<tr><td class="px-3 py-2"><strong>Scale</strong></td><td class="px-3 py-2">1,000,000</td><td class="px-3 py-2">100</td><td class="px-3 py-2">$599/mo</td><td class="px-3 py-2">$5 / 5,000 credits</td></tr>
<tr><td class="px-3 py-2"><strong>Enterprise</strong></td><td class="px-3 py-2">Custom</td><td class="px-3 py-2">100+</td><td class="px-3 py-2">Contact sales</td><td class="px-3 py-2">Custom + ZDR Search</td></tr>
