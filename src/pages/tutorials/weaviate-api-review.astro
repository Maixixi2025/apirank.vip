<BaseLayout title={enTitle} description={enDescription} canonicalUrl={canonicalUrl} locale={locale} zhCanonicalUrl={zhCanonicalUrl}>
  <article class="max-w-4xl mx-auto px-4 py-8" itemscope itemtype="https://schema.org/Article">
