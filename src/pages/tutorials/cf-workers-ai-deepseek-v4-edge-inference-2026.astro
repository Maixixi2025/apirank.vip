---
import BaseLayout from '../../layouts/BaseLayout.astro';

const slug = 'cf-workers-ai-deepseek-v4-edge-inference-2026';
const date = '2026-08-16';
const locale = 'en';
const enTitle = 'CF Workers AI DeepSeek V4: 1M-Context Edge Inference';
const enDescription = 'Cloudflare Workers AI launched DeepSeek V4 Flash & Pro on Aug 14, 2026 — the first 1M-context models on the platform. Edge pricing, agent uses, comparison.';
const canonicalUrl = `https://apirank.vip/tutorials/${slug}`;
const zhCanonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: enTitle, description: enDescription, datePublished: date, dateModified: date, inLanguage: 'en-US', author: { '@type': 'Organization', name: 'APIRank', url: 'https://apirank.vip' }, publisher: { '@type': 'Organization', name: 'APIRank', logo: { '@type': 'ImageObject', url: 'https://apirank.vip/favicon.svg' } }, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl } };
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://apirank.vip' }, { '@type': 'ListItem', position: 2, name: 'Tutorials', item: 'https://apirank.vip/tutorials' }, { '@type': 'ListItem', position: 3, name: enTitle, item: canonicalUrl }] };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: 'When did Cloudflare Workers AI add DeepSeek V4 Flash and Pro?', acceptedAnswer: { '@type': 'Answer', text: 'Cloudflare shipped DeepSeek V4 Flash and DeepSeek V4 Pro on Workers AI on August 14, 2026, under the model handles @cf/deepseek-ai/deepseek-v4-pro-0813 and @cf/deepseek-ai/deepseek-v4-flash-0731.' } },
  { '@type': 'Question', name: 'How much does DeepSeek V4 on Cloudflare Workers AI cost?', acceptedAnswer: { '@type': 'Answer', text: 'Workers AI prices DeepSeek V4 Pro at $1.32 per M input tokens, $3.96 per M output and $0.044 per M cached input. DeepSeek V4 Flash is $0.44 per M input, $1.32 per M output and $0.014 per M cached input. Both require the Workers Paid plan or prepaid AI Gateway credits.' } },
  { '@type': 'Question', name: 'Do the Workers AI DeepSeek V4 models support 1M token context?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. DeepSeek V4 Flash and Pro are the first Workers AI models with a full 1,048,576-token (1M) context window, alongside thinking-mode reasoning and function calling on both models.' } },
  { '@type': 'Question', name: 'How do I call DeepSeek V4 on Workers AI?', acceptedAnswer: { '@type': 'Answer', text: 'Through the Workers AI binding (env.AI.run()), the REST API, the OpenAI-compatible endpoint, or the AI Gateway. All four surfaces are documented by Cloudflare.' } },
  { '@type': 'Question', name: 'Is Workers AI DeepSeek V4 cheaper than the direct DeepSeek API?', acceptedAnswer: { '@type': 'Answer', text: 'It depends on your plan and traffic. Workers AI V4 Pro matches DeepSeek\u2019s peak-hour price ($1.32/$3.96), while the direct DeepSeek API offers off-peak pricing at half that. Workers AI is the better choice when you want edge colocation with your Workers and AI Gateway observability; the direct API is cheaper for off-peak bulk workloads.' } },
  { '@type': 'Question', name: 'Can I use DeepSeek V4 on Workers AI from China?', acceptedAnswer: { '@type': 'Answer', text: 'Yes for many teams. Cloudflare edge nodes serve Workers AI inference on the global network, and Cloudflare maintains China-adjacent connectivity via its network; teams route through Cloudflare\u2019s API or AI Gateway rather than calling DeepSeek\u2019s China-hosted endpoint directly.' } }
] };
const affiliateSidebar = { title: 'Try FreeModel multi-vendor routing', description: 'One API key across DeepSeek, Qwen, OpenAI, Anthropic, Google and more — an OpenAI-compatible fallback with simpler cross-region failover.', url: 'https://freemodel.dev/invite/FRE-7a3b6220', cta: 'Free trial' };

const enBody = `<h1 class="text-3xl font-bold text-gray-900 mt-8 mb-4">Cloudflare Workers AI Launches DeepSeek V4 Flash &amp; Pro: Edge Inference Goes 1M-Context</h1>
<p class="text-gray-700 leading-relaxed my-4">On <strong>August 14, 2026</strong>, Cloudflare added <strong>DeepSeek V4 Flash</strong> and <strong>DeepSeek V4 Pro</strong> to <strong>Workers AI</strong> &mdash; the first two models on the platform with a <strong>full 1,048,576-token (1M) context window</strong>. The move turns Cloudflare&rsquo;s global edge network into a distribution channel for DeepSeek&rsquo;s open-weights generation, and it lands barely a day after DeepSeek&rsquo;s V4 Pro official release and just weeks after V4 Flash&rsquo;s preview. This article walks through what actually shipped, the verified edge pricing, the 1M-context agent use cases, and how the Cloudflare route compares to calling DeepSeek directly or through an aggregator like OpenRouter.</p>
<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 my-4"><strong>🌍 Quick verdict:</strong> Workers AI DeepSeek V4 is the fastest way to run 1M-context DeepSeek <em>near your existing Workers</em> with zero infrastructure, AI Gateway observability and Cloudflare&rsquo;s global reach. The trade-off: Workers AI V4 Pro is priced at DeepSeek&rsquo;s <em>peak</em> rate, so heavy off-peak workloads are still cheaper on the direct API.</div>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">What shipped on August 14</h2>
<p class="text-gray-700 leading-relaxed my-4">Cloudflare&rsquo;s changelog for August 14, 2026 confirms both models went live under the handles <code class="bg-gray-100 px-1 rounded text-sm">@cf/deepseek-ai/deepseek-v4-pro-0813</code> and <code class="bg-gray-100 px-1 rounded text-sm">@cf/deepseek-ai/deepseek-v4-flash-0731</code>. The headline feature is the context window: at <strong>1,048,576 tokens</strong>, these are the first Workers AI models that can hold a large codebase, a long multi-step agent trajectory, or an entire book&rsquo;s worth of reasoning in a single request &mdash; exceeding the limit of every other model previously hosted on the platform.</p>
<p class="text-gray-700 leading-relaxed my-4">Both models support <strong>thinking mode</strong> (reasoning) for step-by-step problem solving and <strong>function calling</strong> so agents can invoke tools and APIs across multiple conversation turns. Cloudflare describes DeepSeek V4 Flash as &ldquo;the faster, lower-cost sibling,&rdquo; and this release supersedes the earlier preview with &ldquo;substantially enhanced agentic capabilities.&rdquo; The intended workloads are long-horizon agentic workflows, large-codebase reasoning and multi-step analysis &mdash; exactly the jobs that break smaller context windows.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Verified Workers AI edge pricing</h2>
<table class="table-token my-4">
  <thead><tr><th>Model</th><th>Input ($/M)</th><th>Output ($/M)</th><th>Cached input ($/M)</th><th>Context</th></tr></thead>
  <tbody>
    <tr><td>DeepSeek V4 Pro 0813</td><td>$1.32</td><td>$3.96</td><td>$0.044</td><td>1M</td></tr>
    <tr><td>DeepSeek V4 Flash 0731</td><td>$0.44</td><td>$1.32</td><td>$0.014</td><td>1M</td></tr>
  </tbody>
</table>
<p class="text-gray-700 leading-relaxed my-4">These are the official rates on Cloudflare&rsquo;s Workers AI model pages (verified August 16, 2026). Both models require a <strong>Workers Paid plan or prepaid AI Gateway credits</strong> &mdash; they are not available through the standard Workers Free billing tier. The <strong>cached-input discount</strong> is worth calling out: at $0.044/M for Pro and $0.014/M for Flash, prompt caching on Workers AI cuts the dominant cost of long-context, multi-turn agent loops dramatically. Cloudflare charges per token for inference and adds AI Gateway observability on top; the exact Gateway pass-through depends on your account&rsquo;s request volume and is documented on <a href="https://developers.cloudflare.com/workers-ai/platform/pricing/" class="text-blue-600 hover:underline" rel="noopener">the Workers AI pricing page</a>.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">1M context: the agent use case that matters</h2>
<p class="text-gray-700 leading-relaxed my-4">The 1M-token context is the real story here, not the price. A codebase agent that previously had to chunk a monorepo into hundreds of retrieval calls can now pass the relevant files &mdash; or an entire module graph &mdash; in one request. A research agent can hold the full source corpus, its notes and a long analysis chain without evicting earlier context. Long-horizon agents that loop over many function calls no longer need aggressive summarization to stay under a 128K or 200K ceiling.</p>
<p class="text-gray-700 leading-relaxed my-4">For teams already running Workers, the binding is the simplest integration path: <code class="bg-gray-100 px-1 rounded text-sm">env.AI.run("@cf/deepseek-ai/deepseek-v4-pro-0813", { messages })</code> from a Worker, with no VM, no gateway and no key management beyond the account token. The same models are reachable through the <strong>REST API</strong>, the <strong>OpenAI-compatible endpoint</strong>, and <strong>AI Gateway</strong> (for caching, rate limiting, retries and observability across providers). If you want the fully portable OpenAI-style surface, our <a href="/tutorials/cloudflare-ai-gateway-review" class="text-blue-600 hover:underline">Cloudflare AI Gateway review</a> covers the gateway layer in depth.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Prompt caching is the real cost lever</h2>
<p class="text-gray-700 leading-relaxed my-4">With a 1M-token context window, the <em>input</em> side of the bill can dominate fast. A long-horizon agent that starts each turn by re-sending 400K tokens of repo context would pay for that context on every single step if there were no caching. Cloudflare&rsquo;s cached-input pricing is designed to defuse exactly that problem: DeepSeek V4 Pro drops from $1.32 to <strong>$0.044 per M</strong> for cached input (a 30x cut), and V4 Flash drops from $0.44 to <strong>$0.014 per M</strong> (also ~30x). The practical effect is that a multi-turn agent loop with a large stable prefix costs roughly as much as a much smaller one, because only the delta &mdash; the new tool results and new instructions appended each turn &mdash; is billed at the full input rate.</p>
<p class="text-gray-700 leading-relaxed my-4">A quick cost model makes this concrete. Imagine a codebase-analysis agent that runs 200 turns per task over a stable 300K-token context, appending ~2K new tokens each turn, and emitting ~1K output tokens per turn. Without caching, one task is roughly 200 &times; 300K = 60M input tokens at $1.32/M &mdash; about <strong>$79</strong> in input alone on V4 Pro. With prompt caching, the cached portion (298K of the 300K per turn) is billed at $0.044/M and only the 2K delta is billed at full rate: input drops to roughly $2.90 per task, a >25x reduction. That single switch &mdash; enabled by default on the Workers AI OpenAI-compatible endpoint with the right cache key &mdash; is the difference between a 1M-context agent being economically prohibitive and genuinely runnable. It is the same pattern DeepSeek and OpenRouter expose with their own prompt-cache pricing; the nuance on Workers AI is that the discount is built into the platform&rsquo;s flat rate card rather than a separate plan toggle.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Workers AI vs the direct DeepSeek API vs OpenRouter</h2>
<table class="table-token my-4">
  <thead><tr><th>Route</th><th>V4 Pro $/M (in/out)</th><th>V4 Flash $/M (in/out)</th><th>Best for</th></tr></thead>
  <tbody>
    <tr><td>Workers AI (this release)</td><td>$1.32 / $3.96</td><td>$0.44 / $1.32</td><td>Edge colocation with Workers, AI Gateway, 1M context without infra</td></tr>
    <tr><td>Direct DeepSeek API (peak)</td><td>$1.32 / $3.96</td><td>~$0.14&ndash;$0.28</td><td>Simplest direct billing; China-hosted origin</td></tr>
    <tr><td>Direct DeepSeek API (off-peak)</td><td>~$0.66 / $1.98</td><td>~$0.07&ndash;$0.14</td><td>Scheduled bulk workloads that can run off-peak &mdash; half price</td></tr>
    <tr><td>OpenRouter (digitalocean / deepseek vendors)</td><td>varies by vendor</td><td>varies by vendor</td><td>Single-key multi-vendor routing and failover</td></tr>
  </tbody>
</table>
<p class="text-gray-700 leading-relaxed my-4">The most striking comparison: Workers AI prices <strong>DeepSeek V4 Pro at exactly DeepSeek&rsquo;s own peak-hour rate</strong> ($1.32/$3.96), while the direct API drops to about half that off-peak (the peak/valley billing that shipped with V4 Pro&rsquo;s release is covered in our <a href="/tutorials/deepseek-v4-pro-peak-valley-pricing-2026" class="text-blue-600 hover:underline">DeepSeek V4 Pro peak-valley pricing article</a>). So if your traffic is bursty and latency-sensitive, Workers AI&rsquo;s flat rate and edge colocation win; if you can schedule heavy jobs into off-peak windows, the direct API&rsquo;s ~50% discount is hard to beat.</p>
<p class="text-gray-700 leading-relaxed my-4">For V4 Flash the picture is inverted in the other direction: Workers AI&rsquo;s $0.44/$1.32 is above the direct API&rsquo;s ~$0.14&ndash;$0.28 cache-miss range, but that gap buys you <em>1M context</em> (the preview on the direct API was more limited) plus edge adjacency. And if you want to compare before committing, our <a href="/tutorials/deepseek-v4-flash-api-2026" class="text-blue-600 hover:underline">DeepSeek V4 Flash API review</a> and the <a href="/tutorials/deepseek-v4-openrouter-agentic-token-share-2026" class="text-blue-600 hover:underline">OpenRouter agentic token-share analysis</a> give the direct-to-aggregator picture.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">What this means for API buyers in 2026</h2>
<p class="text-gray-700 leading-relaxed my-4">DeepSeek V4 on Workers AI is the latest sign that 2026&rsquo;s inference market has split into tiers: frontier labs sell premium closed models, open-weights operators (DeepSeek, Qwen, Llama, Mistral) sell budget reasoning, and the <em>distribution</em> layer &mdash; Cloudflare, OpenRouter, Vercel, AI Gateway &mdash; is where the routing, the context-window and the failover decisions get made. Getting a 1M-context open-weights model from Cloudflare&rsquo;s network, billed per token with prompt-cache discounts and AI Gateway observability, effectively commoditizes long-context agent inference the same way Workers commoditized serverless compute.</p>
<p class="text-gray-700 leading-relaxed my-4">The practical playbook for a cost-sensitive agent team: run latency-critical, cache-heavy agent turns on Workers AI DeepSeek V4 (pro or flash) for the 1M context and edge adjacency; schedule bulk and non-interactive passes on the direct DeepSeek API during off-peak windows at ~50% off; and keep an OpenAI-compatible aggregator key in front for failover &mdash; the multi-provider architecture we document across the site. If you want one key that fronts several of these vendors with simpler cross-region failover, <a href="https://freemodel.dev/invite/FRE-7a3b6220" class="text-blue-600 hover:underline" rel="noopener">FreeModel&rsquo;s multi-vendor routing</a> is a clean starting point.</p>
<p class="text-gray-700 leading-relaxed my-4">One caution: edge inference latency varies by region and by traffic, and the 1M-context models are still Beta on the platform &mdash; Cloudflare lists V4 Pro as Beta. For production, pin your Worker to a region close to your users and use AI Gateway caching. And note that Cloudflare&rsquo;s positioning with DeepSeek gives mainland-connected teams a route that doesn&rsquo;t require wrestling with DeepSeek&rsquo;s China-hosted origin directly &mdash; relevant context in our <a href="/tutorials/cloudflare-workers-ai-china-models-2026" class="text-blue-600 hover:underline">Workers AI China models article</a>.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">The 1M-context landscape in 2026</h2>
<p class="text-gray-700 leading-relaxed my-4">Workers AI joining the 1M-context club is notable because the list of providers that can truly hold a million tokens is still short, and the ones that can price it very differently. DeepSeek&rsquo;s own API serves V4 Pro and Flash with ~1M context and pioneered peak/valley pricing (off-peak halves the rate). Google&rsquo;s Gemini family has shipped 1M+ context for years and leads on multimodal 1M work. xAI&rsquo;s Grok and Alibaba&rsquo;s Qwen have also pushed into multi-hundred-K and 1M territory, and open-weights hosts like Nebius and DigitalOcean Gradient are putting 1M-context DeepSeek-class models behind OpenAI-compatible endpoints. What differentiates Cloudflare is <em>where</em> the inference runs: on edge nodes that sit one network hop from your Workers, with AI Gateway observability and prompt-cache pricing built in, rather than on a regional cloud VM you have to reach over the public internet.</p>
<p class="text-gray-700 leading-relaxed my-4">For an agent platform that already lives on Cloudflare &mdash; a Worker, a Pages function, a D1-backed job queue &mdash; that adjacency is the whole point. You do not manage a sidecar inference client, a second vendor account, or a regional endpoint; the model is just another binding, and AI Gateway gives you caching, rate limits and a single analytics pane. The trade-off is that you are coupling your inference to a single platform, so teams that want portability keep an OpenAI-compatible route (direct DeepSeek, OpenRouter, or another open-weights host) as a fallback &mdash; the same failover pattern the aggregators themselves encourage.</p>

<h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Getting started in one snippet</h2>
<p class="text-gray-700 leading-relaxed my-4">The fastest path is the OpenAI-compatible endpoint from a Worker or any HTTP client. A minimal chat completion against the edge model looks like this:</p>
<pre class="bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto my-4"><code>fetch("https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1/chat/completions", {
  method: "POST",
  headers: {
    "Authorization": "Bearer {API_TOKEN}",
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    model: "@cf/deepseek-ai/deepseek-v4-pro-0813",
    messages: [{ "role": "user", "content": "Summarize this 500K-token codebase audit and list the top refactor risks." }]
  })
}).then(r =&gt; r.json()).then(console.log);</code></pre>
<p class="text-gray-700 leading-relaxed my-4">Swap the model handle for <code class="bg-gray-100 px-1 rounded text-sm">@cf/deepseek-ai/deepseek-v4-flash-0731</code> for the cheaper, faster sibling. For Workers-native use, call <code class="bg-gray-100 px-1 rounded text-sm">env.AI.run("...", { messages })</code> and stream the response. Both paths require a Workers Paid plan or prepaid AI Gateway credits, per Cloudflare&rsquo;s documentation.</p>

<section class="faq mt-10">
  <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-4">Cloudflare Workers AI DeepSeek V4 FAQ</h2>
  <div class="faq-item border-b py-4"><h3 class="font-semibold text-gray-900">When did Cloudflare Workers AI add DeepSeek V4 Flash and Pro?</h3><p class="text-gray-700 my-2">Cloudflare shipped DeepSeek V4 Flash and Pro on Workers AI on August 14, 2026, under the handles @cf/deepseek-ai/deepseek-v4-pro-0813 and @cf/deepseek-ai/deepseek-v4-flash-0731.</p></div>
  <div class="faq-item border-b py-4"><h3 class="font-semibold text-gray-900">How much does DeepSeek V4 on Cloudflare Workers AI cost?</h3><p class="text-gray-700 my-2">Workers AI prices V4 Pro at $1.32 per M input, $3.96 per M output and $0.044 per M cached input. V4 Flash is $0.44 per M input, $1.32 per M output and $0.014 per M cached input. Both require the Workers Paid plan or prepaid AI Gateway credits.</p></div>
  <div class="faq-item border-b py-4"><h3 class="font-semibold text-gray-900">Do the Workers AI DeepSeek V4 models support 1M token context?</h3><p class="text-gray-700 my-2">Yes. DeepSeek V4 Flash and Pro are the first Workers AI models with a full 1,048,576-token context window, along with thinking-mode reasoning and function calling on both.</p></div>
  <div class="faq-item border-b py-4"><h3 class="font-semibold text-gray-900">How do I call DeepSeek V4 on Workers AI?</h3><p class="text-gray-700 my-2">Through the Workers AI binding (env.AI.run()), the REST API, the OpenAI-compatible endpoint, or the AI Gateway &mdash; all four surfaces are documented by Cloudflare.</p></div>
  <div class="faq-item py-4"><h3 class="font-semibold text-gray-900">Is Workers AI DeepSeek V4 cheaper than the direct DeepSeek API?</h3><p class="text-gray-700 my-2">It depends. Workers AI V4 Pro matches DeepSeek&rsquo;s peak price ($1.32/$3.96), while the direct API offers off-peak pricing at about half. Choose Workers AI for edge colocation and 1M context; choose the direct API off-peak for cheap bulk workloads.</p></div>
</section>
`;
---
<BaseLayout title={enTitle} description={enDescription} canonicalUrl={canonicalUrl} zhCanonicalUrl={zhCanonicalUrl} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
