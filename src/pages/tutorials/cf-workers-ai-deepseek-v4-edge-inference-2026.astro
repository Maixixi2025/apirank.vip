      <div class="lg:col-span-2 space-y-8">
        <nav class="text-sm text-gray-500 mb-2"><a href="/" class="hover:underline">Home</a> &rsaquo; <a href="/tutorials" class="hover:underline">Tutorials</a> &rsaquo; <span class="text-gray-700">{enTitle}</span></nav>
        <div set:html={enBody} />
      </div>
      <aside class="space-y-6 mt-8 lg:mt-0"><div class="bg-gray-50 border border-gray-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">Quick Reference</h3><ul class="text-sm text-gray-700 space-y-1"><li><strong>Released:</strong> Aug 14, 2026</li><li><strong>Models:</strong> @cf/deepseek-ai/deepseek-v4-pro-0813 &amp; deepseek-v4-flash-0731</li><li><strong>Context:</strong> 1,048,576 tokens (first on Workers AI)</li><li><strong>Pro price:</strong> $1.32 / $3.96 per M (cached $0.044)</li><li><strong>Flash price:</strong> $0.44 / $1.32 per M (cached $0.014)</li><li><strong>Reasoning:</strong> thinking mode + function calling</li><li><strong>Plan:</strong> Workers Paid required (or AI Gateway credits)</li><li><strong>Access:</strong> binding, REST, OpenAI-compatible, AI Gateway</li></ul></div><div class="bg-blue-50 border border-blue-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">{affiliateSidebar.title}</h3><p class="text-sm text-gray-700 mb-2">{affiliateSidebar.description}</p><a href={affiliateSidebar.url} class="inline-block bg-blue-600 text-white text-sm px-3 py-1.5 rounded hover:bg-blue-700">{affiliateSidebar.cta}</a></div></aside>
    </div>
