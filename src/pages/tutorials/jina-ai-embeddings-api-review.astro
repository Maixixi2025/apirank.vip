<tr><td class="border border-gray-300 px-3 py-2"><strong>jina-embeddings-v2-base-code</strong></td><td class="border border-gray-300 px-3 py-2">v2 Code (137M)</td><td class="border border-gray-300 px-3 py-2">768</td><td class="border border-gray-300 px-3 py-2">8192</td><td class="border border-gray-300 px-3 py-2">$0.02</td><td class="border border-gray-300 px-3 py-2">Code search RAG (open-source, Apache 2.0)</td></tr>

<tr><td class="border border-gray-300 px-3 py-2"><strong>jina-clip-v1</strong></td><td class="border border-gray-300 px-3 py-2">CLIP-v1 (446M)</td><td class="border border-gray-300 px-3 py-2">768</td><td class="border border-gray-300 px-3 py-2">text 512 / image 1024</td><td class="border border-gray-300 px-3 py-2">$0.02</td><td class="border border-gray-300 px-3 py-2">Text-image cross-modal retrieval</td></tr>

<tr><td class="border border-gray-300 px-3 py-2"><strong>jina-reranker-v3</strong></td><td class="border border-gray-300 px-3 py-2">v3 (550M)</td><td class="border border-gray-300 px-3 py-2">score</td><td class="border border-gray-300 px-3 py-2">8192</td><td class="border border-gray-300 px-3 py-2">$0.018</td><td class="border border-gray-300 px-3 py-2">Multilingual reranking (100+ languages)</td></tr>

<tr><td class="border border-gray-300 px-3 py-2"><strong>jina-reranker-v2-base-multilingual</strong></td><td class="border border-gray-300 px-3 py-2">v2 multilingual (278M)</td><td class="border border-gray-300 px-3 py-2">score</td><td class="border border-gray-300 px-3 py-2">8192</td><td class="border border-gray-300 px-3 py-2">$0.018</td><td class="border border-gray-300 px-3 py-2">Multilingual reranking (legacy, open-source)</td></tr>

<tr><td class="border border-gray-300 px-3 py-2"><strong>Reader</strong></td><td class="border border-gray-300 px-3 py-2">Reader v0.5 (URL fetch)</td><td class="border border-gray-300 px-3 py-2">clean Markdown</td><td class="border border-gray-300 px-3 py-2">URL content</td><td class="border border-gray-300 px-3 py-2">$0.02 (1M free/mo)</td><td class="border border-gray-300 px-3 py-2">URL → clean Markdown for RAG ingestion</td></tr>

