    <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-8">
      <div class="lg:col-span-2 space-y-8">
        <nav class="text-sm text-gray-500 mb-4"><a href="/" class="hover:underline">Home</a> &rsaquo; <a href="/tutorials" class="hover:underline">Tutorials</a> &rsaquo; <span class="text-gray-700">{enTitle}</span></nav>
        <div set:html={enBody} />
      </div>
      <aside class="space-y-6 mt-8 lg:mt-0"><div class="bg-gray-50 border border-gray-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">Quick Reference</h3><ul class="text-sm text-gray-700 space-y-1"><li><strong>Model:</strong> mistral-ocr-4-0</li><li><strong>Price:</strong> $4 / 1,000 pages ($2 batch)</li><li><strong>Languages:</strong> 170 (10 groups)</li><li><strong>Benchmarks:</strong> OlmOCRBench 85.20</li><li><strong>Self-host:</strong> single container</li><li><strong>Region:</strong> EU, no CN endpoint ❌</li></ul></div><div class="bg-blue-50 border border-blue-200 rounded-lg p-4"><h3 class="font-semibold text-gray-900 mb-2">{affiliateSidebar.title}</h3><p class="text-sm text-gray-700 mb-2">{affiliateSidebar.description}</p><a href={affiliateSidebar.url} class="inline-block bg-blue-600 text-white text-sm px-3 py-1.5 rounded hover:bg-blue-700">{affiliateSidebar.cta}</a></div></aside>
