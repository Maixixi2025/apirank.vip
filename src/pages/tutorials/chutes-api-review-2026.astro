const date = '2026-09-06';
const locale = 'en';

const enTitle = 'Chutes API Review 2026: Open-Weight Inference';
const enDescription = 'Chutes API review 2026: decentralized open-weights inference on TEE. Qwen3.5-397B $0.45/$3.00, DeepSeek V3.2 $1/$1 per 1M. No markup. Verified live.';
const canonicalUrl = `https://apirank.vip/tutorials/${slug}`;
const zhCanonicalUrl = `https://apirank.vip/zh/tutorials/${slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": enTitle,
  "description": enDescription,
  "datePublished": date,
  "dateModified": date,
  "inLanguage": "en-US",
  "author": { "@type": "Organization", "name": "APIRank", "url": "https://apirank.vip" },
  "publisher": { "@type": "Organization", "name": "APIRank", "logo": { "@type": "ImageObject", "url": "https://apirank.vip/favicon.svg" } },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://apirank.vip" },
    { "@type": "ListItem", "position": 2, "name": "Tutorials", "item": "https://apirank.vip/tutorials" },
    { "@type": "ListItem", "position": 3, "name": enTitle, "item": canonicalUrl }
  ]
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is Chutes in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Chutes (chutes.ai) is an open-source, decentralized inference network for open-weights AI models. Models run on a Bittensor-driven network of independent GPU miners inside confidential TEE (confidential-computing) hardware, and are served through a single global OpenAI-compatible endpoint at https://llm.chutes.ai/v1. Rather than reselling another vendor's listed models like OpenRouter, Chutes hosts the open-weights models itself and publishes transparent, no-markup per-1M-token pricing plus per-second 'Private Chute' GPU deployments starting at about $1.80 per hour." } },
    { "@type": "Question", "name": "How much does the Chutes API cost in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Public inference is pay-as-you-go per 1M tokens with no markup. Verified live on 2026-09-06: Qwen3.5-397B-A17B is $0.45 in / $3.00 out (262K context); DeepSeek-V3.2 is $1.00 / $1.00; DeepSeek-V4-Flash is $0.44 / $1.32 with 1.0M context; Kimi-K2.6 is $0.58 / $3.40; and GLM-5.2 is $1.25 / $3.95. Small models are very cheap — Qwen3-32B at $0.104 / $0.416 and Gemma-4-31B at $0.12 / $0.37. Optional Plus ($10/mo, 6% off) and Pro ($20/mo, 10% off) plans bundle a daily request quota. There is no free tier." } },
    { "@type": "Question", "name": "Is Chutes OpenAI-compatible?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The endpoint is https://llm.chutes.ai/v1 with chat at /v1/chat/completions, authenticated with a CHUTES_API_KEY bearer token, so existing OpenAI SDKs and curl work after swapping the base URL. Chutes also ships a first-party 'chutes' CLI (Python, MIT, under the chutesai GitHub org) and publishes a live model catalog + per-token rates as JSON at chutes.ai/api/models." } },
    { "@type": "Question", "name": "Does Chutes have a free tier?", "acceptedAnswer": { "@type": "Answer", "text": "No. The official pricing FAQ states: 'We do not offer a free tier at this time. Top up your account in the app to get started.' Pay-as-you-go has no minimum commitment. Payment is accepted via 25+ Stripe methods (cards, crypto, bank transfers) as well as TAO / Bittensor alpha tokens. This differs from aggregators like Novita or DeepInfra that grant small free credits on signup." } },
    { "@type": "Question", "name": "Is Chutes usable from mainland China?", "acceptedAnswer": { "@type": "Answer", "text": "Not directly. There is no mainland-China regional endpoint, no China payment method (native on-ramps are Stripe plus TAO/crypto), and no China data-residency option, and the endpoint is a single global entry rather than geo-split. Mainland production traffic should route through a proxy or a relay that fronts the Chutes API. For latency- or residency-sensitive user-facing China traffic, a domestic provider (Qwen, Zhipu, Doubao) remains the recommended China-facing layer." } },
    { "@type": "Question", "name": "What models does Chutes host in 2026?", "acceptedAnswer": { "@type": "Answer", "text": "The live catalog (33 models, 16 of them LLMs) hosts leading open weights — Qwen3.5-397B-A17B, DeepSeek-V3.2 and DeepSeek-V4-Flash, Moonshot Kimi-K2.6, Zhipu GLM-5.2 and GLM-5.1, Qwen3-32B / Qwen3.6-27B / Qwen3.8-27B, Google Gemma-4-31B, plus image/video/speech/music/embedding/content-moderation models. Chutes advertises that the newest SOTA open models appear on the platform minutes after upstream release. All are open-weights — there is no proprietary GPT-6 Astra / Claude / Gemini access." } }
  ]
};
---
<BaseLayout
  title={enTitle + ' | APIRank'}
  description={enDescription}
  canonicalUrl={canonicalUrl}
  zhCanonicalUrl={zhCanonicalUrl}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <link rel="alternate" hreflang="en-US" href={canonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={zhCanonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <div class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span>›</span>
        <a href="/tutorials" class="hover:text-blue-600">Tutorials</a>
        <span>›</span>
        <span class="text-gray-900 font-medium">Chutes Open-Weight Inference API Review</span>
      </nav>
    </div>
  </div>

  <article class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">

          <header>
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Chutes API Review 2026: Decentralized Open-Weight Inference</h1>
            <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
              <time datetime="2026-09-06">September 6, 2026</time>
              <span>•</span>
              <span>Provider Review</span>
              <span>•</span>
              <span>About 10 min read</span>
            </div>
            <p class="text-lg text-gray-600 leading-relaxed">
              APIRank already tracks the proprietary frontier — GPT-6 Astra, Claude Fable, Gemini — plus the big resale aggregators like OpenRouter. Today I am adding the other end of the open-weights market that had been missing from our catalog: <strong>Chutes</strong>, a <em>decentralized</em> inference network that hosts open-source models itself (not resells them) and runs every request on confidential TEE compute. It is genuinely active — the day I verified it, Kimi K2.6, GLM 5.2, Gemma 4 31B and DeepSeek V4 Flash were all live on the network — and its per-1M pricing is published in the open. This review covers the verified pricing, the OpenAI-compatible API, the decentralized/TEE angle, and where Chutes fits next to the aggregators we already compare.
            </p>
          </header>

          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded-r">
            <p class="text-blue-800 text-sm">
              <strong>TL;DR:</strong> Chutes (chutes.ai) is an open-source, <em>decentralized</em> inference network for open-weights models, served through a single global OpenAI-compatible endpoint at <code class="bg-gray-100 px-1 rounded">https://llm.chutes.ai/v1</code> and run on Bittensor-backed GPU miners inside confidential TEE compute. Verified first-party pricing (chutes.ai/api/models + /pricing FAQ, both fetched 2026-09-06): <strong>Qwen3.5-397B-A17B at $0.45 in / $3.00 out per 1M</strong>, DeepSeek-V3.2 at $1.00/$1.00, DeepSeek-V4-Flash at $0.44/$1.32 (1.0M context), Kimi-K2.6 at $0.58/$3.40, and small models like Qwen3-32B at just <strong>$0.104/$0.42</strong>. No markup, no free tier. Optional Plus $10/mo and Pro $20/mo plans. Private, per-second TEE GPU deployments from $1.80/hour. The trade-off: it is the open-weights frontier — no proprietary GPT-6 Astra / Claude — and there is no owned regional datacenter to pin latency to, nor any China endpoint or payment method.
            </p>
          </div>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">Why Chutes, and Why Now</h2>
          <p>
            This week's APIRank briefings were dominated by the GPT-6 Astra launch and the Gemini 3.8 Flash family — both already covered on the site. What those stories made me realize is how thin our <em>open-weights, non-resale</em> coverage was. I list DeepInfra, Together, Novita and Hyperbolic as open-weights hosts, but I did not yet cover the decentralized segment where the models run on an independent, Bittensor-driven GPU network rather than one vendor's datacenter. Chutes is the clearest operator in that niche that is still actively shipping: the GitHub org shows commits through early September 2026, and its consumer products (Chutes Chat and Chutes Search) get real use. It also publishes its whole live catalog and pricing as JSON, which makes verification uncommonly easy.
          </p>
          <p>
            Worth a caveat up front: Chutes compares itself to OpenRouter, Kilo, FetchAI and Phala on its own homepage (the same row of logos that sit above its hero). I treat that as a feature, not a knock — it means the decentralized tier is positioning as an aggregator alternative, which is exactly the purchasing decision a developer with a lot of open-weights traffic faces today.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">Verified Pricing (2026-09-06)</h2>
          <p>
            Chutes is aggressively transparent about cost. The model catalog and every per-1M input/output rate are served as live JSON at <code class="bg-gray-100 px-1 rounded">https://chutes.ai/api/models</code>, so the number on the pricing page is the number you are billed. Below is a snapshot I verified directly from that API on 2026-09-06:
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-gray-700 border border-gray-200">
              <thead>
                <tr class="bg-gray-100 text-left">
                  <th class="px-3 py-2 font-medium">Model</th>
                  <th class="px-3 py-2 font-medium">Input $/M</th>
                  <th class="px-3 py-2 font-medium">Output $/M</th>
                  <th class="px-3 py-2 font-medium">Notes</th>
                </tr>
              </thead>
              <tbody>
                <tr><td class="px-3 py-2 font-medium">Qwen3.5-397B-A17B-TEE</td><td class="px-3 py-2">$0.45</td><td class="px-3 py-2">$3.00</td><td class="px-3 py-2">262K ctx; frontier open reasoning MoE</td></tr>
                <tr><td class="px-3 py-2 font-medium">DeepSeek-V3.2-TEE</td><td class="px-3 py-2">$1.00</td><td class="px-3 py-2">$1.00</td><td class="px-3 py-2">262K ctx; popular open chat model</td></tr>
                <tr><td class="px-3 py-2 font-medium">DeepSeek-V4-Flash-0731-TEE</td><td class="px-3 py-2">$0.44</td><td class="px-3 py-2">$1.32</td><td class="px-3 py-2">1.0M ctx; low-cost Flash class</td></tr>
                <tr><td class="px-3 py-2 font-medium">moonshotai/Kimi-K2.6-TEE</td><td class="px-3 py-2">$0.58</td><td class="px-3 py-2">$3.40</td><td class="px-3 py-2">262K ctx; flagship Kimi line</td></tr>
                <tr><td class="px-3 py-2 font-medium">zai-org/GLM-5.2-TEE</td><td class="px-3 py-2">$1.25</td><td class="px-3 py-2">$3.95</td><td class="px-3 py-2">frontier agentic/coding open model</td></tr>
                <tr><td class="px-3 py-2 font-medium">Qwen3-32B-TEE</td><td class="px-3 py-2">$0.104</td><td class="px-3 py-2">$0.416</td><td class="px-3 py-2">41K ctx; cheap small workhorse</td></tr>
                <tr><td class="px-3 py-2 font-medium">google/gemma-4-31B-turbo-TEE</td><td class="px-3 py-2">$0.12</td><td class="px-3 py-2">$0.37</td><td class="px-3 py-2">131K ctx; budget edge model</td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-sm text-gray-500"><em>Table note: all rates and context windows verified from the live <code class="bg-gray-100 px-1 rounded">chutes.ai/api/models</code> pricing API on 2026-09-06.</em></p>
          <p>
            The pricing model itself is simple and honest-sounding: <strong>no markup tiers</strong>, no middlemen, pay for the tokens you actually consume. If you do not want to top up as you go, the optional <strong>Plus ($10/mo)</strong> and <strong>Pro ($20/mo)</strong> plans bundle a daily request quota at 6% and 10% off the pay-as-you-go rates respectively. There is <strong>no free tier</strong> — the official FAQ says plainly: "We do not offer a free tier at this time. Top up your account in the app to get started." That is a real difference from aggregators like Novita or DeepInfra that hand out small free credits at signup, and it is the single biggest onboarding complaint a new user will hit.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">API Surface and Developer Experience</h2>
          <p>
            Migration friction is minimal because Chutes is <strong>OpenAI-compatible</strong>. The base URL is <code class="bg-gray-100 px-1 rounded">https://llm.chutes.ai/v1</code> and chat goes to <code class="bg-gray-100 px-1 rounded">/v1/chat/completions</code>; you authenticate with <code class="bg-gray-100 px-1 rounded">Authorization: Bearer $CHUTES_API_KEY</code>. An existing OpenAI SDK works after swapping the base URL and key, and the official home-page snippet shows a plain <code class="bg-gray-100 px-1 rounded">requests</code> call in Python. Chutes also ships a first-party <code class="bg-gray-100 px-1 rounded">chutes</code> CLI (Python, MIT, under the chutesai GitHub org), which handles API keys, model queries, and — its signature feature — one-command deploys of a <strong>Private Chute</strong>.
          </p>
          <p>
            The <em>Private Chute</em> is the second half of the product and deserves its own mention. If a model is not in the public catalog, or you need to run your own code or a private fine-tune with full isolation, you deploy it onto a confidential TEE GPU. The self-serve class Chutes currently lists is the RTX Pro 6000 (96 GB Blackwell) at <strong>$1.80 per hour</strong>, billed per second, with a one-time deployment fee equal to 3× the hourly rate ($5.40). Idle instances shut down automatically, so no GPU-seconds are wasted. This is closer to a leaner, TEE-flavored RunPod than to a pure model API — useful if you have custom weights but do not want to stand up a full GPU cluster.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">Chutes vs the Aggregators</h2>
          <p>
            The cleanest way to think about Chutes is as the <em>vertically-integrated, open-source-native</em> alternative to a resale aggregator. OpenRouter, Kilo and their peers are neutral shops that route to whatever any upstream provider lists — they give you one key and a huge model menu, but they add a routing layer and their inventory is someone else's. Chutes instead owns the stack: it hosts the open-weights models on its own Bittensor-driven network, isolates each in a TEE, and publishes no-markup rates. Its homepage even names its own competitors — "OpenRouter, Kilo, FetchAI, Phala, Pax Historia" — which makes the positioning unambiguous.
          </p>
          <p>
            For an APIRank audience the practical comparison comes down to a few axes. <strong>Price:</strong> a frontier 397B open MoE like Qwen3.5 at $0.45 in/$3.00 out is aggressive against first-party proprietary pricing, and the tiny models are astonishingly cheap. <strong>Model freshness:</strong> Chutes advertises SOTA open models "minutes after release," and the live catalog confirmed it — the newest Kimi, GLM and DeepSeek iterations were all present the day I checked. <strong>Privacy:</strong> confidential TEE execution is a genuine differentiator over multi-tenant clouds. The downsides: no proprietary frontier access (you will not call GPT-6 Astra or Claude through it), no free tier, and the decentralized topology means you cannot point at a single owned region for latency the way you can with Hyperbolic's or Together's own capacity.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">China Access and Latency</h2>
          <p>
            Chutes serves everything through one global OpenAI-compatible endpoint in front of a decentralized GPU network, so latency follows miner node placement rather than a published regional datacenter map. North America and Europe generally see low latency on the listed TEE instances; Asia-Pacific round-trips vary with where a request is scheduled. There is <strong>no mainland-China regional endpoint</strong>, no China payment method (native on-ramps are Stripe and TAO/crypto), and no China data-residency option. Mainland developers should route through a proxy or a relay that fronts the Chutes API, and for any user-facing, latency- or residency-sensitive surface serving China traffic, pair a domestic provider (Qwen, Zhipu, Doubao) as the China-facing layer — the same guidance I give for every overseas open-weights host in the catalog.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">Who Should Use Chutes?</h2>
          <ul class="list-disc pl-5 space-y-2">
            <li><strong>Open-weights-first teams</strong> who want a single OpenAI-compatible key across the newest Kimi/GLM/Qwen/DeepSeek releases, and who like that the pricing is transparent and markup-free.</li>
            <li><strong>Cost-sensitive, high-volume workloads</strong> — the small-model tier (Qwen3-32B at ~$0.10 in, Gemma-4-31B at ~$0.12 in) is genuinely hard to beat per token.</li>
            <li><strong>Privacy-conscious developers</strong> who value confidential TEE execution and isolation over a shared multi-tenant cloud.</li>
            <li><strong>Anyone running custom weights or code</strong> who wants per-second TEE GPU capacity without managing a cluster (the Private Chute path).</li>
          </ul>
          <p>
            It suits less well the team that needs proprietary frontier access, a free tier to prototype on, or a fixed, owned-region latency profile. And note the model catalog can shift — Chutes filters its homepage to "hot" models first, so treat the live API as the source of truth for what is actually servable on any given day.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-8 mb-3">Chutes FAQ</h2>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">What is Chutes in 2026?</h3>
          <p>Chutes is an open-source, decentralized inference network for open-weights models, served through a single global OpenAI-compatible endpoint (https://llm.chutes.ai/v1) and run on a Bittensor-driven network of independent GPU miners inside confidential TEE compute. It hosts open models itself rather than reselling another vendor's listings, publishes no-markup per-1M pricing, and also offers per-second Private Chute GPU deployments.</p>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">How much does the Chutes API cost?</h3>
          <p>Pay-as-you-go per 1M tokens, no markup. Verified 2026-09-06: Qwen3.5-397B-A17B $0.45/$3.00 (262K ctx), DeepSeek-V3.2 $1.00/$1.00, DeepSeek-V4-Flash $0.44/$1.32 (1.0M ctx), Kimi-K2.6 $0.58/$3.40, GLM-5.2 $1.25/$3.95, Qwen3-32B $0.104/$0.416, Gemma-4-31B $0.12/$0.37. Plus $10/mo and Pro $20/mo add a discounted daily quota. No free tier.</p>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Is the Chutes API OpenAI-compatible?</h3>
          <p>Yes. Endpoint https://llm.chutes.ai/v1, chat at /v1/chat/completions, auth via CHUTES_API_KEY bearer token — OpenAI SDKs work after swapping the base URL. A first-party 'chutes' CLI (Python, MIT) handles keys, model queries and one-command Private Chute deployments.</p>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Can I use Chutes from mainland China?</h3>
          <p>Not directly — no mainland endpoint, no China payment method, no CN data-residency option. Mainland production traffic needs a proxy or relay. For latency- or residency-sensitive China-facing traffic, a domestic provider (Qwen, Zhipu, Doubao) is recommended as the China layer.</p>
          <h3 class="text-xl font-semibold text-gray-900 mt-4">Does Chutes host proprietary frontier models?</h3>
          <p>No. The catalog is open-weights only — Qwen, DeepSeek, Moonshot Kimi, Zhipu GLM, Google Gemma, and others — with no GPT-6 Astra / Claude / Gemini access. For proprietary frontier models you still go first-party or to a resale aggregator.</p>

        </div>

        <aside class="lg:col-span-1 space-y-6">
          <div class="bg-white border border-gray-200 rounded-lg p-6">
            <h3 class="font-bold text-gray-900 mb-3">Chutes — Quick Facts</h3>
            <ul class="text-sm text-gray-600 space-y-2">
              <li><strong>Type:</strong> Decentralized open-weights inference</li>
              <li><strong>Endpoint:</strong> llm.chutes.ai/v1 (OpenAI-compatible)</li>
              <li><strong>Compute:</strong> Bittensor GPU miners + confidential TEE</li>
              <li><strong>Catalog:</strong> 33 models, 16 LLMs (verified 09-06)</li>
              <li><strong>Free tier:</strong> None</li>
              <li><strong>Plans:</strong> Plus $10/mo, Pro $20/mo, Enterprise</li>
            </ul>
          </div>

          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="font-bold text-gray-900 mb-2">What Makes It Different</h3>
            <ul class="text-sm text-gray-600 space-y-1 list-disc pl-4">
              <li>Hosts models itself — no resale markup</li>
              <li>Live JSON pricing API (chutes.ai/api/models)</li>
              <li>Confidential TEE on every request</li>
              <li>Private Chutes from $1.80/hr, per second</li>
              <li>SOTA open models in minutes after release</li>
            </ul>
          </div>

          <div class="bg-white border border-gray-200 rounded-lg p-6">
            <h3 class="font-bold text-gray-900 mb-3">Related Reviews</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/tutorials/openrouter-data-residency-2026" class="text-blue-600 hover:underline">OpenRouter data residency</a> — the resale aggregator it compares to</li>
              <li><a href="/tutorials/together-ai-api-review" class="text-blue-600 hover:underline">Together AI</a> — owned-capacity open-weights host</li>
              <li><a href="/tutorials/deepinfra-ai-api-review" class="text-blue-600 hover:underline">DeepInfra AI</a> — low-cost open-weights host with free credits</li>
              <li><a href="/tutorials/openrouter-jevons-paradox-api-discounts-2026" class="text-blue-600 hover:underline">OpenRouter discounts</a> — how aggregator pricing moves</li>
            </ul>
          </div>

          <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
            <h3 class="font-bold text-gray-900 mb-2">Disclosure &amp; Last Verified</h3>
            <p class="text-sm text-gray-600">
              All model rates, context windows, plan prices and the no-free-tier statement were verified live on <strong>2026-09-06</strong> from chutes.ai (homepage, /pricing FAQ JSON-LD) and the chutes.ai/api/models pricing API. APIRank does not accept payment for favorable reviews; this entry carries no affiliate link.
            </p>
          </div>

          <div class="bg-gray-100 border border-gray-200 rounded-lg p-4 text-center text-xs text-gray-400">
            Ad Placeholder
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
