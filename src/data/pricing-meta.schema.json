{
  "$id": "pricing-meta.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APIRank Pricing Meta",
  "description": "Trust / verification metadata for the price database. Aligned with PRD §6.1 (data trust module), §7.1 (Source entity), §10 (compliance disclosure).",
  "type": "object",
  "required": ["lastVerified", "lastVerifiedDisplay", "lastVerifiedZh", "verificationCycleDays", "coveragePct", "sources", "changeLog30d", "disclosure", "fxNote", "recentChanges"],
  "properties": {
    "lastVerified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of last full-database verification pass."
    },
    "lastVerifiedDisplay": { "type": "string", "description": "Localized EN display string, e.g. 'Jul 27, 2026'." },
    "lastVerifiedZh":      { "type": "string", "description": "Localized ZH display string, e.g. '2026年7月27日'." },
    "verificationCycleDays": { "type": "integer", "minimum": 1, "description": "Max acceptable age (days) before the trust banner flags data as stale. PRD §6.1 KPI: 'prices verified within cycle'." },
    "coveragePct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Share of catalog verified within current cycle (PRD §6.1 KPI: 'price freshness ≥ 95%')." },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "url", "verifiedAt", "confidence"],
        "properties": {
          "id": { "type": "string", "description": "Provider id; matches providers.json.id." },
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "confidence": {
            "enum": ["official", "verified", "community"],
            "description": "Source trust level (PRD §7.1 Source.confidence)."
          }
        }
      }
    },
    "changeLog30d": { "type": "integer", "minimum": 0, "description": "Number of price changes detected across all providers in the last 30 days." },
    "recentChanges": {
      "type": "array",
      "description": "Price changes detected in the last 7 days. Drives the 'recentChanges7d' KPI badge on the homepage. Each entry has an ISO date and a short description.",
      "items": {
        "type": "object",
        "required": ["date", "modelId", "summary"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "modelId": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" }
      },
      "description": "Editorial independence + affiliate disclosure (PRD §10)."
    },
    "fxNote": {
      "type": "object",
      "required": ["rate", "rateAsOf", "en", "zh"],
      "properties": {
        "rate": { "type": "string" },
        "rateAsOf": { "type": "string" },
        "en": { "type": "string" },
        "zh": { "type": "string" }
      }
    }
  }
}